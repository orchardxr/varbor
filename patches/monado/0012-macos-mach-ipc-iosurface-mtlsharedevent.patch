diff --git a/src/xrt/auxiliary/vk/vk_metal_apple.m b/src/xrt/auxiliary/vk/vk_metal_apple.m
new file mode 100644
index 0000000000000000000000000000000000000000..726fd83362472c18f7e59d8fea02f6b9e42a5bfe
--- /dev/null
+++ b/src/xrt/auxiliary/vk/vk_metal_apple.m
@@ -0,0 +1,274 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  IOSurface allocation and MTLSharedEvent sharing for MoltenVK.
+ * @ingroup aux_vk
+ */
+
+#import <Metal/Metal.h>
+#include <IOSurface/IOSurfaceRef.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <mach/mach.h>
+
+#include "util/u_debug.h"
+#include "vk/vk_helpers.h"
+
+// Private API, also used by DXMT. Checked with respondsToSelector before use.
+@interface MTLSharedEventHandle ()
+- (mach_port_t)eventPort;
+@end
+
+@protocol MacvrMTLDeviceSPI <MTLDevice>
+- (id<MTLSharedEvent>)newSharedEventWithMachPort:(mach_port_t)machPort;
+@end
+
+DEBUG_GET_ONCE_OPTION(macos_sync, "MONADO_MACOS_SYNC", "auto")
+
+
+/*
+ *
+ * IOSurface.
+ *
+ */
+
+bool
+vk_iosurface_format_info(VkFormat format, uint32_t *out_bpe, uint32_t *out_pixel_format)
+{
+	uint32_t bpe = 0;
+	uint32_t pf = 0;
+
+	switch (format) {
+	case VK_FORMAT_R8G8B8A8_UNORM:
+	case VK_FORMAT_R8G8B8A8_SRGB: bpe = 4, pf = 'RGBA'; break;
+	case VK_FORMAT_B8G8R8A8_UNORM:
+	case VK_FORMAT_B8G8R8A8_SRGB: bpe = 4, pf = 'BGRA'; break;
+	case VK_FORMAT_A2B10G10R10_UNORM_PACK32: bpe = 4, pf = 'l10r'; break;
+	case VK_FORMAT_R16G16B16A16_SFLOAT: bpe = 8, pf = 'RGhA'; break;
+	case VK_FORMAT_R16G16B16A16_UNORM: bpe = 8, pf = 'l64r'; break;
+	case VK_FORMAT_R32_SFLOAT: bpe = 4, pf = 'L00f'; break;
+	case VK_FORMAT_R5G6B5_UNORM_PACK16: bpe = 2, pf = 'L565'; break;
+	default: return false;
+	}
+
+	if (out_bpe != NULL) {
+		*out_bpe = bpe;
+	}
+	if (out_pixel_format != NULL) {
+		*out_pixel_format = pf;
+	}
+	return true;
+}
+
+static void
+dict_set_u64(CFMutableDictionaryRef d, CFStringRef key, uint64_t value)
+{
+	CFNumberRef n = CFNumberCreate(NULL, kCFNumberSInt64Type, &value);
+	CFDictionarySetValue(d, key, n);
+	CFRelease(n);
+}
+
+void *
+vk_iosurface_create(VkFormat format, uint32_t width, uint32_t height)
+{
+	uint32_t bpe = 0;
+	uint32_t pixel_format = 0;
+	if (!vk_iosurface_format_info(format, &bpe, &pixel_format)) {
+		return NULL;
+	}
+
+	// Metal wants linear texture rows aligned, 64 bytes covers every Apple GPU.
+	size_t bpr = ((size_t)width * bpe + 63) & ~(size_t)63;
+	bpr = IOSurfaceAlignProperty(kIOSurfaceBytesPerRow, bpr);
+	size_t alloc = IOSurfaceAlignProperty(kIOSurfaceAllocSize, bpr * height);
+
+	CFMutableDictionaryRef d =
+	    CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+	dict_set_u64(d, kIOSurfaceWidth, width);
+	dict_set_u64(d, kIOSurfaceHeight, height);
+	dict_set_u64(d, kIOSurfaceBytesPerElement, bpe);
+	dict_set_u64(d, kIOSurfaceBytesPerRow, bpr);
+	dict_set_u64(d, kIOSurfaceAllocSize, alloc);
+	dict_set_u64(d, kIOSurfacePixelFormat, pixel_format);
+
+	IOSurfaceRef surface = IOSurfaceCreate(d);
+	CFRelease(d);
+
+	return (void *)surface;
+}
+
+void
+vk_iosurface_release(void *surface)
+{
+	if (surface != NULL) {
+		CFRelease((IOSurfaceRef)surface);
+	}
+}
+
+mach_port_t
+vk_iosurface_create_mach_port(void *surface)
+{
+	return IOSurfaceCreateMachPort((IOSurfaceRef)surface);
+}
+
+
+/*
+ *
+ * MTLSharedEvent.
+ *
+ */
+
+bool
+vk_metal_shared_event_supported(void)
+{
+	static int cached = -1;
+	if (cached >= 0) {
+		return cached == 1;
+	}
+
+	const char *mode = debug_get_option_macos_sync();
+	if (mode != NULL && strcmp(mode, "cpu") == 0) {
+		U_LOG_I("MONADO_MACOS_SYNC=cpu: MTLSharedEvent sync disabled, using CPU waits.");
+		cached = 0;
+		return false;
+	}
+
+	bool ok = [MTLSharedEventHandle instancesRespondToSelector:@selector(eventPort)];
+	@autoreleasepool {
+		id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+		ok = ok && dev != nil && [dev respondsToSelector:@selector(newSharedEventWithMachPort:)];
+		[dev release];
+	}
+	if (!ok) {
+		U_LOG_W("MTLSharedEvent Mach port SPI not available, using CPU waits.");
+	}
+
+	cached = ok ? 1 : 0;
+	return ok;
+}
+
+static id<MTLDevice>
+get_mtl_device(void)
+{
+	// Exporting MoltenVK's device needs an instance created for it, which the app owns.
+	static id<MTLDevice> dev = nil;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		dev = MTLCreateSystemDefaultDevice();
+	});
+	return dev;
+}
+
+VkResult
+vk_metal_create_timeline_semaphore_and_port(struct vk_bundle *vk, VkSemaphore *out_sem, mach_port_t *out_port)
+{
+	if (vk->vkExportMetalObjectsEXT == NULL) {
+		return VK_ERROR_EXTENSION_NOT_PRESENT;
+	}
+
+	VkExportMetalObjectCreateInfoEXT export_create_info = {
+	    .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECT_CREATE_INFO_EXT,
+	    .exportObjectType = VK_EXPORT_METAL_OBJECT_TYPE_METAL_SHARED_EVENT_BIT_EXT,
+	};
+	VkSemaphoreTypeCreateInfo type_info = {
+	    .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
+	    .pNext = &export_create_info,
+	    .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE,
+	    .initialValue = 0,
+	};
+	VkSemaphoreCreateInfo create_info = {
+	    .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+	    .pNext = &type_info,
+	};
+
+	VkSemaphore sem = VK_NULL_HANDLE;
+	VkResult ret = vk->vkCreateSemaphore(vk->device, &create_info, NULL, &sem);
+	if (ret != VK_SUCCESS) {
+		VK_ERROR(vk, "vkCreateSemaphore: %s", vk_result_string(ret));
+		return ret;
+	}
+
+	VkExportMetalSharedEventInfoEXT event_info = {
+	    .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_SHARED_EVENT_INFO_EXT,
+	    .semaphore = sem,
+	};
+	VkExportMetalObjectsInfoEXT export_info = {
+	    .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+	    .pNext = &event_info,
+	};
+	vk->vkExportMetalObjectsEXT(vk->device, &export_info);
+
+	id<MTLSharedEvent> event = event_info.mtlSharedEvent;
+	mach_port_t port = MACH_PORT_NULL;
+	if (event != nil) {
+		@autoreleasepool {
+			MTLSharedEventHandle *handle = [event newSharedEventHandle];
+			port = [handle eventPort];
+			// The handle owns its right, take our own before it goes away.
+			if (MACH_PORT_VALID(port) &&
+			    mach_port_mod_refs(mach_task_self(), port, MACH_PORT_RIGHT_SEND, 1) != KERN_SUCCESS) {
+				port = MACH_PORT_NULL;
+			}
+			[handle release];
+		}
+	}
+
+	if (!MACH_PORT_VALID(port)) {
+		VK_ERROR(vk, "Could not get a Mach port for the semaphore's MTLSharedEvent");
+		vk->vkDestroySemaphore(vk->device, sem, NULL);
+		return VK_ERROR_FEATURE_NOT_PRESENT;
+	}
+
+	*out_sem = sem;
+	*out_port = port;
+
+	return VK_SUCCESS;
+}
+
+VkResult
+vk_metal_import_timeline_semaphore_from_port(struct vk_bundle *vk, mach_port_t port, VkSemaphore *out_sem)
+{
+	if (vk->vkExportMetalObjectsEXT == NULL) {
+		return VK_ERROR_EXTENSION_NOT_PRESENT;
+	}
+
+	id<MTLDevice> dev = get_mtl_device();
+	if (dev == nil || ![dev respondsToSelector:@selector(newSharedEventWithMachPort:)]) {
+		VK_ERROR(vk, "No MTLDevice or no newSharedEventWithMachPort:");
+		return VK_ERROR_FEATURE_NOT_PRESENT;
+	}
+
+	id<MTLSharedEvent> event = [(id<MacvrMTLDeviceSPI>)dev newSharedEventWithMachPort:port];
+	if (event == nil) {
+		VK_ERROR(vk, "newSharedEventWithMachPort: failed for port %u", port);
+		return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+	}
+
+	VkImportMetalSharedEventInfoEXT import_info = {
+	    .sType = VK_STRUCTURE_TYPE_IMPORT_METAL_SHARED_EVENT_INFO_EXT,
+	    .mtlSharedEvent = event,
+	};
+	// MoltenVK sets signaledValue to initialValue on import, so keep the current value.
+	VkSemaphoreTypeCreateInfo type_info = {
+	    .sType = VK_STRUCTURE_TYPE_SEMAPHORE_TYPE_CREATE_INFO,
+	    .pNext = &import_info,
+	    .semaphoreType = VK_SEMAPHORE_TYPE_TIMELINE,
+	    .initialValue = event.signaledValue,
+	};
+	VkSemaphoreCreateInfo create_info = {
+	    .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO,
+	    .pNext = &type_info,
+	};
+
+	VkResult ret = vk->vkCreateSemaphore(vk->device, &create_info, NULL, out_sem);
+	[event release];
+	if (ret != VK_SUCCESS) {
+		VK_ERROR(vk, "vkCreateSemaphore: %s", vk_result_string(ret));
+		return ret;
+	}
+
+	// Import consumes the handle, like an fd import does; the event holds its own right.
+	mach_port_deallocate(mach_task_self(), port);
+
+	return VK_SUCCESS;
+}
