+// What Steam writes to steamapps.vrmanifest on Linux: installed games whose appinfo declares VR support.
+// macOS Steam leaves that file empty.
+void read_steam_vr_apps(const std::filesystem::path & root, std::vector<wivrn::steam::application> & apps)
+{
+	auto installed = installed_steam_apps(root);
+	for (const auto & app: apps)
+		installed.erase(app.appid);
+	if (installed.empty())
+		return;
+
+	struct V
+	{
+		std::vector<std::string> path;
+		std::string type;
+		std::string name;
+		bool vr = false;
+
+		bool in(std::initializer_list<const char *> p) const
+		{
+			return path.size() == p.size() and std::ranges::equal(path, p, [](const std::string & a, const char * b) { return strcasecmp(a.c_str(), b) == 0; });
+		}
+		void begin_dict(const std::string & key)
+		{
+			path.push_back(key);
+		}
+		void end_dict()
+		{
+			if (not path.empty())
+				path.pop_back();
+		}
+		void on_value(const std::string & key, bool set)
+		{
+			if (in({"common"}))
+			{
+				for (auto flag: {"openvrsupport", "openxrsupport", "onlyvrsupport"})
+					if (strcasecmp(key.c_str(), flag) == 0)
+						vr |= set;
+			}
+			else if (in({"common", "category"}))
+			{
+				// VR Supported, VR Only
+				if (strcasecmp(key.c_str(), "category_53") == 0 or strcasecmp(key.c_str(), "category_54") == 0)
+					vr |= set;
+			}
+		}
+		void on_string(const std::string & key, std::string && val)
+		{
+			if (in({"common"}))
+			{
+				if (strcasecmp(key.c_str(), "type") == 0)
+					type = val;
+				else if (strcasecmp(key.c_str(), "name") == 0)
+					name = val;
+			}
+			on_value(key, not val.empty() and val != "0");
+		}
+		void on_uint32_t(const std::string & key, uint32_t val)
+		{
+			on_value(key, val != 0);
+		}
+	};
+
+	read_appinfo(root / "appcache/appinfo.vdf", [&](uint32_t app_id, auto && read) {
+		auto it = installed.find(app_id);
+		if (it == installed.end())
+			return;
+		V v;
+		read(v);
+		// "Tool" excludes SteamVR itself
+		if (not v.vr or (strcasecmp(v.type.c_str(), "game") != 0 and strcasecmp(v.type.c_str(), "demo") != 0))
+			return;
+		wivrn::steam::application app{
+		        .appid = app_id,
+		        .url = std::format("steam://rungameid/{}", app_id),
+		};
+		app.name[""] = v.name.empty() ? it->second : v.name;
+		apps.push_back(std::move(app));
+	});
 }
