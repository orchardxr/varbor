From: macvr
Subject: [PATCH] app-pacer-stable-wake

---
 server/driver/app_pacer.cpp | 39 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 34 insertions(+), 5 deletions(-)

diff --git a/server/driver/app_pacer.cpp b/server/driver/app_pacer.cpp
index af8b2444305ae8be90c86ee63f12d552031cde28..d062acb16168fd302063aea4ccfe9f03d263b50d 100644
--- a/server/driver/app_pacer.cpp
+++ b/server/driver/app_pacer.cpp
@@ -27,8 +27,13 @@
 #include <cmath>
 #include <ranges>
 
-// Default value is half the compositor margin
-DEBUG_GET_ONCE_FLOAT_OPTION(min_margin_ms, "U_PACING_APP_MIN_MARGIN_MS", 1.5f)
+// Covers the compositor's wake jitter and app frames running a few ms long; 1.5 ms (half the compositor margin)
+// made Alyx miss its slot on 4-6 % of frames.
+DEBUG_GET_ONCE_FLOAT_OPTION(min_margin_ms, "U_PACING_APP_MIN_MARGIN_MS", 4.f)
+DEBUG_GET_ONCE_BOOL_OPTION(comp_envelope, "WIVRN_PACER_COMP_ENVELOPE", true)
+DEBUG_GET_ONCE_FLOAT_OPTION(late_tolerance_ms, "WIVRN_PACER_LATE_TOLERANCE_MS", -1.f)
+DEBUG_GET_ONCE_FLOAT_OPTION(comp_rise_ms, "WIVRN_PACER_COMP_RISE_MS", 1.0f)
+DEBUG_GET_ONCE_FLOAT_OPTION(comp_decay_ms, "WIVRN_PACER_COMP_DECAY_MS", 0.1f)
 
 namespace wivrn
 {
@@ -53,6 +58,7 @@ class app_pacer : public u_pacing_app
 		int64_t frame_id;
 		int64_t wake_up;
 		int64_t delivered;
+		int64_t submitted;
 	};
 	std::array<frame, 16> frames{};
 
@@ -134,6 +140,11 @@ void app_pacer::predict(int64_t now_ns,
 
 	// no need to lock, called in same thread as writes
 	auto min_ready = now_ns + cpu_time + gpu_time + compositor_time;
+	// An app that starts a little late usually still makes its slot (the wake time keeps a margin and the
+	// compositor time is an upper bound). Moving it to the next slot instead costs a whole period and a long
+	// wait on the following frame. Negative: a quarter period.
+	float tolerance_ms = debug_get_float_option_late_tolerance_ms();
+	min_ready -= tolerance_ms < 0 ? period / 4 : int64_t(U_TIME_1MS_IN_NS * tolerance_ms);
 	// The ideal display time: one frame after the last
 	last_display_time += period;
 	// Sync phase with compositor
@@ -170,9 +181,11 @@ void app_pacer::mark_point(int64_t frame_id, enum u_timing_point point, int64_t
 		case U_TIMING_POINT_WAKE_UP:
 			frame.wake_up = when_ns;
 			break;
+		case U_TIMING_POINT_SUBMIT_END:
+			frame.submitted = when_ns;
+			break;
 		case U_TIMING_POINT_BEGIN:
 		case U_TIMING_POINT_SUBMIT_BEGIN:
-		case U_TIMING_POINT_SUBMIT_END:
 			break;
 	}
 }
@@ -199,7 +212,21 @@ void app_pacer::info(int64_t predicted_display_time_ns,
 {
 	compositor_display_time = predicted_display_time_ns;
 	period = predicted_display_period_ns;
-	compositor_time = std::max<int64_t>(0, extra_ns);
+	int64_t extra = std::max<int64_t>(0, extra_ns);
+	if (not debug_get_bool_option_comp_envelope() or compositor_time == 0)
+	{
+		compositor_time = extra;
+		return;
+	}
+	// extra_ns is measured from the compositor's actual wake, so it drops whenever the compositor wakes late and
+	// moves the app's wake target by as much, frame to frame. Follow its upper envelope, with a bounded rise so
+	// an increase can't make an on-time app late.
+	auto rise = int64_t(debug_get_float_option_comp_rise_ms() * U_TIME_1MS_IN_NS);
+	auto decay = int64_t(debug_get_float_option_comp_decay_ms() * U_TIME_1MS_IN_NS);
+	if (extra > compositor_time)
+		compositor_time += std::min(extra - compositor_time, rise);
+	else
+		compositor_time -= std::min(compositor_time - extra, decay);
 }
 
 int64_t lerp0(int64_t a, int64_t b, double t)
@@ -217,7 +244,9 @@ void app_pacer::mark_gpu_done(int64_t frame_id, int64_t when_ns)
 
 	std::lock_guard lock(mutex);
 	cpu_time = lerp0(cpu_time, std::min(3 * period, frame.delivered - frame.wake_up), 0.1);
-	gpu_time = lerp0(gpu_time, std::min(3 * period, when_ns - frame.delivered), 0.1);
+	// Not from delivery: the compositor only starts waiting for this frame's GPU work once the previous frame has
+	// been picked up, and counting that wait makes the app look slower the further ahead it is.
+	gpu_time = lerp0(gpu_time, std::min(3 * period, when_ns - std::max(frame.delivered, frame.submitted)), 0.1);
 }
 
 pacing_app_factory::pacing_app_factory() :
