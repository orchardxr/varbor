 src/xrt/state_trackers/oxr/oxr_session_gfx_vk.c |  6 ++--
 src/xrt/state_trackers/oxr/oxr_vulkan.c         | 45 +++++++++++++++++++++++++
 5 files changed, 55 insertions(+), 12 deletions(-)

