diff --git a/src/d3d11/d3d11_interop.hpp b/src/d3d11/d3d11_interop.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..69c1ef05149f117be595986f8a8f12913f6f197e
--- /dev/null
+++ b/src/d3d11/d3d11_interop.hpp
@@ -0,0 +1,43 @@
+#pragma once
+
+/*
+ * Metal interop for native code in the same process (an OpenVR/OpenXR runtime bridge), in the spirit of DXVK's
+ * IDXGIVkInteropSurface / IDXGIVkInteropDevice. Handles are the unix-side Objective-C object pointers
+ * (id<MTLTexture>, id<MTLDevice>, id<MTLSharedEvent>), unretained: they stay valid while the D3D11 object lives.
+ */
+
+#include "com/com_guid.hpp"
+#include "d3d11.h"
+
+struct DXMT_INTEROP_TEXTURE_INFO {
+  UINT64 Texture;     // id<MTLTexture> of the resource's current allocation
+  UINT64 Device;      // id<MTLDevice>
+  UINT PixelFormat;   // MTLPixelFormat
+  UINT TextureType;   // MTLTextureType
+  UINT Usage;         // MTLTextureUsage
+  UINT Width;
+  UINT Height;
+  UINT Depth;
+  UINT ArraySize;
+  UINT MipLevels;
+  UINT SampleCount;
+  UINT D3D11Usage;    // D3D11_USAGE: only DEFAULT/IMMUTABLE textures keep their allocation
+};
+
+DEFINE_COM_INTERFACE("ee7b5b9d-b703-46a9-ac7f-1cc1dddd988b", IDXMTInteropDevice) : public IUnknown {
+  virtual HRESULT STDMETHODCALLTYPE GetMetalDevice(UINT64 *pDevice) = 0;
+  /* ID3D11Multithread::Enter/Leave: keeps other threads off the immediate context between the calls below */
+  virtual void STDMETHODCALLTYPE LockSubmissionQueue() = 0;
+  virtual void STDMETHODCALLTYPE ReleaseSubmissionQueue() = 0;
+  /* Commits all work recorded on the immediate context; *pEvent reaches *pValue once it has completed on the GPU */
+  virtual HRESULT STDMETHODCALLTYPE FlushRenderingCommands(UINT64 *pEvent, UINT64 *pValue) = 0;
+  /* GPU-side signal of an id<MTLSharedEvent> after all work recorded so far (commits it) */
+  virtual HRESULT STDMETHODCALLTYPE SignalEvent(UINT64 Event, UINT64 Value) = 0;
+  /* Work recorded after this call waits on the GPU until the id<MTLSharedEvent> reaches Value */
+  virtual HRESULT STDMETHODCALLTYPE WaitEvent(UINT64 Event, UINT64 Value) = 0;
+};
+
+DEFINE_COM_INTERFACE("0cccd1b1-1a29-44b5-a030-04f28fa3b32b", IDXMTInteropSurface) : public IUnknown {
+  virtual HRESULT STDMETHODCALLTYPE GetDevice(IDXMTInteropDevice **ppDevice) = 0;
+  virtual HRESULT STDMETHODCALLTYPE GetMetalTextureInfo(DXMT_INTEROP_TEXTURE_INFO *pInfo) = 0;
+};
