 	if (dev == nil || ![dev respondsToSelector:@selector(newSharedEventWithMachPort:)]) {
 		VK_ERROR(vk, "No MTLDevice or no newSharedEventWithMachPort:");
diff --git a/src/xrt/state_trackers/oxr/oxr_api_system.c b/src/xrt/state_trackers/oxr/oxr_api_system.c
index a260335640b9522db60c14fb5ab06929a7d3e47c..3341f3b6e37865b7342e6fb40b79d652a9a44914 100644
--- a/src/xrt/state_trackers/oxr/oxr_api_system.c
+++ b/src/xrt/state_trackers/oxr/oxr_api_system.c
@@ -303,10 +303,6 @@ oxr_xrGetVulkanDeviceExtensionsKHR(XrInstance instance,
 	return oxr_vk_get_device_exts(&log, sys, namesCapacityInput, namesCountOutput, namesString);
