# Homebrew dependencies for the WiVRn server, Monado, the encoder and the bridge (README "Requirements").
# The Vulkan loader, headers and glslc come from the LunarG Vulkan SDK in /usr/local (universal, needed by the x86_64
# IPC client); molten-vk is the ICD the server uses at run time.
brew "cmake"
brew "ninja"
brew "pkg-config"
brew "eigen"
brew "jsoncpp"
brew "molten-vk"
brew "glib"
brew "boost"
brew "nlohmann-json"
brew "openssl"
brew "libarchive"
brew "librsvg"
brew "cli11"
brew "libpng"
brew "x264"
