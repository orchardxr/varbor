diff --git a/src/xrt/state_trackers/oxr/oxr_session_gfx_vk.c b/src/xrt/state_trackers/oxr/oxr_session_gfx_vk.c
index a31b5435cca956f82d1590c8e12261299eef5ae4..15689158e9c7ae59a2fdaaaa0f7d8084ee2c438c 100644
--- a/src/xrt/state_trackers/oxr/oxr_session_gfx_vk.c
+++ b/src/xrt/state_trackers/oxr/oxr_session_gfx_vk.c
@@ -37,8 +37,8 @@ check_for_layer_mnd_enable_timeline_semaphore(struct oxr_logger *log,
                                               VkInstance instance,
