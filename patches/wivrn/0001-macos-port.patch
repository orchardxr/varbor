+			if (errno != ENOBUFS and errno != EAGAIN)
+				break;
+		}
+	}
+#else
 	// sendmmsg may not send all messages, just consider them as lost for UDP
 	if (sendmmsg(fd, mmsgs.data(), mmsgs.size(), 0) < 0)
 		throw std::system_error{errno, std::generic_category()};
+#endif
