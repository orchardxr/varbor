+
+// IOPMAssertion through caffeinate: CoreFoundation must not be used in this process
+// before it forks the session.
+sleep_inhibitor::sleep_inhibitor()
+{
+	std::string parent = std::to_string(getpid());
+	const char * argv[] = {"caffeinate", "-i", "-w", parent.c_str(), nullptr};
+	pid_t child;
+	if (int err = posix_spawn(&child, "/usr/bin/caffeinate", nullptr, nullptr, (char **)argv, environ); err != 0)
+	{
+		std::cerr << "Cannot inhibit sleep: " << strerror(err) << std::endl;
+		return;
+	}
+	pid = child;
+}
+
+sleep_inhibitor::~sleep_inhibitor()
+{
+	if (pid <= 0)
+		return;
+	kill(pid, SIGTERM);
+	waitpid(pid, nullptr, 0);
+}
