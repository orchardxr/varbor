+ * along with this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+// Force-included on Apple: C++23 pieces missing from Xcode's libc++.
+#pragma once
+
+#ifdef __cplusplus
+#include <ranges>
+#include <version>
+
+#if defined(__cpp_lib_ranges_zip) && !defined(__cpp_lib_ranges_enumerate)
+namespace std::ranges
+{
+// enumerate_view as zip(iota, view): yields tuple<difference_type, reference>
+template <view V>
+class enumerate_view : public zip_view<iota_view<range_difference_t<V>>, V>
+{
+	using base = zip_view<iota_view<range_difference_t<V>>, V>;
+
+public:
+	enumerate_view() = default;
+	constexpr explicit enumerate_view(V v) :
+	        base(iota_view<range_difference_t<V>>(0), std::move(v)) {}
+};
+
+template <class R>
+enumerate_view(R &&) -> enumerate_view<views::all_t<R>>;
+
+template <class V>
+inline constexpr bool enable_borrowed_range<enumerate_view<V>> = false;
+} // namespace std::ranges
+#endif
+#endif
diff --git a/common/utils/named_thread.h b/common/utils/named_thread.h
index 7acd470ce42bf915ab97f42b14f8b96d644902d0..6369d05738af7974146300ce641e9173bd7b33f7 100644
--- a/common/utils/named_thread.h
+++ b/common/utils/named_thread.h
@@ -29,7 +29,10 @@ template <typename... Args>
 std::thread named_thread(const std::string & name, Args &&... args)
 {
 	std::thread t{std::forward<Args>(args)...};
+#ifndef __APPLE__
+	// macOS can only name the calling thread
 	pthread_setname_np(t.native_handle(), name.substr(0, 15).c_str());
+#endif
 	return t;
 }
 } // namespace utils
