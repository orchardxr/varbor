--- /dev/null
+++ b/OpenOVR/Compositor/mtlcompositor.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include "compositor.h"
+
+class MetalCompositor : public Compositor {
+public:
+	MetalCompositor(const vr::Texture_t* initialTexture);
+
+	~MetalCompositor() override;
+
+	void CopyToSwapchain(const vr::Texture_t* texture, const vr::VRTextureBounds_t* bounds, std::optional<XruEye> eye, vr::EVRSubmitFlags submitFlags) override;
+
+	void InvokeCubemap(const vr::Texture_t* textures) override;
+
+	/**
+	 * The id<MTLCommandQueue> for the session's graphics binding, on the device of texture (an id<MTLTexture>)
+	 * or, without one, on fallbackDevice (an id<MTLDevice>). The compositors copy on the same queue, so the
+	 * runtime's commit (signalled on it) is ordered after the copies. Owned here, one per device.
+	 */
+	static void* QueueForTexture(void* texture, void* fallbackDevice);
+
+private:
+	struct Impl;
+	std::unique_ptr<Impl> impl;
+};
diff --git a/OpenOVR/Compositor/mtlcompositor.mm b/OpenOVR/Compositor/mtlcompositor.mm
new file mode 100644
index 0000000000000000000000000000000000000000..d38559081c4512b2246c12ea61a1f6656f6cae27
--- /dev/null
+++ b/OpenOVR/Compositor/mtlcompositor.mm
@@ -0,0 +1,341 @@
+#if defined(SUPPORT_METAL)
+
+#include "stdafx.h"
+
+#include "mtlcompositor.h"
+
+#include <Metal/Metal.h>
+
+#include <algorithm>
+#include <map>
+#include <mutex>
+
+static const char* const kBlitShaderSource = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct Params {
+	float4 bounds;
+	uint slice;
+	uint mode;
+};
+
+struct VOut {
+	float4 pos [[position]];
+	float2 uv;
+};
+
+vertex VOut vs(uint vid [[vertex_id]], constant Params& p [[buffer(0)]])
+{
+	float2 t = float2((vid << 1) & 2, vid & 2);
+	VOut o;
+	o.pos = float4(t * float2(2, -2) + float2(-1, 1), 0, 1);
+	o.uv = p.bounds.xy + t * (p.bounds.zw - p.bounds.xy);
+	return o;
+}
+
+// The swapchain must end up with the game's bytes: undo the sRGB decode/encode the sample or the write adds
+static float4 convert(float4 c, uint mode)
+{
+	if (mode == 1)
+		c.rgb = select(pow((c.rgb + 0.055) / 1.055, 2.4), c.rgb / 12.92, c.rgb <= 0.04045);
+	else if (mode == 2)
+		c.rgb = select(1.055 * pow(c.rgb, 1.0 / 2.4) - 0.055, c.rgb * 12.92, c.rgb <= 0.0031308);
+	return c;
+}
+
+fragment float4 fs2d(VOut i [[stage_in]], texture2d<float> t [[texture(0)]], sampler s [[sampler(0)]], constant Params& p [[buffer(0)]])
+{
+	return convert(t.sample(s, i.uv), p.mode);
+}
+
+fragment float4 fsArray(VOut i [[stage_in]], texture2d_array<float> t [[texture(0)]], sampler s [[sampler(0)]], constant Params& p [[buffer(0)]])
+{
+	return convert(t.sample(s, i.uv, p.slice), p.mode);
+}
+
+fragment float4 fsMs(VOut i [[stage_in]], texture2d_ms<float> t [[texture(0)]], constant Params& p [[buffer(0)]])
+{
+	float2 size = float2(t.get_width(), t.get_height());
+	uint2 c = uint2(clamp(i.uv * size, float2(0), size - 1));
+	float4 sum = 0;
+	uint n = t.get_num_samples();
+	for (uint k = 0; k < n; k++)
+		sum += t.read(c, k);
+	return convert(sum / n, p.mode);
+}
+)";
+
+struct BlitParams {
+	float bounds[4];
+	uint32_t slice;
+	uint32_t mode;
+	uint32_t pad[2]; // MSL aligns the struct to its float4
+};
+
+static std::mutex queuesMutex;
+static std::map<uint64_t, id<MTLCommandQueue>> queues;
+
+void* MetalCompositor::QueueForTexture(void* texture, void* fallbackDevice)
+{
+	id<MTLDevice> device = texture ? ((__bridge id<MTLTexture>)texture).device : (__bridge id<MTLDevice>)fallbackDevice;
+	OOVR_FALSE_ABORT(device != nil);
+
+	std::lock_guard<std::mutex> lock(queuesMutex);
+	__strong id<MTLCommandQueue>& queue = queues[device.registryID];
+	if (!queue) {
+		queue = [device newCommandQueue];
+		queue.label = @"OpenComposite";
+		OOVR_LOGF("Metal: using %s, queue %p", device.name.UTF8String, (__bridge void*)queue);
+	}
+	return (__bridge void*)queue;
+}
+
+static bool IsSRGB(MTLPixelFormat f)
+{
+	switch (f) {
+	case MTLPixelFormatRGBA8Unorm_sRGB:
+	case MTLPixelFormatBGRA8Unorm_sRGB:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static MTLPixelFormat FormatForColourSpace(MTLPixelFormat f, vr::EColorSpace colourSpace)
+{
+	switch (f) {
+	case MTLPixelFormatRGBA8Unorm:
+	case MTLPixelFormatRGBA8Unorm_sRGB:
+		return colourSpace == vr::ColorSpace_Linear ? MTLPixelFormatRGBA8Unorm : MTLPixelFormatRGBA8Unorm_sRGB;
+	case MTLPixelFormatBGRA8Unorm:
+	case MTLPixelFormatBGRA8Unorm_sRGB:
+		return colourSpace == vr::ColorSpace_Linear ? MTLPixelFormatBGRA8Unorm : MTLPixelFormatBGRA8Unorm_sRGB;
+	case MTLPixelFormatRGB10A2Unorm:
+	case MTLPixelFormatBGR10A2Unorm:
+	case MTLPixelFormatRG11B10Float:
+	case MTLPixelFormatRGBA16Unorm:
+	case MTLPixelFormatRGBA16Float:
+	case MTLPixelFormatRGBA32Float:
+		return f;
+	default:
+		OOVR_ABORTF("Unsupported Metal texture format used: %d", (int)f);
+	}
+}
+
+struct MetalCompositor::Impl {
+	id<MTLDevice> device;
+	id<MTLCommandQueue> queue;
+	std::vector<id<MTLTexture>> images;
+	// The images as the game's format when that is their sRGB/linear twin: blits need identical formats
+	std::vector<id<MTLTexture>> blitTargets;
+	std::vector<int64_t> runtimeFormats;
+
+	// What the current swapchain was made for
+	MTLPixelFormat srcFormat = MTLPixelFormatInvalid;
+	vr::EColorSpace colourSpace = vr::ColorSpace_Auto;
+	uint32_t srcSamples = 0;
+
+	id<MTLLibrary> library;
+	id<MTLSamplerState> sampler;
+	std::map<uint64_t, id<MTLRenderPipelineState>> pipelines;
+
+	id<MTLRenderPipelineState> Pipeline(MTLTextureType srcType, MTLPixelFormat dstFormat)
+	{
+		uint64_t key = ((uint64_t)srcType << 32) | (uint64_t)dstFormat;
+		__strong id<MTLRenderPipelineState>& pipeline = pipelines[key];
+		if (pipeline)
+			return pipeline;
+
+		NSError* error = nil;
+		if (!library) {
+			library = [device newLibraryWithSource:@(kBlitShaderSource) options:nil error:&error];
+			if (!library)
+				OOVR_ABORTF("Metal: compiling the blit shaders failed: %s", error.localizedDescription.UTF8String);
+
+			MTLSamplerDescriptor* samplerDesc = [MTLSamplerDescriptor new];
+			samplerDesc.minFilter = MTLSamplerMinMagFilterLinear;
+			samplerDesc.magFilter = MTLSamplerMinMagFilterLinear;
+			samplerDesc.sAddressMode = MTLSamplerAddressModeClampToEdge;
+			samplerDesc.tAddressMode = MTLSamplerAddressModeClampToEdge;
+			sampler = [device newSamplerStateWithDescriptor:samplerDesc];
+		}
+
+		NSString* fs = srcType == MTLTextureType2DMultisample ? @"fsMs" : srcType == MTLTextureType2DArray ? @"fsArray"
+		                                                                                                     : @"fs2d";
+		MTLRenderPipelineDescriptor* desc = [MTLRenderPipelineDescriptor new];
+		desc.label = @"OpenComposite blit";
+		desc.vertexFunction = [library newFunctionWithName:@"vs"];
+		desc.fragmentFunction = [library newFunctionWithName:fs];
+		desc.colorAttachments[0].pixelFormat = dstFormat;
+		pipeline = [device newRenderPipelineStateWithDescriptor:desc error:&error];
+		if (!pipeline)
+			OOVR_ABORTF("Metal: creating the blit pipeline failed: %s", error.localizedDescription.UTF8String);
+		return pipeline;
+	}
+};
+
+MetalCompositor::MetalCompositor(const vr::Texture_t* initialTexture)
+    : impl(std::make_unique<Impl>())
+{
+	impl->queue = (__bridge id<MTLCommandQueue>)QueueForTexture(initialTexture->handle, nullptr);
+	impl->device = impl->queue.device;
+
+	uint32_t count = 0;
+	OOVR_FAILED_XR_ABORT(xrEnumerateSwapchainFormats(xr_session.get(), 0, &count, nullptr));
+	impl->runtimeFormats.resize(count);
+	OOVR_FAILED_XR_ABORT(xrEnumerateSwapchainFormats(xr_session.get(), count, &count, impl->runtimeFormats.data()));
+}
+
+MetalCompositor::~MetalCompositor() = default;
+
+void MetalCompositor::CopyToSwapchain(const vr::Texture_t* texture, const vr::VRTextureBounds_t* bounds, std::optional<XruEye> eye, vr::EVRSubmitFlags submitFlags)
+{
+	id<MTLTexture> src = (__bridge id<MTLTexture>)texture->handle;
+	if (!src)
+		OOVR_ABORT("Cannot use a nil MTLTexture");
+	if (src.device != impl->device)
+		OOVR_ABORTF("MTLTexture is on device %s, the session is on %s", src.device.name.UTF8String, impl->device.name.UTF8String);
+
+	bool usable = chain != XR_NULL_HANDLE && impl->srcFormat == src.pixelFormat && impl->colourSpace == texture->eColorSpace
+	    && impl->srcSamples == src.sampleCount && createInfo.width == src.width && createInfo.height == src.height;
+
+	if (!usable) {
+		OOVR_LOGF("Generating new swap chain: %dx%d, MTLPixelFormat %d, %d samples, colour space %d",
+		    (int)src.width, (int)src.height, (int)src.pixelFormat, (int)src.sampleCount, (int)texture->eColorSpace);
+
+		if (chain)
+			xrDestroySwapchain(chain);
+		chain = XR_NULL_HANDLE;
+
+		MTLPixelFormat format = FormatForColourSpace(src.pixelFormat, texture->eColorSpace);
+		auto supported = [&](MTLPixelFormat f) {
+			return std::find(impl->runtimeFormats.begin(), impl->runtimeFormats.end(), (int64_t)f) != impl->runtimeFormats.end();
+		};
+		if (!supported(format)) {
+			MTLPixelFormat fallback = IsSRGB(format) ? MTLPixelFormatRGBA8Unorm_sRGB : MTLPixelFormatRGBA16Float;
+			if (!supported(fallback))
+				OOVR_ABORTF("Runtime supports neither MTLPixelFormat %d nor %d", (int)format, (int)fallback);
+			OOVR_LOGF("Runtime has no MTLPixelFormat %d swapchains, converting to %d", (int)format, (int)fallback);
+			format = fallback;
+		}
+
+		bool twin = format != src.pixelFormat && FormatForColourSpace(src.pixelFormat, vr::ColorSpace_Linear) == FormatForColourSpace(format, vr::ColorSpace_Linear);
+
+		createInfo = { XR_TYPE_SWAPCHAIN_CREATE_INFO };
+		createInfo.usageFlags = XR_SWAPCHAIN_USAGE_TRANSFER_DST_BIT | XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT;
+		if (twin)
+			createInfo.usageFlags |= XR_SWAPCHAIN_USAGE_MUTABLE_FORMAT_BIT;
+		createInfo.format = format;
+		createInfo.faceCount = 1;
+		createInfo.width = src.width;
+		createInfo.height = src.height;
+		createInfo.mipCount = 1;
+		createInfo.sampleCount = 1;
+		createInfo.arraySize = 1;
+		OOVR_FAILED_XR_ABORT(xrCreateSwapchain(xr_session.get(), &createInfo, &chain));
+
+		uint32_t chainLength = 0;
+		OOVR_FAILED_XR_ABORT(xrEnumerateSwapchainImages(chain, 0, &chainLength, nullptr));
+		std::vector<XrSwapchainImageMetalKHR> images(chainLength, { XR_TYPE_SWAPCHAIN_IMAGE_METAL_KHR });
+		OOVR_FAILED_XR_ABORT(xrEnumerateSwapchainImages(chain, chainLength, &chainLength, (XrSwapchainImageBaseHeader*)images.data()));
+		impl->images.clear();
+		impl->blitTargets.clear();
+		for (const XrSwapchainImageMetalKHR& image : images) {
+			id<MTLTexture> texture = (__bridge id<MTLTexture>)image.texture;
+			impl->images.push_back(texture);
+			impl->blitTargets.push_back(twin ? [texture newTextureViewWithPixelFormat:src.pixelFormat] : texture);
+		}
+
+		impl->srcFormat = src.pixelFormat;
+		impl->colourSpace = texture->eColorSpace;
+		impl->srcSamples = src.sampleCount;
+	}
+
+	XrSwapchainImageAcquireInfo acquireInfo{ XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO };
+	uint32_t currentIndex;
+	OOVR_FAILED_XR_ABORT(xrAcquireSwapchainImage(chain, &acquireInfo, &currentIndex));
+
+	XrSwapchainImageWaitInfo waitInfo{ XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO };
+	waitInfo.timeout = XR_INFINITE_DURATION;
+	OOVR_FAILED_XR_ABORT(xrWaitSwapchainImage(chain, &waitInfo));
+
+	@autoreleasepool {
+		id<MTLTexture> dst = impl->images.at(currentIndex);
+		NSUInteger slice = (src.textureType == MTLTextureType2DArray && eye.has_value()) ? (NSUInteger)*eye : 0;
+		MTLPixelFormat dstFormat = (MTLPixelFormat)createInfo.format;
+
+		id<MTLCommandBuffer> cmd = [impl->queue commandBuffer];
+		cmd.label = @"OpenComposite submit";
+
+		id<MTLTexture> blitTarget = impl->blitTargets.at(currentIndex);
+		if (!bounds && src.sampleCount == 1 && blitTarget.pixelFormat == src.pixelFormat) {
+			MTLOrigin origin = MTLOriginMake(0, 0, 0);
+			MTLSize size = MTLSizeMake(src.width, src.height, 1);
+			if (copyBounds && src.mipmapLevelCount == 1) {
+				const int pad = 2;
+				int left = std::max(0, (int)(std::min(copyBounds->uMin, copyBounds->uMax) * src.width) - pad);
+				int right = std::min((int)src.width, (int)(std::max(copyBounds->uMin, copyBounds->uMax) * src.width + 0.5f) + pad);
+				int top = std::max(0, (int)(std::min(copyBounds->vMin, copyBounds->vMax) * src.height) - pad);
+				int bottom = std::min((int)src.height, (int)(std::max(copyBounds->vMin, copyBounds->vMax) * src.height + 0.5f) + pad);
+				origin = MTLOriginMake(left, top, 0);
+				size = MTLSizeMake(std::max(0, right - left), std::max(0, bottom - top), 1);
+			}
+
+			if (size.width > 0 && size.height > 0) {
+				id<MTLBlitCommandEncoder> blit = [cmd blitCommandEncoder];
+				[blit copyFromTexture:src
+				          sourceSlice:slice
+				          sourceLevel:0
+				         sourceOrigin:origin
+				           sourceSize:size
+				            toTexture:blitTarget
+				     destinationSlice:0
+				     destinationLevel:0
+				    destinationOrigin:origin];
+				[blit endEncoding];
+			}
+		} else {
+			BlitParams params = {};
+			if (bounds) {
+				params.bounds[0] = bounds->uMin;
+				params.bounds[1] = bounds->vMin;
+				params.bounds[2] = bounds->uMax;
+				params.bounds[3] = bounds->vMax;
+			} else {
+				params.bounds[2] = params.bounds[3] = 1.0f;
+			}
+			params.slice = (uint32_t)slice;
+			if (IsSRGB(dstFormat) && !IsSRGB(src.pixelFormat))
+				params.mode = 1;
+			else if (!IsSRGB(dstFormat) && IsSRGB(src.pixelFormat))
+				params.mode = 2;
+
+			MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+			pass.colorAttachments[0].texture = dst;
+			pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+			pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+
+			id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:pass];
+			[enc setRenderPipelineState:impl->Pipeline(src.textureType, dstFormat)];
+			[enc setVertexBytes:&params length:sizeof(params) atIndex:0];
+			[enc setFragmentBytes:&params length:sizeof(params) atIndex:0];
+			[enc setFragmentTexture:src atIndex:0];
+			[enc setFragmentSamplerState:impl->sampler atIndex:0];
+			[enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+			[enc endEncoding];
+		}
+
+		[cmd commit];
+	}
+
+	XrSwapchainImageReleaseInfo releaseInfo{ XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO };
+	OOVR_FAILED_XR_ABORT(xrReleaseSwapchainImage(chain, &releaseInfo));
+}
+
+void MetalCompositor::InvokeCubemap(const vr::Texture_t* textures)
+{
+	OOVR_ABORT("MetalCompositor::InvokeCubemap: Not yet supported!");
+}
