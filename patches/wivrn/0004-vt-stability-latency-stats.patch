 server/encoder/idr_handler.h        |  2 +-
 server/encoder/video_encoder_vt.cpp | 21 +++++++++++--
 server/encoder/video_encoder_vt.h   |  2 ++
 6 files changed, 98 insertions(+), 4 deletions(-)

diff --git a/server/compositor/pacer.cpp b/server/compositor/pacer.cpp
index e4fb501b980c08f63279c640616ca2242cb2b979..412451c3aee80863cfd05b5d36ba8a44422a7d13 100644
--- a/server/compositor/pacer.cpp
+++ b/server/compositor/pacer.cpp
@@ -24,9 +24,12 @@
 #include "util/u_var.h"
 #include <algorithm>
 #include <cmath>
+#include <format>
+#include <string>
 
 #include "os/os_time.h"
 #include "util/u_debug.h"
+#include "util/u_logging.h"
 
 DEBUG_GET_ONCE_FLOAT_OPTION(client_margin_ms, "WIVRN_CLIENT_MARGIN_MS", 1.f)
 
@@ -144,6 +147,31 @@ void pacer::on_feedback(const wivrn::from_headset::feedback & feedback, const cl
 	}
 	times.decoded = std::max(times.decoded, offset.from_headset(feedback.received_from_decoder));
 
+	if (feedback.stream_index == 0 and feedback.encode_begin and feedback.send_end and feedback.received_last_packet and
+	    feedback.sent_to_decoder and feedback.received_from_decoder and feedback.displayed)
+	{
+		auto ms = [](int64_t ns) { return float(ns / 1e6); };
+		latency_samples.push_back({
+		        .present_to_encode = ms(offset.from_headset(feedback.encode_begin) - when.present_ns),
+		        .encode = ms(feedback.encode_end - feedback.encode_begin),
+		        .send = ms(feedback.send_end - feedback.encode_end),
+		        .network = ms(feedback.received_last_packet - feedback.send_end),
+		        .decode = ms(feedback.received_from_decoder - feedback.sent_to_decoder),
+		        .decoded_to_blit = ms(feedback.blitted - feedback.received_from_decoder),
+		        .blit_to_display = ms(feedback.displayed - feedback.blitted),
+		        .present_to_decoded = ms(offset.from_headset(feedback.received_from_decoder) - when.present_ns),
+		        .display_error = ms(offset.from_headset(feedback.displayed) - when.predicted_display_time),
+		});
+		auto now = os_monotonic_get_ns();
+		if (latency_log_start == 0)
+			latency_log_start = now;
+		else if (now - latency_log_start > 10'000'000'000)
+		{
+			log_latency();
+			latency_log_start = now;
+		}
+	}
+
 	if (feedback.stream_index == 0)
 	{
 		if (feedback.frame_index % 100 == 0)
@@ -164,6 +192,37 @@ void pacer::on_feedback(const wivrn::from_headset::feedback & feedback, const cl
 	if (feedback.displayed and feedback.displayed > feedback.blitted and feedback.displayed < feedback.blitted + 100'000'000)
 		mean_render_to_display_ns = std::lerp(mean_render_to_display_ns, feedback.displayed - feedback.blitted, 0.1);
 }
+void pacer::log_latency()
+{
+	if (latency_samples.empty())
+		return;
+	std::string line;
+	auto add = [&](const char * name, float latency_sample::*field) {
+		std::vector<float> v;
+		v.reserve(latency_samples.size());
+		for (const auto & s: latency_samples)
+			v.push_back(s.*field);
+		std::ranges::sort(v);
+		line += std::format(" {} {:.1f}/{:.1f}", name, v[v.size() / 2], v[std::min(v.size() - 1, v.size() * 95 / 100)]);
+	};
+	add("present>encode", &latency_sample::present_to_encode);
+	add("encode", &latency_sample::encode);
+	add("send", &latency_sample::send);
+	add("network", &latency_sample::network);
+	add("decode", &latency_sample::decode);
+	add("decoded>blit", &latency_sample::decoded_to_blit);
+	add("blit>display", &latency_sample::blit_to_display);
+	add("present>decoded", &latency_sample::present_to_decoded);
+	add("display-predicted", &latency_sample::display_error);
+	U_LOG_I("latency ms p50/p95, %zu frames:%s; pacer: safe present>decoded %.1f, render>display %.1f, wake>present %.1f",
+	        latency_samples.size(),
+	        line.c_str(),
+	        safe_present_to_decoded_ns / 1e6,
+	        mean_render_to_display_ns / 1e6,
+	        mean_wake_up_to_present_ns / 1e6);
+	latency_samples.clear();
+}
+
 void pacer::mark_timing_point(
         comp_target_timing_point point,
         int64_t frame_id,
