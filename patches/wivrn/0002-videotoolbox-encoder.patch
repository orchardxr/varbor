 #include "renderdoc_app.h"
 
@@ -694,6 +696,11 @@ int compositor::acquire_image()
 
 void compositor::encoder_work(std::stop_token tok)
 {
+	// VideoToolbox sessions run at full speed side by side but take 2x as long back to back,
+	// so encode the streams in parallel. Each encoder only touches its own state; the sender
+	// queue is shared and locked.
+	const bool parallel = std::ranges::all_of(settings, [](const encoder_settings & s) { return s.encoder_name == encoder_videotoolbox; });
+
 	while (not tok.stop_requested())
 	{
 		auto req = encode_request.exchange(-1);
@@ -711,10 +718,46 @@ void compositor::encoder_work(std::stop_token tok)
 
 		try
 		{
-			for (auto & encoder: encoders)
+			if (parallel)
+			{
+				std::array<std::future<void>, std::tuple_size_v<decltype(encoders)>> pending;
+				for (auto [i, encoder]: std::ranges::enumerate_view(encoders))
+				{
+					if (i == 0 or not(encoder->stream_idx < 2 or image.view_info.alpha))
+						continue;
+					pending[i] = std::async(std::launch::async, [&, e = encoder.get()] { e->encode(session, image.view_info, image.frame_index); });
+				}
+				std::exception_ptr error;
+				try
+				{
+					encoders[0]->encode(session, image.view_info, image.frame_index);
+				}
+				catch (...)
+				{
+					error = std::current_exception();
+				}
+				for (auto & f: pending)
+				{
+					try
+					{
+						if (f.valid())
+							f.get();
+					}
+					catch (...)
+					{
+						error = std::current_exception();
+					}
+				}
+				if (error)
+					std::rethrow_exception(error);
+			}
+			else
 			{
-				if (encoder->stream_idx < 2 or image.view_info.alpha)
-					encoder->encode(session, image.view_info, image.frame_index);
+				for (auto & encoder: encoders)
+				{
+					if (encoder->stream_idx < 2 or image.view_info.alpha)
+						encoder->encode(session, image.view_info, image.frame_index);
+				}
 			}
 		}
 		catch (std::exception & e)
