--- a/server/compositor/pacer.h
+++ b/server/compositor/pacer.h
@@ -74,6 +74,15 @@ private:
 
 	std::array<frame_info, 8> in_flight_frames;
 
+	// Stream 0 latency breakdown, logged every 10 s
+	struct latency_sample
+	{
+		float present_to_encode, encode, send, network, decode, decoded_to_blit, blit_to_display, present_to_decoded, display_error;
+	};
+	std::vector<latency_sample> latency_samples;
+	int64_t latency_log_start = 0;
+	void log_latency();
+
 public:
 	pacer(uint64_t frame_duration);
 	~pacer();
