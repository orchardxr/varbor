From: macvr
Subject: [PATCH] multi-pacer-submit-point

---
 src/xrt/auxiliary/util/u_pacing_app.c            | 2 +-
 src/xrt/compositor/multi/comp_multi_compositor.c | 6 ++++++
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/xrt/auxiliary/util/u_pacing_app.c b/src/xrt/auxiliary/util/u_pacing_app.c
index d5697ff4b42787e7e6e01ec4e4ff33a3119107ec..caff852df8a813a74e95bdc527cf35eff76052bd 100644
--- a/src/xrt/auxiliary/util/u_pacing_app.c
+++ b/src/xrt/auxiliary/util/u_pacing_app.c
@@ -567,8 +567,8 @@ pa_mark_point(struct u_pacing_app *upa, int64_t frame_id, enum u_timing_point po
 		f->when.begin_ns = when_ns;
 		f->state = U_RT_BEGUN;
 		break;
+	case U_TIMING_POINT_SUBMIT_END: break;
 	case U_TIMING_POINT_SUBMIT_BEGIN:
-	case U_TIMING_POINT_SUBMIT_END:
 	default: assert(false);
 	}
 }
diff --git a/src/xrt/compositor/multi/comp_multi_compositor.c b/src/xrt/compositor/multi/comp_multi_compositor.c
index 9c3cc19a61f47444fb1497b2648be18a900bd2cb..0b822a37157ddc668168bd8bdcd9ed9b0df0de58 100644
--- a/src/xrt/compositor/multi/comp_multi_compositor.c
+++ b/src/xrt/compositor/multi/comp_multi_compositor.c
@@ -326,6 +326,12 @@ run_func(void *ptr)
 		}
 
 		os_mutex_lock(&mc->msc->list_and_timing_lock);
+		/*
+		 * The GPU wait only starts once the previous frame has left the
+		 * scheduled slot, so delivered->gpu_done includes that backpressure.
+		 * Tell the pacer when this frame was actually handed over.
+		 */
+		u_pa_mark_point(mc->upa, frame_id, U_TIMING_POINT_SUBMIT_END, commit_ns);
 		u_pa_mark_gpu_done(mc->upa, frame_id, now_ns);
 		os_mutex_unlock(&mc->msc->list_and_timing_lock);
 
