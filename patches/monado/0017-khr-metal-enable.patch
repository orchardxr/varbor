index 0000000000000000000000000000000000000000..1c3c01fe5d14a8365ff6b9515a890c7b4ad35d3d
--- /dev/null
+++ b/src/xrt/state_trackers/oxr/oxr_session_gfx_metal.c
@@ -0,0 +1,31 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Holds Metal specific session functions.
+ * @ingroup oxr_main
+ * @ingroup comp_client
+ */
+
+#include "xrt/xrt_gfx_metal.h"
+
+#include "oxr_objects.h"
+#include "oxr_logger.h"
+
+
+XrResult
+oxr_session_populate_metal(struct oxr_logger *log,
+                           struct oxr_system *sys,
+                           XrGraphicsBindingMetalKHR const *next,
+                           struct oxr_session *sess)
+{
+	struct xrt_compositor_metal *xcmtl = xrt_gfx_metal_provider_create(sess->xcn, next->commandQueue);
+	if (xcmtl == NULL) {
+		return oxr_error(log, XR_ERROR_INITIALIZATION_FAILED, "Failed to create a Metal client compositor");
+	}
+
+	sess->compositor = &xcmtl->base;
+	sess->create_swapchain = oxr_swapchain_metal_create;
+
+	return XR_SUCCESS;
+}
diff --git a/src/xrt/state_trackers/oxr/oxr_swapchain_metal.c b/src/xrt/state_trackers/oxr/oxr_swapchain_metal.c
