From: macvr
Subject: [PATCH] vk-enable-portability-subset-features

---
 src/xrt/auxiliary/vk/vk_bundle_init.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/xrt/auxiliary/vk/vk_bundle_init.c b/src/xrt/auxiliary/vk/vk_bundle_init.c
index 42c1f531ba72f10543f05ce024207c13925e549e..e8b4065c620eecb608c791c3aab616b2a39d9afb 100644
--- a/src/xrt/auxiliary/vk/vk_bundle_init.c
+++ b/src/xrt/auxiliary/vk/vk_bundle_init.c
@@ -1155,6 +1155,24 @@ vk_create_device(struct vk_bundle *vk,
 	}
 #endif
 
+#ifdef VK_KHR_portability_subset
+	// Enable everything the portability implementation supports, the subset is not opt-out.
+	VkPhysicalDevicePortabilitySubsetFeaturesKHR portability_subset_info = {
+	    .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PORTABILITY_SUBSET_FEATURES_KHR,
+	    .pNext = NULL,
+	};
+	if (vk->has_KHR_portability_subset) {
+		VkPhysicalDeviceFeatures2 features2 = {
+		    .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+		    .pNext = &portability_subset_info,
+		};
+		vk->vkGetPhysicalDeviceFeatures2(vk->physical_device, &features2);
+		portability_subset_info.pNext = NULL;
+		vk_append_to_pnext_chain((VkBaseInStructure *)&device_create_info,
+		                         (VkBaseInStructure *)&portability_subset_info);
+	}
+#endif
+
 	ret = vk->vkCreateDevice(vk->physical_device, &device_create_info, NULL, &vk->device);
 
 	// Destroy the list now.
