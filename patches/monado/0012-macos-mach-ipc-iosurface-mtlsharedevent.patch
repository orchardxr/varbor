 		return;
 	}
@@ -345,9 +352,12 @@ ipc_receive_handles_graphics_buffer(struct ipc_message_channel *imc,
                                     xrt_graphics_buffer_handle_t *out_handles,
                                     uint32_t handle_count)
 {
-	//! @todo Mach port side channel, Mach ports can't be sent with SCM_RIGHTS.
-	IPC_ERROR(imc, "Can not receive IOSurface Mach ports yet");
-	return XRT_ERROR_IPC_FAILURE;
+	xrt_result_t xret = ipc_receive(imc, out_data, size);
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+	// The sender queues the Mach message before the socket message.
+	return ipc_mach_receive_ports(imc, out_handles, handle_count);
 }
 
 xrt_result_t
@@ -357,9 +367,11 @@ ipc_send_handles_graphics_buffer(struct ipc_message_channel *imc,
                                  const xrt_graphics_buffer_handle_t *handles,
                                  uint32_t handle_count)
 {
-	//! @todo Mach port side channel, Mach ports can't be sent with SCM_RIGHTS.
-	IPC_ERROR(imc, "Can not send IOSurface Mach ports yet");
-	return XRT_ERROR_IPC_FAILURE;
+	xrt_result_t xret = ipc_mach_send_ports(imc, handles, handle_count);
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+	return ipc_send(imc, data, size);
 }
 
 #else
@@ -403,6 +415,36 @@ ipc_send_handles_graphics_sync(struct ipc_message_channel *imc,
 	return ipc_send_fds(imc, data, size, handles, handle_count);
 }
 
+#elif defined(XRT_GRAPHICS_SYNC_HANDLE_IS_MACH_PORT)
+
+xrt_result_t
+ipc_receive_handles_graphics_sync(struct ipc_message_channel *imc,
+                                  void *out_data,
+                                  size_t size,
+                                  xrt_graphics_sync_handle_t *out_handles,
+                                  uint32_t handle_count)
+{
+	xrt_result_t xret = ipc_receive(imc, out_data, size);
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+	return ipc_mach_receive_ports(imc, out_handles, handle_count);
+}
+
+xrt_result_t
+ipc_send_handles_graphics_sync(struct ipc_message_channel *imc,
+                               const void *data,
+                               size_t size,
+                               const xrt_graphics_sync_handle_t *handles,
+                               uint32_t handle_count)
+{
+	xrt_result_t xret = ipc_mach_send_ports(imc, handles, handle_count);
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+	return ipc_send(imc, data, size);
+}
+
 #else
 #error "Need port to transport these graphics buffers"
 #endif
