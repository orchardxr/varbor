@@ -0,0 +1,54 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Metal device requirements for XR_KHR_metal_enable.
+ * @ingroup oxr_main
+ */
+
+#import <Metal/Metal.h>
+
+#include "oxr_objects.h"
+#include "oxr_logger.h"
+
+
+static id<MTLDevice>
+get_device(void)
+{
+	static id<MTLDevice> dev = nil;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		dev = MTLCreateSystemDefaultDevice();
+	});
+	return dev;
+}
+
+XrResult
+oxr_metal_get_requirements(struct oxr_logger *log,
+                           struct oxr_system *sys,
+                           XrGraphicsRequirementsMetalKHR *graphicsRequirements)
+{
+	id<MTLDevice> dev = get_device();
+	if (dev == nil) {
+		return oxr_error(log, XR_ERROR_RUNTIME_FAILURE, "No Metal device");
+	}
+
+	graphicsRequirements->metalDevice = dev;
+
+	return XR_SUCCESS;
+}
+
+XrResult
+oxr_metal_check_command_queue(struct oxr_logger *log, struct oxr_system *sys, void *command_queue)
+{
+	id<MTLDevice> dev = get_device();
+	id<MTLDevice> queue_dev = ((id<MTLCommandQueue>)command_queue).device;
+
+	if (dev == nil || queue_dev.registryID != dev.registryID) {
+		return oxr_error(log, XR_ERROR_GRAPHICS_DEVICE_INVALID,
+		                 "XrGraphicsBindingMetalKHR::commandQueue is not on the device from "
+		                 "xrGetMetalGraphicsRequirementsKHR");
+	}
+
+	return XR_SUCCESS;
+}
