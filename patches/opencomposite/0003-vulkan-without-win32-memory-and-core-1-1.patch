From: macvr
Subject: [PATCH] vulkan-without-win32-memory-and-core-1-1

---
 DrvOpenXR/XrBackend.cpp           | 16 ++++++++++++++--
 DrvOpenXR/tmp_gfx/TemporaryVk.cpp | 22 ++++++++++++++++++----
 2 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/DrvOpenXR/XrBackend.cpp b/DrvOpenXR/XrBackend.cpp
index 3e246d9decb34ce0b9e59acb20383025fe072dcc..29dbab85380420147a2ff017d7c841aa0b34fef1 100644
--- a/DrvOpenXR/XrBackend.cpp
+++ b/DrvOpenXR/XrBackend.cpp
@@ -1206,6 +1206,18 @@ const void* XrBackend::GetCurrentGraphicsBinding()
 }
 
 #ifdef SUPPORT_VK
+// Instances created for Vulkan 1.0 (OpenComposite's temporary one, and some games) may not have the core 1.1
+// entry point: Wine on macOS crashes in it. Both have VK_KHR_get_physical_device_properties2 enabled, since the
+// runtime asks for it.
+static void GetPhysicalDeviceProperties2(VkInstance instance, VkPhysicalDevice dev, VkPhysicalDeviceProperties2* props)
+{
+	auto fn = (PFN_vkGetPhysicalDeviceProperties2)vkGetInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties2KHR");
+	if (!fn)
+		fn = (PFN_vkGetPhysicalDeviceProperties2)vkGetInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties2");
+	OOVR_FALSE_ABORT(fn);
+	fn(dev, props);
+}
+
 void XrBackend::VkGetPhysicalDevice(VkInstance instance, VkPhysicalDevice* out)
 {
 	*out = VK_NULL_HANDLE;
@@ -1217,7 +1229,7 @@ void XrBackend::VkGetPhysicalDevice(VkInstance instance, VkPhysicalDevice* out)
 	// Find the UUID of the physical device the temporary instance is running on
 	VkPhysicalDeviceIDProperties idProps = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
 	VkPhysicalDeviceProperties2 props = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &idProps };
-	vkGetPhysicalDeviceProperties2(vk->physicalDevice, &props);
+	GetPhysicalDeviceProperties2(vk->instance, vk->physicalDevice, &props);
 
 	// Look through all the physical devices on the target instance and find the matching one
 	uint32_t devCount;
@@ -1228,7 +1240,7 @@ void XrBackend::VkGetPhysicalDevice(VkInstance instance, VkPhysicalDevice* out)
 	for (VkPhysicalDevice phy : physicalDevices) {
 		VkPhysicalDeviceIDProperties devIdProps = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES };
 		VkPhysicalDeviceProperties2 devProps = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, &devIdProps };
-		vkGetPhysicalDeviceProperties2(phy, &devProps);
+		GetPhysicalDeviceProperties2(instance, phy, &devProps);
 
 		if (memcmp(devIdProps.deviceUUID, idProps.deviceUUID, sizeof(devIdProps.deviceUUID)) != 0)
 			continue;
diff --git a/DrvOpenXR/tmp_gfx/TemporaryVk.cpp b/DrvOpenXR/tmp_gfx/TemporaryVk.cpp
index 674ea604368305d6ddbd7cd6baefe87fca90894d..0cc114be60c36916eb9524ef82277551e8150c73 100644
--- a/DrvOpenXR/tmp_gfx/TemporaryVk.cpp
+++ b/DrvOpenXR/tmp_gfx/TemporaryVk.cpp
@@ -94,13 +94,27 @@ TemporaryVk::TemporaryVk()
 		parseExtensionsStr(deviceExtensionsStr, deviceExtensionsStore, deviceExtensionsCstr);
 	}
 
-	// Needed if the app ends up using Vulkan
-	deviceExtensionsCstr.push_back(VK_KHR_EXTERNAL_MEMORY_EXTENSION_NAME);
+	// Needed if the app ends up using Vulkan. Only add what the device has: Wine on macOS (MoltenVK) has no
+	// VK_KHR_external_memory_win32, and nothing here uses it.
+	uint32_t availCount = 0;
+	vkEnumerateDeviceExtensionProperties(physicalDevice, nullptr, &availCount, nullptr);
+	std::vector<VkExtensionProperties> avail(availCount);
+	vkEnumerateDeviceExtensionProperties(physicalDevice, nullptr, &availCount, avail.data());
+	auto addIfSupported = [&](const char* name) {
+		for (const VkExtensionProperties& e : avail) {
+			if (strcmp(e.extensionName, name) == 0) {
+				deviceExtensionsCstr.push_back(name);
+				return;
+			}
+		}
+		OOVR_LOGF("Device extension %s not supported, not enabling it", name);
+	};
+	addIfSupported(VK_KHR_EXTERNAL_MEMORY_EXTENSION_NAME);
 #ifdef _WIN32
 	// Don't import vulkan_win32 just for this constant, so hardcode the string
-	deviceExtensionsCstr.push_back(VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME);
+	addIfSupported(VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME);
 #else
-	deviceExtensionsCstr.push_back(VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME);
+	addIfSupported(VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME);
 #endif
 
 	devCreateInfo.enabledExtensionCount = deviceExtensionsCstr.size();
