+
+#include "coreaudio_tap.h"
+
+#import <CoreAudio/AudioHardwareTapping.h>
+#import <CoreAudio/CATapDescription.h>
+#import <Foundation/Foundation.h>
+
+#include <format>
+#include <stdexcept>
+
+namespace wivrn::coreaudio
+{
+
+static CATapDescription * make_description(const tap_target & target, bool mono)
+{
+	NSMutableArray<NSNumber *> * processes = [NSMutableArray array];
+	for (auto p: target.processes)
+		[processes addObject:@(p)];
+
+	CATapDescription * desc;
+	if (target.exclusive)
+		desc = mono ? [[CATapDescription alloc] initMonoGlobalTapButExcludeProcesses:processes]
+		            : [[CATapDescription alloc] initStereoGlobalTapButExcludeProcesses:processes];
+	else
+		desc = mono ? [[CATapDescription alloc] initMonoMixdownOfProcesses:processes]
+		            : [[CATapDescription alloc] initStereoMixdownOfProcesses:processes];
+	desc.name = @"WiVRn";
+	desc.privateTap = YES;
+	desc.muteBehavior = CATapMutedWhenTapped;
+	return desc;
+}
+
+AudioObjectID create_tap(const tap_target & target, bool mono)
+{
+	@autoreleasepool
+	{
+		AudioObjectID tap = kAudioObjectUnknown;
+		OSStatus status = AudioHardwareCreateProcessTap(make_description(target, mono), &tap);
+		if (status != noErr)
+			throw std::runtime_error(std::format("AudioHardwareCreateProcessTap failed: {}", status));
+		return tap;
+	}
+}
+
+void set_tap_target(AudioObjectID tap, const tap_target & target, bool mono)
+{
+	@autoreleasepool
+	{
+		AudioObjectPropertyAddress addr{kAudioTapPropertyDescription, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+		CATapDescription * desc = make_description(target, mono);
+
+		// keep the tap's UUID, the aggregate device refers to it
+		CFTypeRef raw = nullptr;
+		UInt32 size = sizeof(raw);
+		if (AudioObjectGetPropertyData(tap, &addr, 0, nullptr, &size, &raw) == noErr and raw)
+			desc.UUID = ((__bridge_transfer CATapDescription *)raw).UUID;
+
+		OSStatus status = AudioObjectSetPropertyData(tap, &addr, 0, nullptr, sizeof(desc), &desc);
+		if (status != noErr)
+			throw std::runtime_error(std::format("failed to update the audio tap: {}", status));
+	}
+}
+
+void destroy_tap(AudioObjectID tap)
+{
+	AudioHardwareDestroyProcessTap(tap);
+}
+
+AudioObjectID create_tap_aggregate(AudioObjectID tap)
+{
+	@autoreleasepool
+	{
+		AudioObjectPropertyAddress addr{kAudioTapPropertyUID, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+		CFStringRef tap_uid = nullptr;
+		UInt32 size = sizeof(tap_uid);
+		OSStatus status = AudioObjectGetPropertyData(tap, &addr, 0, nullptr, &size, &tap_uid);
+		if (status != noErr or not tap_uid)
+			throw std::runtime_error(std::format("failed to get the audio tap UID: {}", status));
+
+		NSDictionary * desc = @{
+			@kAudioAggregateDeviceNameKey: @"WiVRn",
+			@kAudioAggregateDeviceUIDKey: [NSString stringWithFormat:@"io.github.wivrn.tap.%@", NSUUID.UUID.UUIDString],
+			@kAudioAggregateDeviceIsPrivateKey: @YES,
+			@kAudioAggregateDeviceIsStackedKey: @NO,
+			@kAudioAggregateDeviceTapAutoStartKey: @YES,
+			@kAudioAggregateDeviceTapListKey: @[ @{
+				@kAudioSubTapUIDKey: (__bridge_transfer NSString *)tap_uid,
+				@kAudioSubTapDriftCompensationKey: @YES,
+			} ],
+		};
+		AudioObjectID device = kAudioObjectUnknown;
+		status = AudioHardwareCreateAggregateDevice((__bridge CFDictionaryRef)desc, &device);
+		if (status != noErr)
+			throw std::runtime_error(std::format("AudioHardwareCreateAggregateDevice failed: {}", status));
+		return device;
+	}
+}
+
+} // namespace wivrn::coreaudio
