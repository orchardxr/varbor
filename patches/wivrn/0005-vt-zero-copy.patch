index 05695359de77369f4c21581c656768d71dffa42f..495a2c71b1d48f89af69c479c7c186ce94967fae 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -116,6 +116,8 @@ if(APPLE)
     # Same Vulkan platform defines as Monado's: they change the layout of its struct vk_bundle
     add_compile_definitions(VK_USE_PLATFORM_METAL_EXT= VK_ENABLE_BETA_EXTENSIONS=)
     add_compile_options("$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include ${CMAKE_CURRENT_SOURCE_DIR}/common/utils/apple_compat.h>")
+    # foveation.comp writes one luma and one chroma image per stream (compositor.h)
+    set(WIVRN_GLSL_DEFINES -DWIVRN_ENCODE_IMAGE_PER_STREAM)
 endif()
 
 find_package(PkgConfig REQUIRED)
