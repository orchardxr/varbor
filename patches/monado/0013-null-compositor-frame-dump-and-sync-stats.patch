index 71c5ebf9e28d09ec86c0cada6a2e41ccb6e93ff3..9c3cc19a61f47444fb1497b2648be18a900bd2cb 100644
--- a/src/xrt/compositor/multi/comp_multi_compositor.c
+++ b/src/xrt/compositor/multi/comp_multi_compositor.c
@@ -289,6 +289,7 @@ run_func(void *ptr)
 		struct xrt_compositor_fence *xcf = mc->wait_thread.xcf;
 		struct xrt_compositor_semaphore *xcsem = mc->wait_thread.xcsem; // No need to ref, a move.
 		uint64_t value = mc->wait_thread.value;
+		int64_t commit_ns = mc->wait_thread.commit_ns;
 
 		// Ok to clear these on spurious wakeup as they are empty then anyways.
 		mc->wait_thread.frame_id = 0;
@@ -306,6 +307,7 @@ run_func(void *ptr)
 
 		os_thread_helper_unlock(&mc->wait_thread.oth);
 
+		bool waited_semaphore = xcsem != NULL;
 		if (xcsem != NULL) {
 			wait_semaphore(mc, &xcsem, value);
 		}
@@ -316,6 +318,13 @@ run_func(void *ptr)
 		// Sample time outside of lock.
 		int64_t now_ns = os_monotonic_get_ns();
 
+		if (comp_sync_stats_enabled()) {
+			comp_sync_stats_add(&mc->sync_stats,
+			                    waited_semaphore ? "server commit->client GPU done (semaphore)"
+			                                  : "server commit->client GPU done (fence)",
+			                    now_ns - commit_ns);
+		}
+
 		os_mutex_lock(&mc->msc->list_and_timing_lock);
 		u_pa_mark_gpu_done(mc->upa, frame_id, now_ns);
 		os_mutex_unlock(&mc->msc->list_and_timing_lock);
@@ -384,6 +393,7 @@ push_fence_to_wait_thread(struct multi_compositor *mc, int64_t frame_id, struct
 	assert(mc->wait_thread.xcf == NULL);
 
 	mc->wait_thread.frame_id = frame_id;
+	mc->wait_thread.commit_ns = os_monotonic_get_ns();
 	mc->wait_thread.xcf = xcf;
 
 	os_thread_helper_signal_locked(&mc->wait_thread.oth);
@@ -406,6 +416,7 @@ push_semaphore_to_wait_thread(struct multi_compositor *mc,
 	assert(mc->wait_thread.xcsem == NULL);
 
 	mc->wait_thread.frame_id = frame_id;
+	mc->wait_thread.commit_ns = os_monotonic_get_ns();
 	xrt_compositor_semaphore_reference(&mc->wait_thread.xcsem, xcsem);
 	mc->wait_thread.value = value;
 
