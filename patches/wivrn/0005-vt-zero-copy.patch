+bool video_encoder_vt::matches_readback(uint8_t slot)
+{
+	if (vk.device.waitForFences(*in[slot].fence, true, 1'000'000'000) == vk::Result::eTimeout)
+		return false;
+	auto pb = CVPixelBufferRef(in[slot].pixel_buffer);
+	const size_t row_bytes = size_t(extent.width) * bytes_per_sample;
+	bool same = CVPixelBufferGetWidth(pb) == extent.width and CVPixelBufferGetHeight(pb) == extent.height;
+	CVPixelBufferLockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+	for (size_t plane = 0; same and plane < 2; ++plane)
+	{
+		auto src = (const uint8_t *)(plane ? in[slot].chroma.map() : in[slot].luma.map());
+		auto dst = (const uint8_t *)CVPixelBufferGetBaseAddressOfPlane(pb, plane);
+		size_t bpr = CVPixelBufferGetBytesPerRowOfPlane(pb, plane);
+		for (size_t row = 0; same and row < CVPixelBufferGetHeightOfPlane(pb, plane); ++row)
+			same = std::memcmp(src + row * row_bytes, dst + row * bpr, row_bytes) == 0;
+	}
+	CVPixelBufferUnlockBaseAddress(pb, kCVPixelBufferLock_ReadOnly);
+	return same;
+}
