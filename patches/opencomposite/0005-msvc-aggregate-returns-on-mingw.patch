 	)
diff --git a/scripts/split_headers.py b/scripts/split_headers.py
index 7788a339d16e9c1088aa7166678da74bdb7465a6..f500963f308eddad88918d479d2cf805c3cf42f7 100644
--- a/scripts/split_headers.py
+++ b/scripts/split_headers.py
@@ -74,6 +74,12 @@ input_dir = Path(sys.argv[1])
 
 # output directory to place generated headers in
 output_dir = Path(sys.argv[2])
+
+# MSVC passes the hidden return pointer of a member function after 'this' and always returns user-defined types
+# through it; MinGW's Itanium ABI puts it before 'this' (and returns small structs in registers). Games are built
+# with MSVC, so for MinGW builds the struct-returning interface methods are declared in the MSVC form explicitly:
+#   virtual T *Name(T *_oc_ret, args...) = 0;
+msvc_aggregate_returns = "--msvc-aggregate-returns" in sys.argv[3:]
 output_dir.mkdir(exist_ok=True)
 
 # List of files we've already written, this prevents us from overwriting newer files
@@ -206,6 +212,9 @@ def write_interface(target: str, result: str, usingiface: bool, interface_checke
     else:
         result = result.replace("%%REPLACE%NS%START%%", "namespace vr")
 
+    if msvc_aggregate_returns and usingiface and not target.startswith("driver_"):
+        result = explicit_aggregate_returns(result)
+
     # Apply any manual patches
     if target in patches:
         result = patch(result, input_dir / f"patches/{target}.ipatch")
@@ -230,6 +239,30 @@ def write_interface(target: str, result: str, usingiface: bool, interface_checke
         outfile.write(result.encode())
 
 
+def collect_struct_names():
+    names = set()
+    for fn in input_dir.glob("openvr-*.h"):
+        text = fn.read_text(encoding="latin-1")
+        names.update(re.findall(r"^\s*struct\s+(\w+)\s*\{", text, re.M))
+        names.update(re.findall(r"^\s*typedef\s+struct\s*\w*\s*\{[^}]*\}\s*(\w+)\s*;", text, re.M))
+    return names
+
+
+struct_names = collect_struct_names() if msvc_aggregate_returns else set()
+virtual_decl = re.compile(r"virtual\s+(\w+)\s+(\w+)\s*\(([^;]*?)\)\s*=\s*0\s*;")
+
+
+def explicit_aggregate_returns(text):
+    def repl(m):
+        rtype, name, args = m.group(1), m.group(2), m.group(3).strip()
+        if rtype not in struct_names:
+            return m.group(0)
+        if args in ("", "void"):
+            return f"virtual {rtype} *{name}( {rtype} *_oc_ret ) = 0;"
+        return f"virtual {rtype} *{name}( {rtype} *_oc_ret, {args} ) = 0;"
+    return virtual_decl.sub(repl, text)
+
+
 def split_header(headerfile: TextIO, interface_checker: Callable = None,
                  out_dir: Path = output_dir / "interfaces", imports=None):
     """
