From: macvr
Subject: [PATCH] msvc-aggregate-returns-on-mingw

---
 CMakeLists.txt             |  2 +-
 scripts/split_headers.py   | 33 +++++++++++++++++++++++++++++++++
 scripts/stubs/codegen.py   | 25 ++++++++++++++++++++++---
 scripts/stubs/interface.py |  6 ++++++
 4 files changed, 62 insertions(+), 4 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3078f094997ea010337663404ac6b518617d9c6b..297cc638bf6cad82e3c4403a6df8af5b7e9000a9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -574,7 +574,7 @@ file(GLOB stub-deps CONFIGURE_DEPENDS LIST_DIRECTORIES false ${CMAKE_SOURCE_DIR}
 # Command for running header splitting script
 add_custom_command(
 	OUTPUT ${GENERATED_DIR}/interfaces/vrtypes.h
-	COMMAND ${Python_EXECUTABLE} ${CMAKE_SOURCE_DIR}/scripts/split_headers.py ${CMAKE_SOURCE_DIR}/OpenVRHeaders ${GENERATED_DIR}
+	COMMAND ${Python_EXECUTABLE} ${CMAKE_SOURCE_DIR}/scripts/split_headers.py ${CMAKE_SOURCE_DIR}/OpenVRHeaders ${GENERATED_DIR} $<$<BOOL:${MINGW}>:--msvc-aggregate-returns>
 	DEPENDS ${CMAKE_SOURCE_DIR}/scripts/split_headers.py ${openvr-headers}
