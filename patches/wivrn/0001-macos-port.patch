@@ -235,14 +252,46 @@ std::pair<wivrn::deserialization_packet, sockaddr_in6> wivrn::UDP::receive_from_
 	sockaddr_in6 addr;
 	socklen_t addrlen = sizeof(addr);
 
+#ifdef __APPLE__
+	// No MSG_TRUNC on recvfrom: SO_NREAD gives the size of the first datagram
+	int nread = 0;
+	socklen_t nread_len = sizeof(nread);
+	if (getsockopt(fd, SOL_SOCKET, SO_NREAD, &nread, &nread_len) < 0)
+		throw std::system_error{errno, std::generic_category()};
+	ssize_t peeked = nread > 0 ? nread : 65536;
+#else
 	ssize_t peeked = recvfrom(fd, nullptr, 0, MSG_PEEK | MSG_TRUNC, (sockaddr *)&addr, &addrlen);
 	if (peeked < 0)
 		throw std::system_error{errno, std::generic_category()};
+#endif
 
 	auto buffer = std::make_shared_for_overwrite<uint8_t[]>(peeked);
+#ifdef __APPLE__
+	// Darwin reports IPv4 peers of a dual-stack socket as AF_INET: map them back to ::ffff:a.b.c.d
+	sockaddr_storage storage{};
