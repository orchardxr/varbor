+#pragma once
+
+#include "xrt/xrt_defines.h"
+
+#include <cmath>
+
+namespace wivrn
+{
+
+// Heading (rotation about +Y) of an orientation, from its forward (-Z) axis.
+// Looking straight up/down the forward axis has no heading, so the swing-twist
+// twist about Y is used instead.
+inline float yaw_of(const xrt_quat & q)
+{
+	float fx = -2.f * (q.x * q.z + q.w * q.y);
+	float fz = -(1.f - 2.f * (q.x * q.x + q.y * q.y));
+	if (fx * fx + fz * fz > 1e-6f)
+		return std::atan2(-fx, -fz);
+	if (q.y * q.y + q.w * q.w > 1e-12f)
+		return 2.f * std::atan2(q.y, q.w);
+	return 0.f;
+}
+
+// New STAGE offset (pose of the stage in the root space) that puts the stage
+// origin under the head and aligns its -Z with the head's heading, keeping the
+// stage's floor height and gravity alignment.
+inline xrt_pose recentered_stage_offset(const xrt_pose & head_in_root, const xrt_pose & old_stage)
+{
+	float half = 0.5f * yaw_of(head_in_root.orientation);
+	xrt_pose out{};
+	out.orientation = {0.f, std::sin(half), 0.f, std::cos(half)};
+	out.position = {head_in_root.position.x, old_stage.position.y, head_in_root.position.z};
+	return out;
+}
+
+} // namespace wivrn
