From: macvr
Subject: [PATCH] macos-signals-kqueue

---
 server/main.cpp | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/server/main.cpp b/server/main.cpp
index c506974dcf91c368dd4259ff3737242f4cfe850c..4b9bca1fb373298676f51c7a736abadd75256e1d 100644
--- a/server/main.cpp
+++ b/server/main.cpp
@@ -86,6 +86,7 @@
 #include <util/u_file.h>
 
 #ifdef __APPLE__
+#include <sys/event.h>
 // from <mach-o/dyld.h>, which #undefs FALSE and breaks G_SOURCE_REMOVE
 extern "C" int _NSGetExecutablePath(char * buf, uint32_t * bufsize);
 #endif
@@ -1130,6 +1131,30 @@ int inner_main(int argc, char * argv[], bool show_instructions)
 	// Catch SIGINT & SIGTERM
 	g_unix_signal_add(SIGINT, &sigint, (void *)SIGINT);
 	g_unix_signal_add(SIGTERM, &sigint, (void *)SIGTERM);
+#ifdef __APPLE__
+	// The Monado server thread installs its own SIGINT/SIGTERM handlers, replacing glib's.
+	// kqueue still reports signals that a handler catches.
+	if (int kq = kqueue(); kq >= 0)
+	{
+		fcntl(kq, F_SETFD, FD_CLOEXEC);
+		struct kevent ev[2];
+		EV_SET(&ev[0], SIGINT, EVFILT_SIGNAL, EV_ADD, 0, 0, nullptr);
+		EV_SET(&ev[1], SIGTERM, EVFILT_SIGNAL, EV_ADD, 0, 0, nullptr);
+		kevent(kq, ev, 2, nullptr, 0, nullptr);
+		g_unix_fd_add(
+		        kq, G_IO_IN, [](int kq, GIOCondition, void *) -> gboolean {
+			        struct kevent ev;
+			        timespec zero{};
+			        while (kevent(kq, nullptr, 0, &ev, 1, &zero) > 0)
+			        {
+				        if (not quitting_main_loop)
+					        sigint((void *)uintptr_t(ev.ident));
+			        }
+			        return G_SOURCE_CONTINUE;
+		        },
+		        nullptr);
+	}
+#endif
 
 #ifdef __APPLE__
 	// No session bus: wivrnctl and the dashboard are not available
