diff --git a/src/xrt/compositor/util/comp_sync_stats.h b/src/xrt/compositor/util/comp_sync_stats.h
new file mode 100644
index 0000000000000000000000000000000000000000..668af9c4b37c64af1326906b2dcfca48f05c1d7c
--- /dev/null
+++ b/src/xrt/compositor/util/comp_sync_stats.h
@@ -0,0 +1,68 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Tiny latency statistics, printed every N samples when MONADO_SYNC_STATS=1.
+ * @ingroup comp_util
+ */
+
+#pragma once
+
+#include "util/u_debug.h"
+#include "util/u_logging.h"
+
+#include <stdlib.h>
+
+#define COMP_SYNC_STATS_N 100
+
+struct comp_sync_stats
+{
+	double ms[COMP_SYNC_STATS_N];
+	int count;
+	uint64_t total;
+};
+
+static inline bool
+comp_sync_stats_enabled(void)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		enabled = debug_string_to_bool(getenv("MONADO_SYNC_STATS")) ? 1 : 0;
+	}
+	return enabled == 1;
+}
+
+static inline int
+comp_sync_stats_cmp(const void *a, const void *b)
+{
+	double x = *(const double *)a, y = *(const double *)b;
+	return x < y ? -1 : x > y;
+}
+
+static inline void
+comp_sync_stats_flush(struct comp_sync_stats *st, const char *what)
+{
+	if (st->count == 0) {
+		return;
+	}
+	int n = st->count;
+	qsort(st->ms, n, sizeof(double), comp_sync_stats_cmp);
+	double sum = 0;
+	for (int i = 0; i < n; i++) {
+		sum += st->ms[i];
+	}
+	U_LOG_IFL_I(U_LOGGING_INFO, "sync-stats %s: n=%d median=%.3fms p90=%.3fms p99=%.3fms max=%.3fms mean=%.3fms (total %llu)", what, n,
+	        st->ms[n / 2], st->ms[(n * 9) / 10], st->ms[(n * 99) / 100], st->ms[n - 1], sum / n,
+	        (unsigned long long)st->total);
+	st->count = 0;
+}
+
+static inline void
+comp_sync_stats_add(struct comp_sync_stats *st, const char *what, int64_t ns)
+{
+	st->ms[st->count++] = (double)ns / 1e6;
+	st->total++;
+	if (st->count == COMP_SYNC_STATS_N) {
+		comp_sync_stats_flush(st, what);
+	}
+}
