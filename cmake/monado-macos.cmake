# Initial cache for standalone Monado builds on macOS: cmake -C cmake/monado-macos.cmake
# Mirrors the driver/feature set third_party/wivrn/server/CMakeLists.txt forces, but keeps
# the simulated driver and the null compositor for testing without WiVRn.
foreach(drv ARDUINO BLUBUR_S1 DAYDREAM EUROC HDK HYDRA NS OHMD OPENGLOVES PSMV PSSENSE PSVR PSVR2
            QWERTY REALSENSE REMOTE RIFT RIFT_S ROKID SIMULAVR STEAMVR_LIGHTHOUSE SOLARXR TWRAP UVC
            VF VIVE WMR XREAL_AIR)
	set(XRT_BUILD_DRIVER_${drv} OFF CACHE BOOL "")
endforeach()
set(XRT_BUILD_DRIVER_SIMULATED ON CACHE BOOL "")
set(XRT_BUILD_SAMPLES OFF CACHE BOOL "")

set(XRT_HAVE_OPENGL OFF CACHE BOOL "")
set(XRT_HAVE_OPENGLES OFF CACHE BOOL "")
set(XRT_HAVE_EGL OFF CACHE BOOL "")
set(XRT_HAVE_SDL2 OFF CACHE BOOL "")
set(XRT_HAVE_OPENCV OFF CACHE BOOL "")
set(XRT_HAVE_REALSENSE OFF CACHE BOOL "")
set(XRT_HAVE_JPEG OFF CACHE BOOL "")
set(XRT_HAVE_GST OFF CACHE BOOL "")
set(XRT_HAVE_BLUETOOTH OFF CACHE BOOL "")
set(XRT_HAVE_ONNXRUNTIME OFF CACHE BOOL "")
set(XRT_HAVE_SYSTEM_CJSON OFF CACHE BOOL "")

set(XRT_FEATURE_STEAMVR_PLUGIN OFF CACHE BOOL "")
set(XRT_FEATURE_SLAM OFF CACHE BOOL "")
set(XRT_FEATURE_WINDOW_PEEK OFF CACHE BOOL "")
set(XRT_MODULE_COMPOSITOR_NULL ON CACHE BOOL "")

set(BUILD_DOC OFF CACHE BOOL "")
set(BUILD_TESTING OFF CACHE BOOL "")
set(CMAKE_BUILD_TYPE RelWithDebInfo CACHE STRING "")
set(U_GIT_TAG_CPP "${CMAKE_CURRENT_LIST_DIR}/u_git_tag.c" CACHE FILEPATH "")
