+#include "video_encoder_vt.h"
+
+#include "encoder_settings.h"
+#include "os/os_time.h"
+#include "util/u_debug.h"
+#include "util/u_logging.h"
+#include "utils/wivrn_vk_bundle.h"
+
+#include <mvt.h>
+
+#include <algorithm>
+#include <format>
+#include <stdexcept>
+
+DEBUG_GET_ONCE_BOOL_OPTION(vt_log_timing, "WIVRN_VT_LOG_TIMING", false)
+
+namespace wivrn
+{
+
+namespace
+{
+uint32_t queue_family(wivrn::vk_bundle & vk)
+{
+	return vk.transfer_queue ? vk.transfer_queue.family_index : vk.queue.family_index;
+}
+
+vk::raii::CommandPool make_cmd_pool(wivrn::vk_bundle & vk, uint8_t stream_idx)
+{
+	auto res = vk.device.createCommandPool(vk::CommandPoolCreateInfo{
+	        .flags = vk::CommandPoolCreateFlagBits::eResetCommandBuffer | vk::CommandPoolCreateFlagBits::eTransient,
+	        .queueFamilyIndex = queue_family(vk),
+	});
+	vk.name(res, std::format("videotoolbox encoder {} command pool", stream_idx));
+	return res;
+}
+} // namespace
+
+video_encoder_vt::video_encoder_vt(wivrn::vk_bundle & vk, const encoder_settings & settings, uint8_t stream_idx) :
+        video_encoder(vk, stream_idx, queue_family(vk), settings, std::make_unique<default_idr_handler>(), true),
+        vk(vk),
+        cmd_pool(make_cmd_pool(vk, stream_idx)),
+        bytes_per_sample(settings.bit_depth == 10 ? 2 : 1)
+{
+	mvt_params p;
+	mvt_params_default(&p, settings.width, settings.height);
+	p.fps = settings.fps;
+	p.bitrate_bps = settings.bitrate;
+	p.ten_bit = settings.bit_depth == 10;
+	switch (settings.codec)
+	{
+		case video_codec::h265:
+			p.codec = MVT_CODEC_HEVC;
+			break;
+		case video_codec::h264:
+			p.codec = MVT_CODEC_H264;
+			if (p.ten_bit)
+				throw std::runtime_error("videotoolbox: 10-bit H.264 is not supported");
+			break;
+		default:
+			throw std::runtime_error("videotoolbox: unsupported codec");
+	}
+
+	stats_start = os_monotonic_get_ns();
+	int32_t status = 0;
+	enc = mvt_encoder_create(&p, &status);
+	if (not enc)
+		throw std::runtime_error(std::format("videotoolbox: cannot create {}x{} encoder (OSStatus {})", settings.width, settings.height, status));
+
+	auto command_buffers = vk.device.allocateCommandBuffers({
+	        .commandPool = *cmd_pool,
+	        .commandBufferCount = num_slots,
+	});
+
+	const vk::DeviceSize luma_size = vk::DeviceSize(extent.width) * extent.height * bytes_per_sample;
+	for (size_t i = 0; i < num_slots; ++i)
+	{
+		in[i].cmd = std::move(command_buffers[i]);
+		vk.name(in[i].cmd, std::format("videotoolbox {} transfer command buffer {}", stream_idx, i));
+		in[i].fence = vk::raii::Fence(vk.device, vk::FenceCreateInfo{.flags = vk::FenceCreateFlagBits::eSignaled});
+		in[i].luma = buffer_allocation(
+		        vk.device,
+		        {
+		                .size = luma_size,
+		                .usage = vk::BufferUsageFlagBits::eTransferDst,
+		        },
+		        {
+		                .flags = VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT,
+		                .usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST,
+		        },
+		        "videotoolbox luma buffer");
+		in[i].chroma = buffer_allocation(
+		        vk.device,
+		        {
+		                .size = luma_size / 2,
+		                .usage = vk::BufferUsageFlagBits::eTransferDst,
+		        },
+		        {
+		                .flags = VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT,
+		                .usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST,
+		        },
+		        "videotoolbox chroma buffer");
+	}
+	U_LOG_I("videotoolbox: stream %d %dx%d %s %d-bit %.1f Mbit/s",
+	        stream_idx,
+	        extent.width,
+	        extent.height,
+	        p.codec == MVT_CODEC_HEVC ? "HEVC" : "H.264",
+	        settings.bit_depth,
+	        settings.bitrate / 1e6);
+}
+
+void video_encoder_vt::log_stats(uint64_t duration_ns)
+{
+	if (stats.empty())
+		return;
+	uint64_t bytes = 0;
+	for (auto & s: stats)
+		bytes += s.bytes;
+	std::ranges::sort(stats, {}, &stat::encode_ms);
+	auto pct = [&](double p) { return stats[std::min(stats.size() - 1, size_t(p * stats.size()))].encode_ms; };
+	U_LOG_I("videotoolbox: stream %d: %zu frames in %.1f s (%.1f fps), %.1f Mbit/s, encode p50 %.2f p95 %.2f max %.2f ms",
+	        stream_idx,
+	        stats.size(),
+	        duration_ns / 1e9,
+	        stats.size() / (duration_ns / 1e9),
+	        bytes * 8 / (duration_ns / 1e9) / 1e6,
+	        pct(0.5),
+	        pct(0.95),
+	        stats.back().encode_ms);
+	stats.clear();
+}
+
+video_encoder_vt::~video_encoder_vt()
+{
+	for (auto & i: in)
+		(void)vk.device.waitForFences(*i.fence, true, 1'000'000'000);
+	if (enc)
+		mvt_encoder_destroy(enc);
+}
+
+void video_encoder_vt::present_image(vk::Image y_cbcr, vk::SemaphoreSubmitInfo compositor_sem, uint8_t slot, uint64_t)
+{
+	if (vk.device.waitForFences(*in[slot].fence, true, 1'000'000'000) == vk::Result::eTimeout)
+	{
+		U_LOG_E("videotoolbox: timeout on stream %d", stream_idx);
+		return;
+	}
+
+	auto & cmd = in[slot].cmd;
+	cmd.begin({.flags = vk::CommandBufferUsageFlagBits::eOneTimeSubmit});
+
+	if (need_transfer)
+	{
+		vk::ImageMemoryBarrier2 barrier{
+		        .dstStageMask = vk::PipelineStageFlagBits2KHR::eTransfer,
+		        .dstAccessMask = vk::AccessFlagBits2::eTransferRead,
+		        .srcQueueFamilyIndex = vk.queue.family_index,
+		        .dstQueueFamilyIndex = target_queue,
+		        .image = y_cbcr,
+		        .subresourceRange = {.aspectMask = vk::ImageAspectFlagBits::eColor,
+		                             .baseMipLevel = 0,
+		                             .levelCount = 1,
+		                             .baseArrayLayer = stream_idx,
+		                             .layerCount = 1},
+		};
+		cmd.pipelineBarrier2({
+		        .imageMemoryBarrierCount = 1,
+		        .pImageMemoryBarriers = &barrier,
+		});
+	}
+
+	// Either one multi-planar image, or (MoltenVK) a luma image and a chroma image.
+	// bufferRowLength is in texels of the plane format: R8/R16 for luma, RG8/RG16 for chroma
+	const bool planar = not cbcr_image;
+	cmd.copyImageToBuffer(
+	        y_cbcr,
+	        vk::ImageLayout::eGeneral,
+	        in[slot].luma,
+	        vk::BufferImageCopy{
+	                .bufferRowLength = extent.width,
+	                .imageSubresource = {
+	                        .aspectMask = planar ? vk::ImageAspectFlagBits::ePlane0 : vk::ImageAspectFlagBits::eColor,
+	                        .baseArrayLayer = stream_idx,
+	                        .layerCount = 1,
+	                },
+	                .imageExtent = {
+	                        .width = extent.width,
+	                        .height = extent.height,
+	                        .depth = 1,
+	                }});
+	cmd.copyImageToBuffer(
+	        planar ? y_cbcr : cbcr_image,
+	        vk::ImageLayout::eGeneral,
+	        in[slot].chroma,
+	        vk::BufferImageCopy{
+	                .bufferRowLength = extent.width / 2,
+	                .imageSubresource = {
+	                        .aspectMask = planar ? vk::ImageAspectFlagBits::ePlane1 : vk::ImageAspectFlagBits::eColor,
+	                        .baseArrayLayer = stream_idx,
+	                        .layerCount = 1,
+	                },
+	                .imageExtent = {
+	                        .width = extent.width / 2,
+	                        .height = extent.height / 2,
+	                        .depth = 1,
+	                }});
+
+	cmd.end();
+
+	auto & queue = vk.transfer_queue ? vk.transfer_queue : vk.queue;
+	std::unique_lock lock(queue.mutex);
+	vk::CommandBufferSubmitInfo cmd_info{
+	        .commandBuffer = *cmd,
+	};
+	compositor_sem.stageMask = vk::PipelineStageFlagBits2::eTransfer;
+
+	vk.device.resetFences(*in[slot].fence);
+	queue.queue.submit2(vk::SubmitInfo2{
+	                            .waitSemaphoreInfoCount = 1,
+	                            .pWaitSemaphoreInfos = &compositor_sem,
+	                            .commandBufferInfoCount = 1,
+	                            .pCommandBufferInfos = &cmd_info,
+	                    },
+	                    *in[slot].fence);
+}
+
+std::optional<video_encoder::data> video_encoder_vt::encode(uint8_t slot, uint64_t frame_index)
+{
+	if (auto bitrate = pending_bitrate.exchange(0))
+		mvt_set_bitrate(enc, bitrate, MVT_RATE_IMMEDIATE);
+	if (auto framerate = pending_framerate.exchange(0))
+		mvt_set_framerate(enc, framerate);
+
+	bool force_idr = static_cast<default_idr_handler &>(*idr).get_type(frame_index) == default_idr_handler::frame_type::i;
+
+	auto t0 = os_monotonic_get_ns();
+	if (vk.device.waitForFences(*in[slot].fence, true, 1'000'000'000) == vk::Result::eTimeout)
+	{
+		U_LOG_E("videotoolbox: timeout on stream %d", stream_idx);
+		return {};
+	}
+	auto t1 = os_monotonic_get_ns();
+
+	const size_t stride = size_t(extent.width) * bytes_per_sample;
+	mvt_frame f{};
+	int32_t err = mvt_encode_nv12_sync(enc,
+	                                   (const uint8_t *)in[slot].luma.map(),
+	                                   stride,
+	                                   (const uint8_t *)in[slot].chroma.map(),
+	                                   stride,
+	                                   t1,
+	                                   force_idr,
+	                                   &f);
+	if (err != 0 or f.status != 0 or f.size == 0)
+	{
+		U_LOG_W("videotoolbox: stream %d frame %ld encode failed (%d/%d)", stream_idx, frame_index, err, f.status);
+		return {};
+	}
+
+	auto t2 = os_monotonic_get_ns();
+	stats.push_back({.encode_ms = float((t2 - t1) / 1e6), .bytes = uint32_t(f.size)});
+	if (t2 - stats_start > 10'000'000'000)
+	{
+		log_stats(t2 - stats_start);
+		stats_start = t2;
+	}
+
+	if (debug_get_bool_option_vt_log_timing())
+	{
+		U_LOG_I("videotoolbox: stream %d frame %ld %s %zu bytes, readback wait %.2f ms, encode %.2f ms (VT %.2f ms)",
+		        stream_idx,
+		        frame_index,
+		        f.is_idr ? "IDR" : "P",
+		        f.size,
+		        (t1 - t0) / 1e6,
+		        (t2 - t1) / 1e6,
+		        f.encode_ns / 1e6);
+	}
+
+	return data{
+	        .encoder = this,
+	        .span = std::span<uint8_t>(const_cast<uint8_t *>(f.data), f.size),
+	        .mem = nullptr,
+	        .prefer_control = f.is_idr,
+	};
+}
+
+} // namespace wivrn
