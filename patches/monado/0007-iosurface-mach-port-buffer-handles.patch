 }
 
+#if !defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
 static void
 get_external_image_support(struct vk_bundle *vk,
                            bool depth,
@@ -200,6 +201,7 @@ get_external_image_support(struct vk_bundle *vk,
 	          : (enum xrt_swapchain_usage_bits)(XRT_SWAPCHAIN_USAGE_COLOR | XRT_SWAPCHAIN_USAGE_SAMPLED);
 	vk_csci_get_image_external_support(vk, image_format, bits, handle_type, out_importable, out_exportable);
 }
+#endif
 
 static bool
 is_fence_bit_supported(struct vk_bundle *vk, VkExternalFenceHandleTypeFlagBits handle_type)
@@ -1295,6 +1297,11 @@ vk_init_from_given(struct vk_bundle *vk,
 		vk->has_KHR_image_format_list = image_format_list_enabled;
 	}
 
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	// Required device extension for sharing images on this platform.
+	vk->has_EXT_metal_objects = true;
+#endif
+
 #ifdef VK_KHR_timeline_semaphore
 	/*
 	 * Has the timeline semaphore extension and feature been enabled?
diff --git a/src/xrt/auxiliary/vk/vk_compositor_flags.c b/src/xrt/auxiliary/vk/vk_compositor_flags.c
index 4ce0f9fcd36bca9076285e7ab0f61cd42e182af2..31194344fd054166707ed575fa1d193c78854248 100644
--- a/src/xrt/auxiliary/vk/vk_compositor_flags.c
+++ b/src/xrt/auxiliary/vk/vk_compositor_flags.c
@@ -71,6 +71,9 @@ vk_cb_get_buffer_external_handle_type(struct vk_bundle *vk)
 	return VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID;
 #elif defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_WIN32_HANDLE)
 	return VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+#elif defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	// Shared through IOSurfaces (VK_EXT_metal_objects), not external memory.
+	return 0;
 #else
 #error "need port"
 #endif
@@ -221,6 +224,8 @@ vk_csci_get_image_external_handle_type(struct vk_bundle *vk, struct xrt_image_na
 #elif defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_WIN32_HANDLE)
 	return (xin && xin->is_dxgi_handle) ? VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D11_TEXTURE_KMT_BIT
 	                                    : VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+#elif defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	return 0;
 #else
 #error "need port"
 #endif
@@ -234,6 +239,19 @@ vk_csci_get_image_external_support(struct vk_bundle *vk,
                                    bool *out_importable,
                                    bool *out_exportable)
 {
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	// IOSurface backed images have no external handle type to query.
+	if (handle_type == 0) {
+		if (out_importable) {
+			*out_importable = vk->has_EXT_metal_objects;
+		}
+		if (out_exportable) {
+			*out_exportable = vk->has_EXT_metal_objects;
+		}
+		return;
+	}
+#endif
+
 	VkImageUsageFlags image_usage = vk_csci_get_image_usage_flags(vk, image_format, bits);
 
 	// In->pNext
@@ -393,6 +411,17 @@ vk_csci_is_format_supported(struct vk_bundle *vk,
 	VkExternalMemoryHandleTypeFlags handle_type = vk_csci_get_image_external_handle_type(vk, NULL);
 	VkResult ret;
 
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	if (handle_type == 0) {
+		// Metal can't back depth/stencil textures with an IOSurface.
+		if ((xbits & XRT_SWAPCHAIN_USAGE_DEPTH_STENCIL) != 0) {
+			VK_DEBUG(vk, "Depth/stencil format '%s' can't be shared via IOSurface!", vk_format_string(format));
+			return false;
+		}
+		return vk->has_EXT_metal_objects;
+	}
+#endif
+
 	VkImageUsageFlags usage = vk_csci_get_image_usage_flags(vk, format, xbits);
 
 	// In->pNext
diff --git a/src/xrt/auxiliary/vk/vk_helpers.c b/src/xrt/auxiliary/vk/vk_helpers.c
index 023b8dd895740d950405374e132f35f0df6a856b..e7f2dba342db2e55f4924bb0cd2e903fc955692e 100644
--- a/src/xrt/auxiliary/vk/vk_helpers.c
+++ b/src/xrt/auxiliary/vk/vk_helpers.c
@@ -25,6 +25,11 @@
 #include "vk/vk_helpers.h"
 #include "vk/vk_compositor_flags.h"
 
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+#include <IOSurface/IOSurfaceRef.h>
+#include <mach/mach.h>
+#endif
+
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -438,10 +443,28 @@ vk_create_image_from_native(struct vk_bundle *vk,
 	}
 #endif
 
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	IOSurfaceRef surface = IOSurfaceLookupFromMachPort(image_native->handle);
+	if (surface == NULL) {
+		VK_ERROR(vk, "IOSurfaceLookupFromMachPort failed for port %u", image_native->handle);
+		return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+	}
+
+	// The image is backed by the IOSurface, no external memory involved.
+	VkImportMetalIOSurfaceInfoEXT import_iosurface_info = {
+	    .sType = VK_STRUCTURE_TYPE_IMPORT_METAL_IO_SURFACE_INFO_EXT,
+	    .pNext = external_memory_image_create_info.pNext,
+	    .ioSurface = surface,
+	};
+	void *image_next = &import_iosurface_info;
+#else
+	void *image_next = &external_memory_image_create_info;
+#endif
+
 	// In
 	VkImageCreateInfo vk_info = {
 	    .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
-	    .pNext = &external_memory_image_create_info,
+	    .pNext = image_next,
 	    .flags = image_create_flags,
 	    .imageType = VK_IMAGE_TYPE_2D,
 	    .format = image_format,
@@ -457,6 +480,10 @@ vk_create_image_from_native(struct vk_bundle *vk,
 
 	VkImage image = VK_NULL_HANDLE;
 	ret = vk->vkCreateImage(vk->device, &vk_info, NULL, &image);
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	// The image holds its own reference to the IOSurface.
+	CFRelease(surface);
+#endif
 	if (ret != VK_SUCCESS) {
 		VK_ERROR(vk, "vkCreateImage: %s", vk_result_string(ret));
 		// Nothing to cleanup
@@ -502,6 +529,8 @@ vk_create_image_from_native(struct vk_bundle *vk,
 	};
 
 	// TODO memoryTypeBits from VkMemoryWin32HandlePropertiesKHR
+#elif defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	// Nothing to import, the memory is only bound to the IOSurface backed image.
 #else
 #error "need port"
 #endif
@@ -543,7 +572,11 @@ vk_create_image_from_native(struct vk_bundle *vk,
 
 	VkMemoryDedicatedAllocateInfoKHR dedicated_memory_info = {
 	    .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO_KHR,
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	    .pNext = NULL,
+#else
 	    .pNext = &import_memory_info,
+#endif
 	    .image = image,
 	    .buffer = VK_NULL_HANDLE,
 	};
@@ -646,6 +679,48 @@ get_device_memory_handle(struct vk_bundle *vk, VkDeviceMemory device_memory, xrt
 
 	return ret;
 }
+#elif defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+
+static VkResult
+get_device_memory_handle(struct vk_bundle *vk, VkDeviceMemory device_memory, xrt_graphics_buffer_handle_t *out_handle)
+{
+	// Memory isn't shareable on its own, see vk_get_native_handle_from_image.
+	return VK_ERROR_FEATURE_NOT_PRESENT;
+}
+
+XRT_CHECK_RESULT VkResult
+vk_get_native_handle_from_image(struct vk_bundle *vk, VkImage image, xrt_graphics_buffer_handle_t *out_handle)
+{
+	if (vk->vkExportMetalObjectsEXT == NULL) {
+		return VK_ERROR_EXTENSION_NOT_PRESENT;
+	}
+
+	VkExportMetalIOSurfaceInfoEXT iosurface_info = {
+	    .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_IO_SURFACE_INFO_EXT,
+	    .image = image,
+	};
+	VkExportMetalObjectsInfoEXT export_info = {
+	    .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+	    .pNext = &iosurface_info,
+	};
+	vk->vkExportMetalObjectsEXT(vk->device, &export_info);
+
+	if (iosurface_info.ioSurface == NULL) {
+		VK_ERROR(vk, "vkExportMetalObjectsEXT: image has no IOSurface");
+		return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+	}
+
+	mach_port_t port = IOSurfaceCreateMachPort(iosurface_info.ioSurface);
+	if (!MACH_PORT_VALID(port)) {
+		VK_ERROR(vk, "IOSurfaceCreateMachPort failed");
+		return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+	}
+
+	*out_handle = port;
+
+	return VK_SUCCESS;
+}
+
 #else
 #error "Needs port"
 #endif
