#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform writeonly image2D img;
layout(push_constant) uniform PC { uint w; uint h; uint frame; } pc;
void main()
{
	uvec2 p = gl_GlobalInvocationID.xy;
	if (p.x >= pc.w || p.y >= pc.h)
		return;
	uint r = (p.x * 7u + pc.frame * 13u) & 255u;
	uint g = (p.y * 5u + pc.frame * 3u) & 255u;
	uint b = (p.x ^ p.y) & 255u;
	imageStore(img, ivec2(p), vec4(r, g, b, 255u) / 255.0);
}
