+// appid -> name from the app manifests of fully installed apps
+std::unordered_map<uint32_t, std::string> installed_steam_apps(const std::filesystem::path & root)
+{
+	std::unordered_map<uint32_t, std::string> res;
+	for (const auto & library: steam_libraries(root))
+	{
+		std::error_code ec;
+		for (const auto & entry: std::filesystem::directory_iterator(library / "steamapps", ec))
 		{
-			// Ignore errors
+			auto filename = entry.path().filename().string();
+			if (not filename.starts_with("appmanifest_") or not filename.ends_with(".acf"))
+				continue;
+			try
+			{
+				wivrn::vdf::root manifest(entry.path());
+				const auto & state = std::get<std::vector<wivrn::vdf::keyvalue>>(manifest.value);
+				uint32_t appid = std::stoul(vdf_value(state, "appid"));
+				auto flags = vdf_value(state, "StateFlags");
+				if (flags.empty() or not(std::stoul(flags) & 4)) // StateFullyInstalled
+					continue;
+				res.emplace(appid, vdf_value(state, "name"));
+			}
+			catch (std::exception &)
