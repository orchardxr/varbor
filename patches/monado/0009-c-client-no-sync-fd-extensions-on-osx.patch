From: macvr
Subject: [PATCH] c-client-no-sync-fd-extensions-on-osx

---
 src/xrt/compositor/client/comp_vk_glue.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/xrt/compositor/client/comp_vk_glue.c b/src/xrt/compositor/client/comp_vk_glue.c
index 163f17339d10feba662b78ee1606823ca2f20222..0d479f7173fbe1e7eb966169ea705e98b445062b 100644
--- a/src/xrt/compositor/client/comp_vk_glue.c
+++ b/src/xrt/compositor/client/comp_vk_glue.c
@@ -50,7 +50,11 @@ const char *xrt_gfx_vk_device_extensions = VK_KHR_DEDICATED_ALLOCATION_EXTENSION
 #endif
 
 // Platform version of "external_fence" and "external_semaphore"
-#if defined(XRT_GRAPHICS_SYNC_HANDLE_IS_FD)
+#if defined(XRT_GRAPHICS_SYNC_HANDLE_IS_FD) && defined(XRT_OS_OSX)
+    // Not supported by MoltenVK, they are optional and fall back to a CPU wait.
+    ;
+
+#elif defined(XRT_GRAPHICS_SYNC_HANDLE_IS_FD)
     " " VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME " " VK_KHR_EXTERNAL_FENCE_FD_EXTENSION_NAME;
 
 #elif defined(XRT_GRAPHICS_SYNC_HANDLE_IS_WIN32_HANDLE)
