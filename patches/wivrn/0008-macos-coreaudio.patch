+#include "audio_coreaudio.h"
+#include "coreaudio_tap.h"
+
+#include "driver/wivrn_session.h"
+#include "os/os_time.h"
+#include "util/u_logging.h"
+
+#include <AudioToolbox/AudioToolbox.h>
+#include <Block.h>
+#include <CoreAudio/HostTime.h>
+#include <atomic>
+#include <cmath>
+#include <condition_variable>
+#include <cstdlib>
+#include <dispatch/dispatch.h>
+#include <format>
+#include <libproc.h>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+namespace wivrn
+{
+
+namespace
+{
+enum class tap_mode
+{
+	automatic,
+	clients,
+	global,
+	pids,
+};
+
+constexpr OSStatus no_more_input = 'wnmd';
+
+AudioObjectID process_object(pid_t pid)
+{
+	AudioObjectPropertyAddress addr{kAudioHardwarePropertyTranslatePIDToProcessObject, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+	AudioObjectID obj = kAudioObjectUnknown;
+	UInt32 size = sizeof(obj);
+	if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, sizeof(pid), &pid, &size, &obj) != noErr)
+		return kAudioObjectUnknown;
+	return obj;
+}
+
+std::string process_label(pid_t pid)
+{
+	char name[2 * MAXCOMLEN + 1] = "";
+	proc_name(pid, name, sizeof(name));
+	return std::format("{} ({})", pid, name);
+}
+
+struct coreaudio_device : public audio_device
+{
+	to_headset::audio_stream_description desc;
+	wivrn_session & session;
+
+	tap_mode mode = tap_mode::automatic;
+	std::vector<pid_t> fixed_pids;
+	bool mono;
+
+	AudioObjectID tap = kAudioObjectUnknown;
+	AudioObjectID device = kAudioObjectUnknown;
+	AudioDeviceIOProcID io_proc = nullptr;
+	dispatch_queue_t queue;
+	AudioObjectPropertyListenerBlock format_listener = nullptr;
+
+	coreaudio::tap_target target;
+	std::string target_label;
+
+	// dispatch queue only
+	AudioConverterRef converter = nullptr;
+	AudioStreamBasicDescription in_format{};
+	std::vector<uint8_t> out_buffer;
+	std::atomic<bool> format_changed{true};
+	uint64_t last_callback_ns = 0;
+
+	struct
+	{
+		std::atomic<uint64_t> callbacks;
+		std::atomic<uint64_t> frames;
+		std::atomic<uint64_t> packets;
+		std::atomic<uint64_t> bytes;
+		std::atomic<uint64_t> send_errors;
+		std::atomic<double> sumsq;
+		std::atomic<float> peak;
+		std::atomic<int64_t> max_gap_ns;
+		std::atomic<int64_t> delay_sum_ns;
+		std::atomic<int64_t> max_delay_ns;
+	} stats{};
+
+	std::mutex mutex;
+	bool running = false;
+	std::jthread watcher;
+
+	void process_mic_data(wivrn::audio_data &&) override {}
+	void pause() override;
+	void resume() override;
+
+	coreaudio_device(const wivrn::from_headset::headset_info_packet & info, wivrn::wivrn_session & session);
+	~coreaudio_device();
+
+	coreaudio::tap_target compute_target(std::string & label);
+	void update_target();
+	void setup_converter();
+	void process(const AudioBufferList * in, const AudioTimeStamp * in_time);
+	void log_stats(double seconds);
+	void watch(std::stop_token);
+};
+
+coreaudio_device::coreaudio_device(const wivrn::from_headset::headset_info_packet & info, wivrn::wivrn_session & session) :
+        session(session)
+{
+	if (not info.speaker)
+		throw std::runtime_error("headset has no speaker");
+	desc.speaker = {
+	        .num_channels = info.speaker->num_channels,
+	        .sample_rate = info.speaker->sample_rate,
+	};
+	mono = desc.speaker->num_channels == 1;
+
+	if (const char * env = std::getenv("WIVRN_AUDIO_TAP"))
+	{
+		std::string_view v = env;
+		if (v == "clients")
+			mode = tap_mode::clients;
+		else if (v == "global")
+			mode = tap_mode::global;
+		else if (v.starts_with("pid:"))
+		{
+			mode = tap_mode::pids;
+			for (const char * p = env + 4; *p;)
+			{
+				char * end;
+				long pid = std::strtol(p, &end, 10);
+				if (end == p)
+					break;
+				fixed_pids.push_back(pid);
+				p = *end ? end + 1 : end;
+			}
+		}
+		else if (v != "auto")
+			U_LOG_W("WIVRN_AUDIO_TAP=%s not understood, using auto", env);
+	}
+
+	queue = dispatch_queue_create("wivrn.audio", DISPATCH_QUEUE_SERIAL);
+
+	target = compute_target(target_label);
+	tap = coreaudio::create_tap(target, mono);
+	try
+	{
+		device = coreaudio::create_tap_aggregate(tap);
+
+		AudioObjectPropertyAddress addr{kAudioDevicePropertyBufferFrameSize, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+		UInt32 frames = desc.speaker->sample_rate * 5 / 1000;
+		AudioObjectSetPropertyData(device, &addr, 0, nullptr, sizeof(frames), &frames);
+		UInt32 size = sizeof(frames);
+		AudioObjectGetPropertyData(device, &addr, 0, nullptr, &size, &frames);
+
+		format_listener = Block_copy(^(UInt32, const AudioObjectPropertyAddress *) {
+			format_changed = true;
+		});
+		addr = {kAudioTapPropertyFormat, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+		AudioObjectAddPropertyListenerBlock(tap, &addr, queue, format_listener);
+
+		OSStatus status = AudioDeviceCreateIOProcIDWithBlock(
+		        &io_proc, device, queue, ^(const AudioTimeStamp *, const AudioBufferList * in, const AudioTimeStamp * in_time, AudioBufferList *, const AudioTimeStamp *) {
+			        process(in, in_time);
+		        });
+		if (status != noErr)
+			throw std::runtime_error(std::format("AudioDeviceCreateIOProcIDWithBlock failed: {}", status));
+
+		U_LOG_I("CoreAudio speaker: process tap → %d ch %d Hz, %u frames per buffer",
+		        desc.speaker->num_channels,
+		        desc.speaker->sample_rate,
+		        frames);
+	}
+	catch (...)
+	{
+		if (format_listener)
+		{
+			AudioObjectPropertyAddress addr{kAudioTapPropertyFormat, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+			AudioObjectRemovePropertyListenerBlock(tap, &addr, queue, format_listener);
+			Block_release(format_listener);
+		}
+		if (device != kAudioObjectUnknown)
+			AudioHardwareDestroyAggregateDevice(device);
+		coreaudio::destroy_tap(tap);
+		dispatch_release(queue);
+		throw;
+	}
+}
+
+coreaudio_device::~coreaudio_device()
+{
+	pause();
+	AudioDeviceDestroyIOProcID(device, io_proc);
+	AudioObjectPropertyAddress addr{kAudioTapPropertyFormat, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+	AudioObjectRemovePropertyListenerBlock(tap, &addr, queue, format_listener);
+	AudioHardwareDestroyAggregateDevice(device);
+	coreaudio::destroy_tap(tap);
+	dispatch_sync(queue, ^{});
+	Block_release(format_listener);
+	if (converter)
+		AudioConverterDispose(converter);
+	dispatch_release(queue);
+	U_LOG_I("CoreAudio speaker: tap destroyed");
+}
+
+coreaudio::tap_target coreaudio_device::compute_target(std::string & label)
+{
+	coreaudio::tap_target t;
+	std::vector<pid_t> pids;
+	switch (mode)
+	{
+		case tap_mode::pids:
+			pids = fixed_pids;
+			break;
+		case tap_mode::automatic:
+		case tap_mode::clients:
+			if (running)
+				pids = session.client_pids();
+			break;
+		case tap_mode::global:
+			break;
+	}
+
+	label.clear();
+	for (pid_t pid: pids)
+	{
+		if (auto obj = process_object(pid); obj != kAudioObjectUnknown)
+		{
+			t.processes.push_back(obj);
+			label += (label.empty() ? "" : ", ") + process_label(pid);
+		}
+	}
+
+	if (not t.processes.empty() or mode == tap_mode::pids or mode == tap_mode::clients)
+	{
+		t.exclusive = false;
+		label = std::format("{}: {}", mode == tap_mode::pids ? "pids" : "clients", label.empty() ? "none" : label);
+		return t;
+	}
+
+	if (auto self = process_object(getpid()); self != kAudioObjectUnknown)
+		t.processes.push_back(self);
+	label = "global";
+	return t;
+}
+
+void coreaudio_device::update_target()
+{
+	std::string label;
+	auto t = compute_target(label);
+	if (t == target)
+		return;
+	try
+	{
+		coreaudio::set_tap_target(tap, t, mono);
+		target = std::move(t);
+		target_label = std::move(label);
+		U_LOG_I("CoreAudio speaker: tapping %s", target_label.c_str());
+	}
+	catch (std::exception & e)
+	{
+		U_LOG_W("CoreAudio speaker: %s", e.what());
+	}
+}
+
+void coreaudio_device::setup_converter()
+{
+	if (converter)
+	{
+		AudioConverterDispose(converter);
+		converter = nullptr;
+	}
+
+	AudioObjectPropertyAddress addr{kAudioTapPropertyFormat, kAudioObjectPropertyScopeGlobal, kAudioObjectPropertyElementMain};
+	UInt32 size = sizeof(in_format);
+	if (AudioObjectGetPropertyData(tap, &addr, 0, nullptr, &size, &in_format) != noErr)
+	{
+		U_LOG_W("CoreAudio speaker: failed to get the tap format");
+		return;
+	}
+
+	AudioStreamBasicDescription out{
+	        .mSampleRate = double(desc.speaker->sample_rate),
+	        .mFormatID = kAudioFormatLinearPCM,
+	        .mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked,
+	        .mBytesPerPacket = UInt32(2 * desc.speaker->num_channels),
+	        .mFramesPerPacket = 1,
+	        .mBytesPerFrame = UInt32(2 * desc.speaker->num_channels),
+	        .mChannelsPerFrame = desc.speaker->num_channels,
+	        .mBitsPerChannel = 16,
+	};
+	if (OSStatus status = AudioConverterNew(&in_format, &out, &converter); status != noErr)
+	{
+		U_LOG_W("CoreAudio speaker: AudioConverterNew failed: %d", status);
+		converter = nullptr;
+		return;
+	}
+	U_LOG_I("CoreAudio speaker: tap format %.0f Hz %u ch %u bit flags 0x%x",
+	        in_format.mSampleRate,
+	        in_format.mChannelsPerFrame,
+	        in_format.mBitsPerChannel,
+	        in_format.mFormatFlags);
+}
+
+void coreaudio_device::process(const AudioBufferList * in, const AudioTimeStamp * in_time)
+{
+	if (format_changed.exchange(false))
+		setup_converter();
+	if (not converter or in->mNumberBuffers != 1 or in_format.mBytesPerFrame == 0)
+		return;
+
+	uint64_t now = AudioConvertHostTimeToNanos(AudioGetCurrentHostTime());
+	if (last_callback_ns)
+	{
+		int64_t gap = now - last_callback_ns;
+		if (gap > stats.max_gap_ns)
+			stats.max_gap_ns = gap;
+	}
+	last_callback_ns = now;
+	if (in_time and (in_time->mFlags & kAudioTimeStampHostTimeValid))
+	{
+		int64_t delay = now - AudioConvertHostTimeToNanos(in_time->mHostTime);
+		stats.delay_sum_ns += delay;
+		if (delay > stats.max_delay_ns)
+			stats.max_delay_ns = delay;
+	}
+
+	const AudioBuffer & buf = in->mBuffers[0];
+	UInt32 frames = buf.mDataByteSize / in_format.mBytesPerFrame;
+	if (frames == 0)
+		return;
+
+	if (in_format.mFormatFlags & kAudioFormatFlagIsFloat and in_format.mBitsPerChannel == 32)
+	{
+		const float * f = (const float *)buf.mData;
+		double sum = 0;
+		float peak = 0;
+		for (size_t i = 0, n = frames * in_format.mChannelsPerFrame; i < n; ++i)
+		{
+			sum += f[i] * f[i];
+			peak = std::max(peak, std::abs(f[i]));
+		}
+		stats.sumsq = stats.sumsq + sum;
+		if (peak > stats.peak)
+			stats.peak = peak;
+	}
+	stats.callbacks++;
+	stats.frames += frames;
+
+	const size_t out_frame_size = 2 * desc.speaker->num_channels;
+	UInt32 out_frames = std::ceil(frames * desc.speaker->sample_rate / in_format.mSampleRate) + 16;
+	out_buffer.resize(out_frames * out_frame_size);
+	AudioBufferList out_list{
+	        .mNumberBuffers = 1,
+	        .mBuffers = {{
+	                .mNumberChannels = desc.speaker->num_channels,
+	                .mDataByteSize = UInt32(out_buffer.size()),
+	                .mData = out_buffer.data(),
+	        }},
+	};
+
+	struct input
+	{
+		const AudioBuffer * buf;
+		UInt32 frames;
+		bool consumed;
+	} state{&buf, frames, false};
+
+	OSStatus status = AudioConverterFillComplexBuffer(
+	        converter,
+	        [](AudioConverterRef, UInt32 * packets, AudioBufferList * data, AudioStreamPacketDescription **, void * user) -> OSStatus {
+		        auto s = (input *)user;
+		        if (s->consumed)
+		        {
+			        *packets = 0;
+			        return no_more_input;
+		        }
+		        s->consumed = true;
+		        *packets = s->frames;
+		        data->mBuffers[0] = *s->buf;
+		        return noErr;
+	        },
+	        &state,
+	        &out_frames,
+	        &out_list,
+	        nullptr);
+	if (status != noErr and status != no_more_input)
+	{
+		U_LOG_W("CoreAudio speaker: AudioConverterFillComplexBuffer failed: %d", status);
+		return;
+	}
+	if (out_frames == 0)
+		return;
+
+	try
+	{
+		session.send_control(audio_data{
+		        .timestamp = session.get_offset().to_headset(os_monotonic_get_ns()),
+		        .payload = std::span(out_buffer.data(), out_frames * out_frame_size),
+		});
+		stats.packets++;
+		stats.bytes += out_frames * out_frame_size;
+	}
+	catch (std::exception & e)
+	{
+		stats.send_errors++;
+		U_LOG_D("Failed to send audio data: %s", e.what());
+	}
+}
+
+void coreaudio_device::log_stats(double seconds)
+{
+	uint64_t callbacks = stats.callbacks.exchange(0);
+	uint64_t frames = stats.frames.exchange(0);
+	uint64_t packets = stats.packets.exchange(0);
+	uint64_t bytes = stats.bytes.exchange(0);
+	uint64_t errors = stats.send_errors.exchange(0);
+	double sumsq = stats.sumsq.exchange(0);
+	float peak = stats.peak.exchange(0);
+	int64_t max_gap = stats.max_gap_ns.exchange(0);
+	int64_t delay_sum = stats.delay_sum_ns.exchange(0);
+	int64_t max_delay = stats.max_delay_ns.exchange(0);
+
+	auto db = [](double v) { return v > 0 ? 20 * std::log10(v) : -120.; };
+	double samples = double(frames) * std::max<UInt32>(1, in_format.mChannelsPerFrame);
+	U_LOG_I("audio: %.1f packets/s %.1f kB/s %.0f frames/s, rms %.1f dBFS peak %.1f dBFS, capture>send mean %.1f max %.1f ms, callback gap max %.1f ms, send errors %llu, tap %s",
+	        packets / seconds,
+	        bytes / seconds / 1000,
+	        frames / seconds,
+	        db(samples ? std::sqrt(sumsq / samples) : 0),
+	        db(peak),
+	        callbacks ? delay_sum / 1e6 / callbacks : 0.,
+	        max_delay / 1e6,
+	        max_gap / 1e6,
+	        (unsigned long long)errors,
+	        target_label.c_str());
+}
+
+void coreaudio_device::watch(std::stop_token stop)
+{
+	std::mutex m;
+	std::condition_variable_any cv;
+	auto last_log = std::chrono::steady_clock::now();
+	std::unique_lock lock(m);
+	while (true)
+	{
+		cv.wait_for(lock, stop, std::chrono::milliseconds(500), [] { return false; });
+		if (stop.stop_requested())
+			return;
+		update_target();
+		auto now = std::chrono::steady_clock::now();
+		if (now - last_log >= std::chrono::seconds(10))
+		{
+			log_stats(std::chrono::duration<double>(now - last_log).count());
+			last_log = now;
+		}
+	}
+}
+
+void coreaudio_device::pause()
+{
+	std::lock_guard lock(mutex);
+	if (not running)
+		return;
+	watcher = std::jthread();
+	AudioDeviceStop(device, io_proc);
+	running = false;
+	U_LOG_I("CoreAudio speaker: stopped, Mac output restored");
+}
+
+void coreaudio_device::resume()
+{
+	session.send_control(to_headset::audio_stream_description{desc});
+	session.send_control(to_headset::feature_control{to_headset::feature_control::microphone, false});
+
+	std::lock_guard lock(mutex);
+	if (running)
+		return;
+	running = true;
+	update_target();
+	if (OSStatus status = AudioDeviceStart(device, io_proc); status != noErr)
+	{
+		U_LOG_W("CoreAudio speaker: AudioDeviceStart failed: %d", status);
+		running = false;
+		return;
+	}
+	U_LOG_I("CoreAudio speaker: started, tapping %s (muted on the Mac)", target_label.c_str());
+	watcher = std::jthread([this](std::stop_token stop) { watch(stop); });
+}
+} // namespace
+
+std::unique_ptr<audio_device> create_coreaudio_handle(
+        const wivrn::from_headset::headset_info_packet & info,
+        wivrn_session & session)
+{
+	if (const char * env = std::getenv("WIVRN_AUDIO_TAP"); env and std::string_view(env) == "off")
+		return nullptr;
+	try
+	{
+		return std::make_unique<coreaudio_device>(info, session);
+	}
+	catch (std::exception & e)
+	{
+		U_LOG_W("CoreAudio backend creation failed: %s", e.what());
+		return nullptr;
+	}
+}
+} // namespace wivrn
