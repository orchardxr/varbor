+
+namespace wivrn::coreaudio
+{
+
+struct tap_target
+{
+	// exclusive: tap every process except these
+	bool exclusive = true;
+	std::vector<AudioObjectID> processes;
+
+	bool operator==(const tap_target &) const = default;
+};
+
+// Private process tap, muted on the Mac while it is read. Throws std::runtime_error.
+AudioObjectID create_tap(const tap_target &, bool mono);
+void set_tap_target(AudioObjectID tap, const tap_target &, bool mono);
+void destroy_tap(AudioObjectID tap);
+
+// Private aggregate device whose only input is the tap
+AudioObjectID create_tap_aggregate(AudioObjectID tap);
+
+} // namespace wivrn::coreaudio
