From: macvr
Subject: [PATCH] ARM64EC build: scalar fallbacks for SSE/x87/bsf code, import libs from the build dir, MinGW 10+ header duplicates

---
 meson.build                   | 2 ++
 src/d3d10/d3d10_interfaces.h  | 2 +-
 src/d3d9/d3d9_device.cpp      | 2 +-
 src/d3d9/d3d9_include.h       | 2 ++
 src/util/config/config.cpp    | 1 +
 src/util/sync/sync_spinlock.h | 4 ++++
 src/util/util_bit.h           | 8 ++++++--
 src/util/util_vector.h        | 5 +++++
 8 files changed, 22 insertions(+), 4 deletions(-)

diff --git a/meson.build b/meson.build
index 248efdb0c98e4c4d3b828608da71a34133867c7f..b796fc7a3ee52ca4d17b297dc8310e3da7bdb06a 100644
--- a/meson.build
+++ b/meson.build
@@ -58,6 +58,8 @@ dxvk_include_path = include_directories('./include')
 
 if (cpu_family == 'x86_64')
   dxvk_library_path = meson.source_root() + '/lib'
+elif (cpu_family == 'aarch64')
+  dxvk_library_path = meson.build_root() + '/implib'
 else
   dxvk_library_path = meson.source_root() + '/lib32'
 endif
diff --git a/src/d3d10/d3d10_interfaces.h b/src/d3d10/d3d10_interfaces.h
index aa028ab575cf21aec9864293c2a6eb60d33565a9..923a092bbd7ad7b230fef82a8c4adcb59c5ab5f3 100644
--- a/src/d3d10/d3d10_interfaces.h
+++ b/src/d3d10/d3d10_interfaces.h
@@ -4,6 +4,6 @@
 
 #ifdef _MSC_VER
 struct __declspec(uuid("0803425a-57f5-4dd6-9465-a87570834a08")) ID3D10StateBlock;
-#else
+#elif __MINGW64_VERSION_MAJOR < 10
 __CRT_UUID_DECL(ID3D10StateBlock, 0x0803425a,0x57f5,0x4dd6,0x94,0x65,0xa8,0x75,0x70,0x83,0x4a,0x08);
 #endif
diff --git a/src/d3d9/d3d9_device.cpp b/src/d3d9/d3d9_device.cpp
index 23b0a6fd5c7e9cab4cee18fc6289d078bff4b925..603621b5c51ee6180a057837cc6ea95bfece8c6b 100644
--- a/src/d3d9/d3d9_device.cpp
+++ b/src/d3d9/d3d9_device.cpp
@@ -4860,7 +4860,7 @@ namespace dxvk {
 
     // Round to nearest
     _controlfp(_RC_NEAR, _MCW_RC);
-#elif (defined(__GNUC__) || defined(__MINGW32__)) && (defined(__i386__) || defined(__x86_64__) || defined(__ia64))
+#elif (defined(__GNUC__) || defined(__MINGW32__)) && (defined(__i386__) || defined(__x86_64__) || defined(__ia64)) && !defined(__arm64ec__)
     // For GCC/MinGW we can use inline asm to set it.
     // This only works for x86 and x64 processors however.
 
diff --git a/src/d3d9/d3d9_include.h b/src/d3d9/d3d9_include.h
index 8762265abb7838a0e9a7cfc9e236fa20c13df4a1..1486d61f3f4b1a52bb013926fbceccf3919d8045 100644
--- a/src/d3d9/d3d9_include.h
+++ b/src/d3d9/d3d9_include.h
@@ -79,10 +79,12 @@
 
 // MinGW headers are broken. Who'dve guessed?
 #ifndef _MSC_VER
+#if __MINGW64_VERSION_MAJOR < 10
 typedef struct _D3DDEVINFO_RESOURCEMANAGER
 {
   char dummy;
 } D3DDEVINFO_RESOURCEMANAGER, * LPD3DDEVINFO_RESOURCEMANAGER;
+#endif
 
 #ifndef __WINE__
 extern "C" WINUSERAPI WINBOOL WINAPI SetProcessDPIAware(VOID);
diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index 1da49ab8aa0a19a90690d0714324f2826b5b6d18..348263572b2e3795562bd336fd418a50c79844d1 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -1,3 +1,4 @@
+#include <algorithm>
 #include <array>
 #include <fstream>
 #include <sstream>
diff --git a/src/util/sync/sync_spinlock.h b/src/util/sync/sync_spinlock.h
index 27157929f92a6bf8977631757d05cf3e18e21d2e..e9c0fd7228ff0e714843c487b77853548034422a 100644
--- a/src/util/sync/sync_spinlock.h
+++ b/src/util/sync/sync_spinlock.h
@@ -21,7 +21,11 @@ namespace dxvk::sync {
   void spin(uint32_t spinCount, const Fn& fn) {
     while (unlikely(!fn())) {
       for (uint32_t i = 1; i < spinCount; i++) {
+#if defined(__arm64ec__)
+        __asm__ __volatile__("yield");
+#else
         _mm_pause();
+#endif
         if (fn())
           return;
       }
diff --git a/src/util/util_bit.h b/src/util/util_bit.h
index 7682ace86add6be33a8519e3e1ae2990f827421b..e8c61f580be25b579bde3cbb51ce79f27bb2b262 100644
--- a/src/util/util_bit.h
+++ b/src/util/util_bit.h
@@ -1,6 +1,8 @@
 #pragma once
 
-#ifndef _MSC_VER
+#if defined(__arm64ec__)
+#include <arm_neon.h>
+#elif !defined(_MSC_VER)
 #if defined(__WINE__) && defined(__clang__)
 #pragma push_macro("_WIN32")
 #undef _WIN32
@@ -55,6 +57,8 @@ namespace dxvk::bit {
     return _tzcnt_u32(n);
     #elif defined(__BMI__)
     return __tzcnt_u32(n);
+    #elif defined(__arm64ec__)
+    return n != 0 ? __builtin_ctz(n) : 32;
     #elif defined(__GNUC__) || defined(__clang__)
     uint32_t res;
     uint32_t tmp;
@@ -144,7 +148,7 @@ namespace dxvk::bit {
   template<typename T>
   bool bcmpeq(const T* a, const T* b) {
     static_assert(alignof(T) >= 16);
-    #if defined(__GNUC__) || defined(__clang__) || defined(_MSC_VER)
+    #if (defined(__GNUC__) || defined(__clang__) || defined(_MSC_VER)) && !defined(__arm64ec__)
     auto ai = reinterpret_cast<const __m128i*>(a);
     auto bi = reinterpret_cast<const __m128i*>(b);
 
diff --git a/src/util/util_vector.h b/src/util/util_vector.h
index 77cdf2942b010e55d3a2f41b757cce29a4c88261..48dfe278189257f1923de61ac564633552240810 100644
--- a/src/util/util_vector.h
+++ b/src/util/util_vector.h
@@ -151,10 +151,15 @@ namespace dxvk {
 
   inline Vector4 replaceNaN(Vector4 a) {
     Vector4 result;
+#if defined(__arm64ec__)
+    for (uint32_t i = 0; i < 4; i++)
+      result.data[i] = a.data[i] == a.data[i] ? a.data[i] : 0.0f;
+#else
     __m128 value = _mm_load_ps(a.data);
     __m128 mask  = _mm_cmpeq_ps(value, value);
            value = _mm_and_ps(value, mask);
     _mm_store_ps(result.data, value);
+#endif
     return result;
   }
 
