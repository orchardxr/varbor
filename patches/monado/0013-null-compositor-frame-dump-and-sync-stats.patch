diff --git a/src/xrt/compositor/null/null_compositor.c b/src/xrt/compositor/null/null_compositor.c
index 19e5025c77ad648a02bc804dfc9d8757da261fc4..e86f3d8c741487443be4916c2c4962bda2d543fc 100644
--- a/src/xrt/compositor/null/null_compositor.c
+++ b/src/xrt/compositor/null/null_compositor.c
@@ -33,6 +33,7 @@
 #include "xrt/xrt_device.h"
 
 
+#include <inttypes.h>
 #include <stdint.h>
 #include <stdio.h>
 
@@ -43,6 +44,110 @@ static const uint64_t MAX_VIEW_WIDTH = 1920;
 static const uint64_t MAX_VIEW_HEIGHT = 1080;
 
 DEBUG_GET_ONCE_LOG_OPTION(log, "XRT_COMPOSITOR_LOG", U_LOGGING_INFO)
+DEBUG_GET_ONCE_OPTION(dump_path, "XRT_COMPOSITOR_NULL_DUMP", NULL)
+DEBUG_GET_ONCE_NUM_OPTION(dump_frame, "XRT_COMPOSITOR_NULL_DUMP_FRAME", 60)
+
+
+/*
+ *
+ * Frame dump, reads the views of the first projection layer straight from
+ * their IOSurfaces and writes them side by side as a PNG.
+ *
+ */
+
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+#include "util/comp_swapchain.h"
+
+#include <IOSurface/IOSurfaceRef.h>
+
+#define STB_IMAGE_WRITE_STATIC
+#define STB_IMAGE_WRITE_IMPLEMENTATION
+#include "stb_image_write.h"
+
+static void
+dump_frame(struct null_compositor *c, const char *path)
+{
+	struct comp_layer *layer = NULL;
+	for (uint32_t i = 0; i < c->base.layer_accum.layer_count && layer == NULL; i++) {
+		if (c->base.layer_accum.layers[i].data.type == XRT_LAYER_PROJECTION ||
+		    c->base.layer_accum.layers[i].data.type == XRT_LAYER_PROJECTION_DEPTH) {
+			layer = &c->base.layer_accum.layers[i];
+		}
+	}
+	if (layer == NULL) {
+		NULL_WARN(c, "Frame dump: no projection layer in frame %" PRIu64, c->commit_count);
+		return;
+	}
+
+	uint32_t view_count = layer->data.view_count < 2 ? layer->data.view_count : 2;
+	IOSurfaceRef surfaces[2] = {NULL, NULL};
+	uint32_t out_w = 0;
+	uint32_t out_h = 0;
+	for (uint32_t v = 0; v < view_count; v++) {
+		struct xrt_swapchain *xsc = comp_layer_get_swapchain(layer, v);
+		uint32_t index = layer->data.proj.v[v].sub.image_index;
+		if (xsc == NULL || index >= comp_swapchain(xsc)->vkic.image_count) {
+			continue;
+		}
+		surfaces[v] = (IOSurfaceRef)comp_swapchain(xsc)->vkic.images[index].iosurface;
+		if (surfaces[v] == NULL) {
+			continue;
+		}
+		out_w += (uint32_t)IOSurfaceGetWidth(surfaces[v]);
+		uint32_t h = (uint32_t)IOSurfaceGetHeight(surfaces[v]);
+		out_h = h > out_h ? h : out_h;
+	}
+	if (out_w == 0 || out_h == 0) {
+		NULL_WARN(c, "Frame dump: projection views are not IOSurface backed");
+		return;
+	}
+
+	uint8_t *rgba = U_TYPED_ARRAY_CALLOC(uint8_t, (size_t)out_w * out_h * 4);
+	uint32_t x0 = 0;
+	for (uint32_t v = 0; v < view_count; v++) {
+		IOSurfaceRef s = surfaces[v];
+		if (s == NULL) {
+			continue;
+		}
+		uint32_t pf = IOSurfaceGetPixelFormat(s);
+		uint32_t w = (uint32_t)IOSurfaceGetWidth(s);
+		uint32_t h = (uint32_t)IOSurfaceGetHeight(s);
+		size_t bpr = IOSurfaceGetBytesPerRow(s);
+
+		IOSurfaceLock(s, kIOSurfaceLockReadOnly, NULL);
+		const uint8_t *base = IOSurfaceGetBaseAddress(s);
+		for (uint32_t y = 0; y < h; y++) {
+			for (uint32_t x = 0; x < w; x++) {
+				uint8_t *dst = rgba + ((size_t)y * out_w + x0 + x) * 4;
+				if (pf == 'BGRA' || pf == 'RGBA') {
+					const uint8_t *src = base + y * bpr + x * 4;
+					bool bgra = pf == 'BGRA';
+					dst[0] = src[bgra ? 2 : 0];
+					dst[1] = src[1];
+					dst[2] = src[bgra ? 0 : 2];
+					dst[3] = 255;
+				} else {
+					// Only 8 bit formats are converted, mark others magenta.
+					dst[0] = 255, dst[1] = 0, dst[2] = 255, dst[3] = 255;
+				}
+			}
+		}
+		IOSurfaceUnlock(s, kIOSurfaceLockReadOnly, NULL);
+
+		char fourcc[5] = {(char)(pf >> 24), (char)(pf >> 16), (char)(pf >> 8), (char)pf, 0};
+		NULL_INFO(c, "Frame dump: view %u is %ux%u IOSurface '%s' bpr %zu image %u", v, w, h, fourcc, bpr,
+		          layer->data.proj.v[v].sub.image_index);
+		x0 += w;
+	}
+
+	if (stbi_write_png(path, (int)out_w, (int)out_h, 4, rgba, (int)out_w * 4) != 0) {
+		NULL_INFO(c, "Frame dump: wrote frame %" PRIu64 " (%ux%u) to %s", c->commit_count, out_w, out_h, path);
+	} else {
+		NULL_ERROR(c, "Frame dump: could not write %s", path);
+	}
+	free(rgba);
+}
+#endif
 
 
 /*
@@ -512,6 +617,14 @@ null_compositor_layer_commit(struct xrt_compositor *xc, xrt_graphics_sync_handle
 	// can just unref the sync handle. Otherwise please use it.
 	u_graphics_sync_unref(&sync_handle);
 
+	c->commit_count++;
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+	const char *dump_path = debug_get_option_dump_path();
+	if (dump_path != NULL && c->commit_count == (uint64_t)debug_get_num_option_dump_frame()) {
+		dump_frame(c, dump_path);
+	}
+#endif
+
 	/*
 	 * Time keeping needed to keep the pacer happy.
 	 */
@@ -544,6 +657,7 @@ null_compositor_destroy(struct xrt_compositor *xc)
 	struct vk_bundle *vk = get_vk(c);
 
 	NULL_DEBUG(c, "NULL_COMP_DESTROY");
+	NULL_INFO(c, "Null compositor: %" PRIu64 " layer commits", c->commit_count);
 
 	// Make sure we don't have anything to destroy.
 	comp_swapchain_shared_garbage_collect(&c->base.cscs);
