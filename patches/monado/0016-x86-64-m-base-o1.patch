From: macvr
Subject: [PATCH] x86-64-m-base-o1

---
 src/xrt/auxiliary/math/CMakeLists.txt | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/xrt/auxiliary/math/CMakeLists.txt b/src/xrt/auxiliary/math/CMakeLists.txt
index ac66cf689c0f8465e77ef25f7ebe2a230e90d0d5..d25d78ea7d42c2e5ffd03fc7bd5adf6a8ec8bcfb 100644
--- a/src/xrt/auxiliary/math/CMakeLists.txt
+++ b/src/xrt/auxiliary/math/CMakeLists.txt
@@ -3,6 +3,11 @@
 
 xrt_optimized_math_flags()
 
+# Apple clang 2100.1 (Xcode 26.6) segfaults on m_base.cpp for x86_64 at -O2 and above
+if(APPLE AND CMAKE_OSX_ARCHITECTURES STREQUAL "x86_64")
+	set_source_files_properties(m_base.cpp PROPERTIES COMPILE_OPTIONS "-O1")
+endif()
+
 add_library(
 	aux_math STATIC
 	m_api.h
