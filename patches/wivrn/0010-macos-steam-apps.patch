+#ifdef __APPLE__
+// Any image ImageIO reads (Steam's JPEG artwork), letterboxed into a square PNG
+std::vector<wivrn::icon> try_load_imageio(const std::vector<std::byte> & data)
+{
+	auto cf = [](auto ref) { return std::unique_ptr<std::remove_pointer_t<decltype(ref)>, decltype(&CFRelease)>(ref, &CFRelease); };
+
+	auto bytes = cf(CFDataCreateWithBytesNoCopy(nullptr, reinterpret_cast<const UInt8 *>(data.data()), data.size(), kCFAllocatorNull));
+	auto source = cf(CGImageSourceCreateWithData(bytes.get(), nullptr));
+	if (not source)
+		throw std::runtime_error("");
+	auto image = cf(CGImageSourceCreateImageAtIndex(source.get(), 0, nullptr));
+	if (not image)
+		throw std::runtime_error("");
+
+	double w = CGImageGetWidth(image.get());
+	double h = CGImageGetHeight(image.get());
+	int size = std::min(512., std::max(w, h));
+	double scale = size / std::max(w, h);
+
+	auto colorspace = cf(CGColorSpaceCreateWithName(kCGColorSpaceSRGB));
+	auto context = cf(CGBitmapContextCreate(nullptr, size, size, 8, 0, colorspace.get(), kCGImageAlphaPremultipliedLast));
+	if (not context)
+		throw std::runtime_error("");
+	CGContextSetInterpolationQuality(context.get(), kCGInterpolationHigh);
+	CGContextDrawImage(context.get(), CGRectMake((size - w * scale) / 2, (size - h * scale) / 2, w * scale, h * scale), image.get());
+	auto square = cf(CGBitmapContextCreateImage(context.get()));
+
+	auto png = cf(CFDataCreateMutable(nullptr, 0));
+	auto destination = cf(CGImageDestinationCreateWithData(png.get(), CFSTR("public.png"), 1, nullptr));
+	if (not destination)
+		throw std::runtime_error("");
+	CGImageDestinationAddImage(destination.get(), square.get(), nullptr);
+	if (not CGImageDestinationFinalize(destination.get()))
+		throw std::runtime_error("");
+
+	auto begin = reinterpret_cast<const std::byte *>(CFDataGetBytePtr(png.get()));
+	return {{size, size, 32, std::vector<std::byte>(begin, begin + CFDataGetLength(png.get()))}};
+}
+#endif
+
 std::unordered_map<std::filesystem::path, std::vector<wivrn::icon>> icon_cache;
 
 } // namespace
@@ -596,5 +641,14 @@ const std::vector<wivrn::icon> & wivrn::load_icon(const std::filesystem::path &
 	catch (...)
 	{}
 
+#ifdef __APPLE__
+	try
+	{
+		return icon_cache.emplace(filename, try_load_imageio(data)).first->second;
+	}
+	catch (...)
+	{}
+#endif
+
 	throw std::runtime_error{"Cannot load icon: " + filename.native()};
 }
