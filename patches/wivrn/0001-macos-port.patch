+
+#pragma once
+
+#include <dns_sd.h>
+#include <map>
+#include <string>
+
+namespace wivrn
+{
+
+// Publishes a DNS-SD service through mDNSResponder (macOS replacement for avahi_publisher).
+// The registration socket is serviced by the default GLib main context.
+class bonjour_publisher
+{
+	DNSServiceRef service{};
+	unsigned int watch = 0;
+
+	static void register_callback(DNSServiceRef, DNSServiceFlags, DNSServiceErrorType, const char * name, const char * type, const char * domain, void *);
+
+public:
+	// An empty name uses the computer name, Bonjour renames on conflicts.
+	bonjour_publisher(const std::string & name, const std::string & type, int port, const std::map<std::string, std::string> & txt = {});
+	bonjour_publisher(const bonjour_publisher &) = delete;
+	bonjour_publisher & operator=(const bonjour_publisher &) = delete;
+	~bonjour_publisher();
+};
+} // namespace wivrn
