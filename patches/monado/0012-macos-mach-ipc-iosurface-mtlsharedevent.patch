new file mode 100644
index 0000000000000000000000000000000000000000..0cf5f38e0f19e05a88bb2d13927f2104887614d1
--- /dev/null
+++ b/src/xrt/ipc/shared/ipc_mach_apple.c
@@ -0,0 +1,681 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Mach port side channel next to the IPC unix socket on macOS.
+ * @ingroup ipc_shared
+ */
+
+#include "util/u_logging.h"
+#include "util/u_time.h"
+#include "os/os_time.h"
+
+#include "shared/ipc_mach_apple.h"
+#include "shared/ipc_message_channel.h"
+
+#include <mach/mach.h>
+#include <servers/bootstrap.h>
+
+#include <errno.h>
+#include <limits.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+extern kern_return_t
+bootstrap_register2(mach_port_t bp, name_t service_name, mach_port_t sp, uint64_t flags);
+
+#define MACH_IPC_MAGIC 0x4d56524dU // 'MVRM'
+#define MACH_IPC_VERSION 1
+
+#define MSG_ID_HELLO 0x4d560001
+#define MSG_ID_HELLO_ACK 0x4d560002
+#define MSG_ID_PORTS 0x4d560003
+#define MSG_ID_QUIT 0x4d560004
+
+#define PAIR_TIMEOUT_MS 5000
+#define PORTS_TIMEOUT_MS 5000
+#define SEND_TIMEOUT_MS 2000
+#define PENDING_MAX 32
+#define PENDING_EXPIRY_NS (10LL * 1000 * 1000 * 1000)
+
+//! Written by the client as the very first bytes on the socket.
+struct socket_hello
+{
+	uint32_t magic;
+	uint32_t version;
+	uint64_t nonce;
+};
+
+struct hello_msg
+{
+	mach_msg_header_t header;
+	uint32_t version;
+	int32_t pid;
+	uint64_t nonce;
+};
+
+struct hello_ack_msg
+{
+	mach_msg_header_t header;
+	mach_msg_body_t body;
+	mach_msg_port_descriptor_t port;
+	uint64_t nonce;
+};
+
+struct ports_msg
+{
+	mach_msg_header_t header;
+	mach_msg_body_t body;
+	mach_msg_ool_ports_descriptor_t ports;
+	uint32_t seq;
+	uint32_t count;
+};
+
+union rcv_buf {
+	mach_msg_header_t header;
+	struct
+	{
+		struct hello_msg m;
+		mach_msg_max_trailer_t t;
+	} hello;
+	struct
+	{
+		struct hello_ack_msg m;
+		mach_msg_max_trailer_t t;
+	} ack;
+	struct
+	{
+		struct ports_msg m;
+		mach_msg_max_trailer_t t;
+	} ports;
+	uint8_t raw[512];
+};
+
+
+/*
+ *
+ * Helpers.
+ *
+ */
+
+static mach_port_t
+make_receive_port(void)
+{
+	mach_port_t port = MACH_PORT_NULL;
+	if (mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &port) != KERN_SUCCESS) {
+		return MACH_PORT_NULL;
+	}
+	return port;
+}
+
+static void
+destroy_receive_port(mach_port_t *port)
+{
+	if (MACH_PORT_VALID(*port)) {
+		mach_port_mod_refs(mach_task_self(), *port, MACH_PORT_RIGHT_RECEIVE, -1);
+	}
+	*port = MACH_PORT_NULL;
+}
+
+static void
+release_send_right(mach_port_t *port)
+{
+	if (MACH_PORT_VALID(*port)) {
+		mach_port_deallocate(mach_task_self(), *port);
+	}
+	*port = MACH_PORT_NULL;
+}
+
+static uint32_t
+fnv1a32(const char *s)
+{
+	uint32_t h = 2166136261u;
+	for (; *s != '\0'; s++) {
+		h ^= (uint8_t)*s;
+		h *= 16777619u;
+	}
+	return h;
+}
+
+int
+ipc_mach_service_name(const char *socket_path, char *out_name, size_t size)
+{
+	const char *env = getenv("XRT_IPC_MACH_SERVICE");
+	if (env != NULL && env[0] != '\0') {
+		return snprintf(out_name, size, "%s", env);
+	}
+
+	char resolved[PATH_MAX];
+	const char *path = realpath(socket_path, resolved) != NULL ? resolved : socket_path;
+
+	const char *base = strrchr(path, '/');
+	base = base != NULL ? base + 1 : path;
+
+	char clean[64];
+	size_t n = 0;
+	for (; base[n] != '\0' && n < sizeof(clean) - 1; n++) {
+		char c = base[n];
+		bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' ||
+		          c == '-';
+		clean[n] = ok ? c : '_';
+	}
+	clean[n] = '\0';
+
+	return snprintf(out_name, size, "org.macvr.monado.%u.%s.%08x", (unsigned)getuid(), clean, fnv1a32(path));
+}
+
+
+/*
+ *
+ * Server.
+ *
+ */
+
+struct pending_hello
+{
+	uint64_t nonce;
+	mach_port_t reply_port;
+	int32_t pid;
+	int64_t time_ns;
+};
+
+static struct
+{
+	bool running;
+	mach_port_t service;
+	char name[128];
+	pthread_t thread;
+	pthread_mutex_t mutex;
+	pthread_cond_t cond;
+	struct pending_hello pending[PENDING_MAX];
+} g_srv = {
+    .mutex = PTHREAD_MUTEX_INITIALIZER,
+    .cond = PTHREAD_COND_INITIALIZER,
+};
+
+static void
+pending_drop_locked(struct pending_hello *p)
+{
+	release_send_right(&p->reply_port);
+	p->nonce = 0;
+}
+
+static void
+pending_expire_locked(int64_t now_ns)
+{
+	for (int i = 0; i < PENDING_MAX; i++) {
+		struct pending_hello *p = &g_srv.pending[i];
+		if (MACH_PORT_VALID(p->reply_port) && now_ns - p->time_ns > PENDING_EXPIRY_NS) {
+			U_LOG_W("Mach IPC: dropping unpaired HELLO from pid %d", p->pid);
+			pending_drop_locked(p);
+		}
+	}
+}
+
+static void
+pending_add(uint64_t nonce, mach_port_t reply_port, int32_t pid)
+{
+	int64_t now_ns = os_monotonic_get_ns();
+
+	pthread_mutex_lock(&g_srv.mutex);
+	pending_expire_locked(now_ns);
+
+	struct pending_hello *slot = NULL;
+	for (int i = 0; i < PENDING_MAX && slot == NULL; i++) {
+		if (!MACH_PORT_VALID(g_srv.pending[i].reply_port)) {
+			slot = &g_srv.pending[i];
+		}
+	}
+	if (slot == NULL) {
+		U_LOG_E("Mach IPC: too many unpaired clients, dropping HELLO from pid %d", pid);
+		mach_port_deallocate(mach_task_self(), reply_port);
+	} else {
+		*slot = (struct pending_hello){nonce, reply_port, pid, now_ns};
+	}
+
+	pthread_cond_broadcast(&g_srv.cond);
+	pthread_mutex_unlock(&g_srv.mutex);
+}
+
+static void *
+server_thread(void *ptr)
+{
+	(void)ptr;
+
+	while (true) {
+		union rcv_buf r;
+		kern_return_t kr = mach_msg(&r.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, sizeof(r), g_srv.service,
+		                            1000, MACH_PORT_NULL);
+		if (kr == MACH_RCV_TIMED_OUT) {
+			pthread_mutex_lock(&g_srv.mutex);
+			pending_expire_locked(os_monotonic_get_ns());
+			pthread_mutex_unlock(&g_srv.mutex);
+			continue;
+		}
+		if (kr != KERN_SUCCESS) {
+			U_LOG_E("Mach IPC: receive on service port failed: 0x%x", kr);
+			break;
+		}
+
+		if (r.header.msgh_id == MSG_ID_QUIT) {
+			break;
+		}
+
+		mach_port_t reply = r.header.msgh_remote_port;
+		bool ok = r.header.msgh_id == MSG_ID_HELLO &&                           //
+		          (r.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) == 0 &&            //
+		          r.header.msgh_size >= sizeof(struct hello_msg) &&                //
+		          r.hello.m.version == MACH_IPC_VERSION &&                        //
+		          MACH_PORT_VALID(reply);                                         //
+		if (!ok) {
+			U_LOG_W("Mach IPC: ignoring unexpected message id 0x%x on service port", r.header.msgh_id);
+			mach_msg_destroy(&r.header);
+			continue;
+		}
+
+		U_LOG_D("Mach IPC: HELLO from pid %d", r.hello.m.pid);
+		pending_add(r.hello.m.nonce, reply, r.hello.m.pid);
+	}
+
+	return NULL;
+}
+
+xrt_result_t
+ipc_mach_server_start(const char *socket_path)
+{
+	if (g_srv.running) {
+		return XRT_SUCCESS;
+	}
+
+	ipc_mach_service_name(socket_path, g_srv.name, sizeof(g_srv.name));
+
+	mach_port_t service = MACH_PORT_NULL;
+	const char *api = "bootstrap_check_in";
+	kern_return_t kr = bootstrap_check_in(bootstrap_port, g_srv.name, &service);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_D("Mach IPC: bootstrap_check_in(%s): %d %s, trying bootstrap_register2", g_srv.name, kr,
+		        bootstrap_strerror(kr));
+		service = make_receive_port();
+		mach_port_insert_right(mach_task_self(), service, service, MACH_MSG_TYPE_MAKE_SEND);
+		kr = bootstrap_register2(bootstrap_port, g_srv.name, service, 0);
+		// The bootstrap server holds its own send right now.
+		mach_port_deallocate(mach_task_self(), service);
+		api = "bootstrap_register2";
+	}
+	if (kr != KERN_SUCCESS) {
+		U_LOG_E("Mach IPC: could not register %s: %d %s. Is another service running?", g_srv.name, kr,
+		        bootstrap_strerror(kr));
+		destroy_receive_port(&service);
+		return XRT_ERROR_IPC_SERVICE_ALREADY_RUNNING;
+	}
+
+	g_srv.service = service;
+	g_srv.running = true;
+	if (pthread_create(&g_srv.thread, NULL, server_thread, NULL) != 0) {
+		g_srv.running = false;
+		destroy_receive_port(&g_srv.service);
+		return XRT_ERROR_THREADING_INIT_FAILURE;
+	}
+
+	U_LOG_IFL_I(U_LOGGING_INFO, "Mach IPC: registered %s via %s", g_srv.name, api);
+	return XRT_SUCCESS;
+}
+
+void
+ipc_mach_server_stop(void)
+{
+	if (!g_srv.running) {
+		return;
+	}
+
+	mach_msg_header_t quit = {
+	    .msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_MAKE_SEND, 0),
+	    .msgh_size = sizeof(quit),
+	    .msgh_remote_port = g_srv.service,
+	    .msgh_id = MSG_ID_QUIT,
+	};
+	mach_msg(&quit, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(quit), 0, MACH_PORT_NULL, SEND_TIMEOUT_MS,
+	         MACH_PORT_NULL);
+	pthread_join(g_srv.thread, NULL);
+
+	pthread_mutex_lock(&g_srv.mutex);
+	for (int i = 0; i < PENDING_MAX; i++) {
+		pending_drop_locked(&g_srv.pending[i]);
+	}
+	pthread_mutex_unlock(&g_srv.mutex);
+
+	destroy_receive_port(&g_srv.service);
+	g_srv.running = false;
+}
+
+static bool
+read_socket_hello(int fd, struct socket_hello *out)
+{
+	uint8_t *dst = (uint8_t *)out;
+	size_t got = 0;
+	int64_t deadline = os_monotonic_get_ns() + (int64_t)PAIR_TIMEOUT_MS * U_TIME_1MS_IN_NS;
+
+	while (got < sizeof(*out)) {
+		int64_t left_ms = (deadline - os_monotonic_get_ns()) / U_TIME_1MS_IN_NS;
+		if (left_ms <= 0) {
+			return false;
+		}
+		struct pollfd pfd = {.fd = fd, .events = POLLIN};
+		int ret = poll(&pfd, 1, (int)left_ms);
+		if (ret < 0 && errno == EINTR) {
+			continue;
+		}
+		if (ret <= 0) {
+			return false;
+		}
+		ssize_t n = recv(fd, dst + got, sizeof(*out) - got, 0);
+		if (n <= 0) {
+			return false;
+		}
+		got += (size_t)n;
+	}
+	return true;
+}
+
+xrt_result_t
+ipc_mach_server_accept(struct ipc_message_channel *imc)
+{
+	if (!g_srv.running) {
+		U_LOG_E("Mach IPC: service not running, can't pair client");
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct socket_hello sh = {0};
+	if (!read_socket_hello(imc->ipc_handle, &sh)) {
+		U_LOG_E("Mach IPC: client sent no hello on the socket");
+		return XRT_ERROR_IPC_FAILURE;
+	}
+	if (sh.magic != MACH_IPC_MAGIC || sh.version != MACH_IPC_VERSION) {
+		U_LOG_E("Mach IPC: bad socket hello (magic 0x%08x version %u), client without Mach side channel?",
+		        sh.magic, sh.version);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	// Wait for the matching HELLO on the service port.
+	mach_port_t reply = MACH_PORT_NULL;
+	int32_t pid = 0;
+	struct timespec deadline;
+	clock_gettime(CLOCK_REALTIME, &deadline);
+	deadline.tv_sec += PAIR_TIMEOUT_MS / 1000;
+
+	pthread_mutex_lock(&g_srv.mutex);
+	while (true) {
+		for (int i = 0; i < PENDING_MAX; i++) {
+			struct pending_hello *p = &g_srv.pending[i];
+			if (MACH_PORT_VALID(p->reply_port) && p->nonce == sh.nonce) {
+				reply = p->reply_port;
+				pid = p->pid;
+				p->reply_port = MACH_PORT_NULL;
+				p->nonce = 0;
+				break;
+			}
+		}
+		if (MACH_PORT_VALID(reply) || pthread_cond_timedwait(&g_srv.cond, &g_srv.mutex, &deadline) != 0) {
+			break;
+		}
+	}
+	pthread_mutex_unlock(&g_srv.mutex);
+
+	if (!MACH_PORT_VALID(reply)) {
+		U_LOG_E("Mach IPC: no HELLO for nonce %016llx on %s", (unsigned long long)sh.nonce, g_srv.name);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	mach_port_t local = make_receive_port();
+	if (!MACH_PORT_VALID(local)) {
+		mach_port_deallocate(mach_task_self(), reply);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct hello_ack_msg ack = {0};
+	ack.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0) | MACH_MSGH_BITS_COMPLEX;
+	ack.header.msgh_size = sizeof(ack);
+	ack.header.msgh_remote_port = reply;
+	ack.header.msgh_id = MSG_ID_HELLO_ACK;
+	ack.body.msgh_descriptor_count = 1;
+	ack.port.name = local;
+	ack.port.disposition = MACH_MSG_TYPE_MAKE_SEND;
+	ack.port.type = MACH_MSG_PORT_DESCRIPTOR;
+	ack.nonce = sh.nonce;
+
+	kern_return_t kr = mach_msg(&ack.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(ack), 0, MACH_PORT_NULL,
+	                            SEND_TIMEOUT_MS, MACH_PORT_NULL);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_E("Mach IPC: HELLO_ACK to pid %d failed: 0x%x", pid, kr);
+		destroy_receive_port(&local);
+		mach_port_deallocate(mach_task_self(), reply);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	imc->mach_local = local;
+	imc->mach_remote = reply;
+	imc->mach_send_seq = 0;
+	imc->mach_recv_seq = 0;
+
+	U_LOG_D("Mach IPC: paired client pid %d", pid);
+	return XRT_SUCCESS;
+}
+
+
+/*
+ *
+ * Client.
+ *
+ */
+
+xrt_result_t
+ipc_mach_client_connect(struct ipc_message_channel *imc, const char *socket_path)
+{
+	char name[128];
+	ipc_mach_service_name(socket_path, name, sizeof(name));
+
+	mach_port_t service = MACH_PORT_NULL;
+	kern_return_t kr = bootstrap_look_up(bootstrap_port, name, &service);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_IFL_E(imc->log_level,
+		            "Mach IPC: bootstrap_look_up(%s): %d %s. The service must run in the same login session.",
+		            name, kr, bootstrap_strerror(kr));
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	mach_port_t local = make_receive_port();
+	if (!MACH_PORT_VALID(local)) {
+		mach_port_deallocate(mach_task_self(), service);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	uint64_t nonce = ((uint64_t)arc4random() << 32) | arc4random();
+
+	struct hello_msg hello = {0};
+	hello.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, MACH_MSG_TYPE_MAKE_SEND);
+	hello.header.msgh_size = sizeof(hello);
+	hello.header.msgh_remote_port = service;
+	hello.header.msgh_local_port = local;
+	hello.header.msgh_id = MSG_ID_HELLO;
+	hello.version = MACH_IPC_VERSION;
+	hello.pid = getpid();
+	hello.nonce = nonce;
+
+	kr = mach_msg(&hello.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(hello), 0, MACH_PORT_NULL,
+	              SEND_TIMEOUT_MS, MACH_PORT_NULL);
+	mach_port_deallocate(mach_task_self(), service);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: HELLO to %s failed: 0x%x", name, kr);
+		destroy_receive_port(&local);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct socket_hello sh = {MACH_IPC_MAGIC, MACH_IPC_VERSION, nonce};
+	if (send(imc->ipc_handle, &sh, sizeof(sh), 0) != (ssize_t)sizeof(sh)) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: socket hello failed: %s", strerror(errno));
+		destroy_receive_port(&local);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	union rcv_buf r;
+	kr = mach_msg(&r.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, sizeof(r), local, PAIR_TIMEOUT_MS, MACH_PORT_NULL);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: no HELLO_ACK from %s: 0x%x", name, kr);
+		destroy_receive_port(&local);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	bool ok = r.header.msgh_id == MSG_ID_HELLO_ACK &&                  //
+	          (r.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) != 0 &&    //
+	          r.ack.m.body.msgh_descriptor_count == 1 &&               //
+	          r.ack.m.port.type == MACH_MSG_PORT_DESCRIPTOR &&         //
+	          r.ack.m.nonce == nonce;                                  //
+	if (!ok) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: bad HELLO_ACK (id 0x%x)", r.header.msgh_id);
+		mach_msg_destroy(&r.header);
+		destroy_receive_port(&local);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	imc->mach_local = local;
+	imc->mach_remote = r.ack.m.port.name;
+	imc->mach_send_seq = 0;
+	imc->mach_recv_seq = 0;
+
+	U_LOG_IFL_D(imc->log_level, "Mach IPC: connected to %s", name);
+	return XRT_SUCCESS;
+}
+
+
+/*
+ *
+ * Channel.
+ *
+ */
+
+xrt_result_t
+ipc_mach_send_ports(struct ipc_message_channel *imc, const mach_port_t *ports, uint32_t count)
+{
+	if (!MACH_PORT_VALID(imc->mach_remote)) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: no side channel to send %u ports on", count);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	struct ports_msg m = {0};
+	m.header.msgh_bits = MACH_MSGH_BITS(MACH_MSG_TYPE_COPY_SEND, 0) | MACH_MSGH_BITS_COMPLEX;
+	m.header.msgh_size = sizeof(m);
+	m.header.msgh_remote_port = imc->mach_remote;
+	m.header.msgh_id = MSG_ID_PORTS;
+	m.body.msgh_descriptor_count = 1;
+	m.ports.address = count > 0 ? (void *)ports : NULL;
+	m.ports.count = count;
+	m.ports.deallocate = false;
+	m.ports.copy = MACH_MSG_PHYSICAL_COPY;
+	m.ports.disposition = MACH_MSG_TYPE_COPY_SEND;
+	m.ports.type = MACH_MSG_OOL_PORTS_DESCRIPTOR;
+	m.seq = imc->mach_send_seq;
+	m.count = count;
+
+	kern_return_t kr = mach_msg(&m.header, MACH_SEND_MSG | MACH_SEND_TIMEOUT, sizeof(m), 0, MACH_PORT_NULL,
+	                            SEND_TIMEOUT_MS, MACH_PORT_NULL);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: sending %u ports failed: 0x%x", count, kr);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	imc->mach_send_seq++;
+	return XRT_SUCCESS;
+}
+
+xrt_result_t
+ipc_mach_receive_ports(struct ipc_message_channel *imc, mach_port_t *out_ports, uint32_t max_count)
+{
+	for (uint32_t i = 0; i < max_count; i++) {
+		out_ports[i] = MACH_PORT_NULL;
+	}
+
+	if (!MACH_PORT_VALID(imc->mach_local)) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: no side channel to receive ports on");
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	union rcv_buf r;
+	kern_return_t kr = mach_msg(&r.header, MACH_RCV_MSG | MACH_RCV_TIMEOUT, 0, sizeof(r), imc->mach_local,
+	                            PORTS_TIMEOUT_MS, MACH_PORT_NULL);
+	if (kr != KERN_SUCCESS) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: receiving ports failed: 0x%x", kr);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	bool ok = r.header.msgh_id == MSG_ID_PORTS &&                              //
+	          (r.header.msgh_bits & MACH_MSGH_BITS_COMPLEX) != 0 &&            //
+	          r.ports.m.body.msgh_descriptor_count == 1 &&                     //
+	          r.ports.m.ports.type == MACH_MSG_OOL_PORTS_DESCRIPTOR;           //
+	if (!ok) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: unexpected message id 0x%x", r.header.msgh_id);
+		mach_msg_destroy(&r.header);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+
+	mach_port_t *ports = (mach_port_t *)r.ports.m.ports.address;
+	uint32_t count = r.ports.m.ports.count;
+	uint32_t seq = r.ports.m.seq;
+
+	for (uint32_t i = 0; i < count; i++) {
+		if (i < max_count && seq == imc->mach_recv_seq) {
+			out_ports[i] = ports[i];
+		} else if (MACH_PORT_VALID(ports[i])) {
+			mach_port_deallocate(mach_task_self(), ports[i]);
+		}
+	}
+	if (ports != NULL && count > 0) {
+		vm_deallocate(mach_task_self(), (vm_address_t)ports, count * sizeof(mach_port_t));
+	}
+
+	if (seq != imc->mach_recv_seq) {
+		U_LOG_IFL_E(imc->log_level, "Mach IPC: out of order ports message %u, expected %u", seq,
+		            imc->mach_recv_seq);
+		return XRT_ERROR_IPC_FAILURE;
+	}
+	if (count > max_count) {
+		U_LOG_IFL_W(imc->log_level, "Mach IPC: got %u ports, expected at most %u", count, max_count);
+	}
+
+	imc->mach_recv_seq++;
+	return XRT_SUCCESS;
+}
+
+static uint32_t
+task_port_count(void)
+{
+	mach_port_name_array_t names = NULL;
+	mach_port_type_array_t types = NULL;
+	mach_msg_type_number_t n_names = 0;
+	mach_msg_type_number_t n_types = 0;
+	if (mach_port_names(mach_task_self(), &names, &n_names, &types, &n_types) != KERN_SUCCESS) {
+		return 0;
+	}
+	vm_deallocate(mach_task_self(), (vm_address_t)names, n_names * sizeof(*names));
+	vm_deallocate(mach_task_self(), (vm_address_t)types, n_types * sizeof(*types));
+	return n_names;
+}
+
+void
+ipc_mach_channel_close(struct ipc_message_channel *imc)
+{
+	bool had_channel = MACH_PORT_VALID(imc->mach_local) || MACH_PORT_VALID(imc->mach_remote);
+
+	// Destroying the receive right also destroys any rights still queued on it.
+	destroy_receive_port(&imc->mach_local);
+	release_send_right(&imc->mach_remote);
+
+	if (had_channel) {
+		U_LOG_IFL_D(imc->log_level, "Mach IPC: channel closed, task has %u port names", task_port_count());
+	}
+}
diff --git a/src/xrt/ipc/shared/ipc_mach_apple.h b/src/xrt/ipc/shared/ipc_mach_apple.h
new file mode 100644
index 0000000000000000000000000000000000000000..7cf0112e509f3dbd51258a01adf9e7028d17fc51
--- /dev/null
+++ b/src/xrt/ipc/shared/ipc_mach_apple.h
@@ -0,0 +1,81 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Mach port side channel next to the IPC unix socket on macOS.
+ *
+ * SCM_RIGHTS can't carry Mach ports, so IOSurface and MTLSharedEvent ports
+ * travel as OOL port descriptors over a per-connection Mach channel. The server
+ * checks in a per-user bootstrap service derived from the socket path, the
+ * client sends it a HELLO with a random nonce and also writes the nonce as the
+ * first bytes on the socket, which pairs the two.
+ *
+ * @ingroup ipc_shared
+ */
+
+#pragma once
+
+#include "xrt/xrt_results.h"
+
+#include <mach/port.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ipc_message_channel;
+
+/*!
+ * Bootstrap service name for the IPC socket at @p socket_path:
+ * `org.macvr.monado.<uid>.<socket basename>.<fnv1a32 of realpath>`, or the value
+ * of `XRT_IPC_MACH_SERVICE` if set.
+ */
+int
+ipc_mach_service_name(const char *socket_path, char *out_name, size_t size);
+
+/*!
+ * Server: check in the bootstrap service for @p socket_path and start the
+ * thread that collects client HELLOs. Without it no graphics handles can be sent.
+ */
+xrt_result_t
+ipc_mach_server_start(const char *socket_path);
+
+void
+ipc_mach_server_stop(void);
+
+/*!
+ * Server: read the client's nonce from the socket, pair it with its HELLO and
+ * hand the client its per-connection receive port.
+ */
+xrt_result_t
+ipc_mach_server_accept(struct ipc_message_channel *imc);
+
+/*!
+ * Client: connect the Mach side channel, must be done right after the socket
+ * has connected and before any other message.
+ */
+xrt_result_t
+ipc_mach_client_connect(struct ipc_message_channel *imc, const char *socket_path);
+
+/*!
+ * Send @p count ports (rights are copied, the caller keeps its own). Exactly one
+ * Mach message goes with each socket message that carries handles.
+ */
+xrt_result_t
+ipc_mach_send_ports(struct ipc_message_channel *imc, const mach_port_t *ports, uint32_t count);
+
+/*!
+ * Receive the ports for the socket message just read. The caller owns the send
+ * rights, unused slots are set to MACH_PORT_NULL.
+ */
+xrt_result_t
+ipc_mach_receive_ports(struct ipc_message_channel *imc, mach_port_t *out_ports, uint32_t max_count);
+
+void
+ipc_mach_channel_close(struct ipc_message_channel *imc);
+
+#ifdef __cplusplus
+}
+#endif
