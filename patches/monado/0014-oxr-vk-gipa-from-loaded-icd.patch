 	uint32_t prop_count = 0;
 	VkResult ret = VK_SUCCESS;
 
@@ -143,7 +143,7 @@ oxr_session_populate_vk(struct oxr_logger *log,
 	struct xrt_compositor_vk *xcvk = xrt_gfx_vk_provider_create( //
 	    xcn,                                                     //
 	    next->instance,                                          //
-	    vkGetInstanceProcAddr,                                   //
+	    oxr_vk_get_instance_proc_addr(),                         //
 	    next->physicalDevice,                                    //
 	    next->device,                                            //
 	    external_fence_fd_enabled,                               //
diff --git a/src/xrt/state_trackers/oxr/oxr_vulkan.c b/src/xrt/state_trackers/oxr/oxr_vulkan.c
index e631812683001beb9f65b46b59396e658ddda443..6c9840eae3d05fc8ae5b3aaf944330fde0a6be11 100644
--- a/src/xrt/state_trackers/oxr/oxr_vulkan.c
+++ b/src/xrt/state_trackers/oxr/oxr_vulkan.c
@@ -13,6 +13,12 @@
 #include <string.h>
 #include <stdlib.h>
 
+#include "xrt/xrt_config_os.h"
+
+#ifdef XRT_OS_OSX
+#include <dlfcn.h>
+#endif
+
 #include "util/u_misc.h"
 #include "util/u_debug.h"
 #include "util/u_extension_list.h"
@@ -36,6 +42,45 @@
 
 #define UUID_STR_SIZE (XRT_UUID_SIZE * 3 + 1)
 
+#ifdef XRT_OS_OSX
+/*
+ * The app's process may have no Vulkan loader, e.g. the Wine bridge where winevulkan drives MoltenVK directly:
+ * XRT_VK_GIPA_LIBRARY names the already loaded ICD library whose vkGetInstanceProcAddr to use.
+ */
+DEBUG_GET_ONCE_OPTION(vk_gipa_library, "XRT_VK_GIPA_LIBRARY", NULL)
+
+PFN_vkGetInstanceProcAddr
+oxr_vk_get_instance_proc_addr(void)
+{
+	static PFN_vkGetInstanceProcAddr gipa = NULL;
+	if (gipa != NULL) {
+		return gipa;
+	}
+
+	const char *lib = debug_get_option_vk_gipa_library();
+	void *handle = RTLD_DEFAULT;
+	if (lib != NULL) {
+		handle = dlopen(lib, RTLD_NOW | RTLD_NOLOAD);
+	}
+	if (handle != NULL) {
+		gipa = (PFN_vkGetInstanceProcAddr)dlsym(handle, "vkGetInstanceProcAddr");
+	}
+	if (gipa == NULL && lib == NULL && (handle = dlopen("libvulkan.1.dylib", RTLD_NOW)) != NULL) {
+		gipa = (PFN_vkGetInstanceProcAddr)dlsym(handle, "vkGetInstanceProcAddr");
+	}
+	if (gipa == NULL) {
+		U_LOG_E("No vkGetInstanceProcAddr (XRT_VK_GIPA_LIBRARY=%s)", lib != NULL ? lib : "");
+	}
+	return gipa;
+}
+#else
+PFN_vkGetInstanceProcAddr
+oxr_vk_get_instance_proc_addr(void)
+{
+	return vkGetInstanceProcAddr;
+}
+#endif
+
 static void
 snprint_uuid(char *str, size_t size, const xrt_uuid_t *uuid)
 {
