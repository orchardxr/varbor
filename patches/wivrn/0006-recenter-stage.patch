+
+DEBUG_GET_ONCE_BOOL_OPTION(recenter_stage, "WIVRN_RECENTER_STAGE", true)
+
+static constexpr int64_t recenter_retry_ns = 2'000'000'000;
+
+static bool try_recenter(xrt_space_overseer * xso)
+{
+	if (XRT_SUCCESS != xrt_space_overseer_recenter_local_spaces(xso))
+		return false;
+
+	if (not debug_get_bool_option_recenter_stage())
+		return true;
+
+	xrt_pose identity = XRT_POSE_IDENTITY;
+	xrt_space_relation head{};
+	auto xret = xrt_space_overseer_locate_space(xso, xso->semantic.root, &identity, os_monotonic_get_ns(), xso->semantic.view, &identity, &head);
+	const auto valid = XRT_SPACE_RELATION_POSITION_VALID_BIT | XRT_SPACE_RELATION_ORIENTATION_VALID_BIT;
+	if (xret != XRT_SUCCESS or (head.relation_flags & valid) != valid)
+	{
+		U_LOG_W("recenter stage: head pose not valid");
+		return true;
+	}
+
+	xrt_pose old_stage;
+	xret = xrt_space_overseer_get_reference_space_offset(xso, XRT_SPACE_REFERENCE_TYPE_STAGE, &old_stage);
+	if (xret != XRT_SUCCESS)
+	{
+		U_LOG_W("recenter stage: cannot read stage offset: %s", u_str_xrt_result(xret));
+		return true;
+	}
+
+	auto stage = recentered_stage_offset(head.pose, old_stage);
+	xret = xrt_space_overseer_set_reference_space_offset(xso, XRT_SPACE_REFERENCE_TYPE_STAGE, &stage);
+	if (xret != XRT_SUCCESS)
+	{
+		U_LOG_W("recenter stage: cannot set stage offset: %s", u_str_xrt_result(xret));
+		return true;
+	}
+	U_LOG_I("recentered stage: origin (%.3f, %.3f, %.3f) yaw %.1f deg (was (%.3f, %.3f, %.3f) yaw %.1f deg)",
+	        stage.position.x,
+	        stage.position.y,
+	        stage.position.z,
+	        yaw_of(stage.orientation) * 180 / M_PI,
+	        old_stage.position.x,
+	        old_stage.position.y,
+	        old_stage.position.z,
+	        yaw_of(old_stage.orientation) * 180 / M_PI);
+	return true;
+}
+
 void wivrn_session::operator()(const from_headset::tracking & tracking)
 {
 	if (gamepad_device)
@@ -639,13 +691,6 @@ void wivrn_session::operator()(const from_headset::tracking & tracking)
 
 		++roles.generation_id;
 	}
-	if (tracking.state_flags & from_headset::tracking::state_flags::recentered)
-	{
-		U_LOG_I("recentering requested");
-		if (XRT_SUCCESS != xrt_space_overseer_recenter_local_spaces(space_overseer))
-			U_LOG_W("failed to recenter local spaces");
-	}
-
 	auto offset = offset_est.get_offset();
 
 	if (offset)
@@ -655,6 +700,25 @@ void wivrn_session::operator()(const from_headset::tracking & tracking)
 	}
 
 	hmd.update_tracking(tracking, offset);
+
+	if (tracking.state_flags & from_headset::tracking::state_flags::recentered)
+	{
+		U_LOG_I("recentering requested");
+		recenter_deadline_ns = os_monotonic_get_ns() + recenter_retry_ns;
+	}
+	// The request often arrives with the first packet after the headset wakes, before the
+	// head pose is valid: keep retrying for a while.
+	if (recenter_deadline_ns)
+	{
+		if (try_recenter(space_overseer))
+			recenter_deadline_ns = 0;
+		else if (os_monotonic_get_ns() > recenter_deadline_ns)
+		{
+			U_LOG_W("failed to recenter local spaces");
+			recenter_deadline_ns = 0;
+		}
+	}
+
 	if (roles.left == left_hand_interaction_index)
 		left_hand_interaction.update_tracking(tracking, offset);
 	else
