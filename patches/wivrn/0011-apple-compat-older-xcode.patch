From: macvr
Subject: [PATCH] apple-compat-older-xcode

---
 common/utils/apple_compat.h | 58 ++++++++++++++++++++++++++++++++++++---------
 1 file changed, 47 insertions(+), 11 deletions(-)

diff --git a/common/utils/apple_compat.h b/common/utils/apple_compat.h
index d5eb7978ab9a57c046c7a3f8921d1b6ebe7b0ee9..355d99f71fa0682ce0ff67b51285e5b28e51479f 100644
--- a/common/utils/apple_compat.h
+++ b/common/utils/apple_compat.h
@@ -19,29 +19,65 @@
 #pragma once
 
 #ifdef __cplusplus
+#include <iterator>
 #include <ranges>
+#include <tuple>
+#include <utility>
 #include <version>
 
-#if defined(__cpp_lib_ranges_zip) && !defined(__cpp_lib_ranges_enumerate)
-namespace std::ranges
+// Standalone enumerate_view, exposed in std::ranges only when the library lacks it (older Xcode). It doesn't rely on
+// zip_view: older libc++ ships zip_view without defining __cpp_lib_ranges_zip.
+namespace wivrn_ranges_compat
 {
-// enumerate_view as zip(iota, view): yields tuple<difference_type, reference>
-template <view V>
-class enumerate_view : public zip_view<iota_view<range_difference_t<V>>, V>
+template <std::ranges::view V>
+class enumerate_view : public std::ranges::view_interface<enumerate_view<V>>
 {
-	using base = zip_view<iota_view<range_difference_t<V>>, V>;
+	V base_;
+
+	using diff = std::ranges::range_difference_t<V>;
+	using inner = std::ranges::iterator_t<V>;
+
+	struct iterator
+	{
+		inner it;
+		diff i = 0;
+
+		using difference_type = diff;
+		using value_type = std::tuple<diff, std::ranges::range_value_t<V>>;
+
+		std::tuple<diff, std::ranges::range_reference_t<V>> operator*() const { return {i, *it}; }
+		iterator & operator++()
+		{
+			++it;
+			++i;
+			return *this;
+		}
+		iterator operator++(int)
+		{
+			auto r = *this;
+			++*this;
+			return r;
+		}
+		bool operator==(const iterator & o) const { return it == o.it; }
+		friend bool operator==(const iterator & a, const std::ranges::sentinel_t<V> & s) { return a.it == s; }
+	};
 
 public:
 	enumerate_view() = default;
-	constexpr explicit enumerate_view(V v) :
-	        base(iota_view<range_difference_t<V>>(0), std::move(v)) {}
+	constexpr explicit enumerate_view(V v) : base_(std::move(v)) {}
+	iterator begin() { return {std::ranges::begin(base_), 0}; }
+	auto end() { return std::ranges::end(base_); }
 };
 
 template <class R>
-enumerate_view(R &&) -> enumerate_view<views::all_t<R>>;
+enumerate_view(R &&) -> enumerate_view<std::views::all_t<R>>;
+
+} // namespace wivrn_ranges_compat
 
-template <class V>
-inline constexpr bool enable_borrowed_range<enumerate_view<V>> = false;
+#if !defined(__cpp_lib_ranges_enumerate)
+namespace std::ranges
+{
+using wivrn_ranges_compat::enumerate_view;
 } // namespace std::ranges
 #endif
 #endif
