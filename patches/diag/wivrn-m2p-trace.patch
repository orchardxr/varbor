 #include "wivrn_config.h"
 #include <magic_enum_containers.hpp>
 #include <ranges>
+#include <cstdio>
+#include <cstdlib>
+#include "os/os_time.h"
+
+FILE * wivrn_m2p_trace()
+{
+	static FILE * f = [] {
+		const char * p = getenv("WIVRN_M2P_TRACE");
+		FILE * f = p ? fopen(p, "w") : nullptr;
+		if (f)
+			setvbuf(f, nullptr, _IOLBF, 1 << 16);
+		return f;
+	}();
+	return f;
+}
 
