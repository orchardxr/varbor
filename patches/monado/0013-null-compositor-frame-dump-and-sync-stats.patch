From: macvr
Subject: [PATCH] null-compositor-frame-dump-and-sync-stats

---
 src/xrt/compositor/client/comp_vk_client.c       |  19 +++-
 src/xrt/compositor/multi/comp_multi_compositor.c |  11 +++
 src/xrt/compositor/multi/comp_multi_private.h    |   7 ++
 src/xrt/compositor/null/CMakeLists.txt           |   1 +
 src/xrt/compositor/null/null_compositor.c        | 114 +++++++++++++++++++++++
 src/xrt/compositor/null/null_compositor.h        |   3 +
 src/xrt/compositor/util/comp_sync_stats.h        |  68 ++++++++++++++
 7 files changed, 219 insertions(+), 4 deletions(-)

diff --git a/src/xrt/compositor/client/comp_vk_client.c b/src/xrt/compositor/client/comp_vk_client.c
index 8cdb66b2025d36dad997d63786079475ae08c0d8..3cf275273234ca8f69ea2edb2ea9f511d5c09d35 100644
--- a/src/xrt/compositor/client/comp_vk_client.c
+++ b/src/xrt/compositor/client/comp_vk_client.c
@@ -9,6 +9,8 @@
  * @ingroup comp_client
  */
 
+#include "os/os_time.h"
+#include "util/comp_sync_stats.h"
 #include "vk/vk_compositor_flags.h"
 
 #include "util/u_misc.h"
@@ -642,18 +644,27 @@ client_vk_compositor_layer_commit(struct xrt_compositor *xc, xrt_graphics_sync_h
 	}
 
 	xrt_result_t xret = XRT_SUCCESS;
+	int64_t start_ns = os_monotonic_get_ns();
+	const char *path = NULL;
 	if (submit_handle(c, sync_handle, &xret)) {
-		return xret;
+		path = "client commit (app sync handle)";
 	} else if (submit_semaphore(c, &xret)) {
-		return xret;
+		path = "client commit (timeline semaphore)";
 	} else if (submit_fence(c, &xret)) {
-		return xret;
+		path = "client commit (fence)";
 	} else if (submit_fallback(c, &xret)) {
-		return xret;
+		path = "client commit (CPU wait)";
 	} else {
 		// Really bad state.
 		return XRT_ERROR_VULKAN;
 	}
+
+	if (comp_sync_stats_enabled()) {
+		static struct comp_sync_stats stats;
+		comp_sync_stats_add(&stats, path, os_monotonic_get_ns() - start_ns);
+	}
+
+	return xret;
 }
 
 static xrt_result_t
