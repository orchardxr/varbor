+++ b/OpenOVR/Misc/xrutil.cpp
@@ -3,9 +3,14 @@
 #include "xrutil.h"
 
 #include "Drivers/Backend.h"
+#include "Misc/Config.h"
 #include "convert.h"
 #include "xr_ext.h"
 
+#include <atomic>
+#include <condition_variable>
+#include <thread>
+
 XrInstance xr_instance = XR_NULL_HANDLE;
 SessionWrapper xr_session;
 XrSystemId xr_system = XR_NULL_SYSTEM_ID;
@@ -275,3 +280,78 @@ SessionLock::~SessionLock()
 }
 
 SessionLock::operator XrSession&() { return parent.session; }
+
+static std::atomic<int> xr_lost_result{ 0 };
+
+bool oovr_xr_lost()
+{
+	return xr_lost_result.load() != 0;
+}
+
+void oovr_xr_reset_lost()
+{
+	xr_lost_result = 0;
+}
+
+void oovr_xr_failed_raw(const char* file, long line, const char* func, int result, const char* expression)
+{
+	if (result == XR_ERROR_INSTANCE_LOST || result == XR_ERROR_SESSION_LOST || oovr_xr_lost()) {
+		int expected = 0;
+		if (xr_lost_result.compare_exchange_strong(expected, result)) {
+			oovr_log_raw_format(file, line, func, "OpenXR runtime lost (XrResult %d in %s), stopping VR", result, expression);
+		}
+		return;
+	}
+
+	if (xr_instance != XR_NULL_HANDLE) {
+		char buf[XR_MAX_RESULT_STRING_SIZE];
+		xrResultToString(xr_instance, (XrResult)result, buf);
+		oovr_abort_raw(file, line, func, "OpenXR Call failed, aborting. %s:%d %s. Error code: %s\n%s", nullptr,
+		    file, (int)line, func, buf, expression);
+	}
+	oovr_abort_raw(file, line, func, "OpenXR Call failed, aborting. %s:%d %s. Error code: %d\n%s", nullptr,
+	    file, (int)line, func, result, expression);
+}
+
+// SteamVR kills an app that hasn't quit some time after VREvent_Quit; do the same once the runtime is lost,
+// unless the app shuts VR down (it may go on without VR) or says it is prompting the user.
+static std::mutex lost_watchdog_mutex;
+static std::condition_variable lost_watchdog_cv;
+static std::thread* lost_watchdog = nullptr; // never destroyed: a joinable std::thread at DLL detach terminates
+static bool lost_watchdog_cancel = false;
+
+void oovr_xr_lost_watchdog_start()
+{
+	std::lock_guard lock(lost_watchdog_mutex);
+	float seconds = oovr_global_configuration.RuntimeLostExitSeconds();
+	if (lost_watchdog || seconds <= 0)
+		return;
+
+	lost_watchdog_cancel = false;
+	auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds((int)(seconds * 1000));
+	lost_watchdog = new std::thread([deadline, seconds]() {
+		std::unique_lock lock(lost_watchdog_mutex);
+		if (lost_watchdog_cv.wait_until(lock, deadline, [] { return lost_watchdog_cancel; }))
+			return;
+		OOVR_LOGF("App did not shut VR down %.1f s after the runtime was lost, exiting the process", seconds);
+#ifdef _WIN32
+		TerminateProcess(GetCurrentProcess(), 0);
+#else
+		_exit(0);
+#endif
+	});
+}
+
+void oovr_xr_lost_watchdog_stop()
+{
+	std::unique_lock lock(lost_watchdog_mutex);
+	if (!lost_watchdog)
+		return;
+	lost_watchdog_cancel = true;
+	lost_watchdog_cv.notify_all();
+	lock.unlock();
+	lost_watchdog->join();
+	delete lost_watchdog;
+	lost_watchdog = nullptr;
+	OOVR_LOG("Runtime-lost exit timer cancelled");
+}
