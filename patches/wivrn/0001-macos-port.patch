+	if (received < 0)
+		throw std::system_error{errno, std::generic_category()};
+	if (storage.ss_family == AF_INET)
+	{
+		const auto & in4 = reinterpret_cast<const sockaddr_in &>(storage);
+		addr = sockaddr_in6{
+		        .sin6_len = sizeof(sockaddr_in6),
+		        .sin6_family = AF_INET6,
+		        .sin6_port = in4.sin_port,
+		};
+		addr.sin6_addr.s6_addr[10] = 0xff;
+		addr.sin6_addr.s6_addr[11] = 0xff;
+		memcpy(&addr.sin6_addr.s6_addr[12], &in4.sin_addr, 4);
+	}
+	else
+		memcpy(&addr, &storage, sizeof(addr));
+#else
 	ssize_t received = recvfrom(fd, buffer.get(), peeked, 0, (sockaddr *)&addr, &addrlen);
 	if (received < 0)
 		throw std::system_error{errno, std::generic_category()};
+#endif
 
 	std::span message{buffer.get(), (size_t)received};
 
@@ -291,6 +340,31 @@ wivrn::deserialization_packet wivrn::UDP::receive_raw()
