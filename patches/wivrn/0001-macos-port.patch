+ */
+
+#include "bonjour_publisher.h"
+
+#include <arpa/inet.h>
+#include <glib-unix.h>
+#include <glib.h>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+namespace wivrn
+{
+
+void bonjour_publisher::register_callback(DNSServiceRef, DNSServiceFlags, DNSServiceErrorType error, const char * name, const char * type, const char * domain, void *)
+{
+	if (error == kDNSServiceErr_NoError)
+		std::cerr << "Service published: " << name << "." << type << domain << std::endl;
+	else
+		std::cerr << "Bonjour registration failed: " << error << std::endl;
+}
+
+bonjour_publisher::bonjour_publisher(const std::string & name, const std::string & type, int port, const std::map<std::string, std::string> & txt)
+{
+	TXTRecordRef record;
+	TXTRecordCreate(&record, 0, nullptr);
+	for (const auto & [key, value]: txt)
+	{
+		if (value.size() > 255 or TXTRecordSetValue(&record, key.c_str(), value.size(), value.data()) != kDNSServiceErr_NoError)
+			std::cerr << "Cannot add TXT entry " << key << std::endl;
+	}
+
+	DNSServiceErrorType err = DNSServiceRegister(
+	        &service,
+	        0,
+	        kDNSServiceInterfaceIndexAny,
+	        name.empty() ? nullptr : name.c_str(),
+	        type.c_str(),
+	        nullptr,
+	        nullptr,
+	        htons(port),
+	        TXTRecordGetLength(&record),
+	        TXTRecordGetBytesPtr(&record),
+	        &register_callback,
+	        this);
+	TXTRecordDeallocate(&record);
+
+	if (err != kDNSServiceErr_NoError)
+		throw std::runtime_error("DNSServiceRegister failed: " + std::to_string(err));
+
+	watch = g_unix_fd_add(
+	        DNSServiceRefSockFD(service), G_IO_IN, [](int, GIOCondition, void * self) -> gboolean {
+		        auto err = DNSServiceProcessResult(((bonjour_publisher *)self)->service);
+		        if (err != kDNSServiceErr_NoError)
+		        {
+			        std::cerr << "DNSServiceProcessResult failed: " << err << std::endl;
+			        ((bonjour_publisher *)self)->watch = 0;
+			        return G_SOURCE_REMOVE;
+		        }
+		        return G_SOURCE_CONTINUE;
+	        },
+	        this);
+}
+
+bonjour_publisher::~bonjour_publisher()
+{
+	if (watch)
+		g_source_remove(watch);
+	if (service)
+		DNSServiceRefDeallocate(service);
+}
+
+} // namespace wivrn
