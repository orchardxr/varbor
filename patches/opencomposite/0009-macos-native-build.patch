From: macvr
Subject: [PATCH] macos-native-build

---
 CMakeLists.txt                    | 50 ++++++++++++++++++++++++++++++++++-----
 DrvOpenXR/DrvOpenXR.cpp           | 14 +++++++++++
 DrvOpenXR/tmp_gfx/TemporaryVk.cpp | 41 ++++++++++++++++++++++++++++++--
 OpenOVR/Misc/resources_linux.S    | 25 +++++++++++++++-----
 OpenOVR/Misc/xrutil.cpp           |  4 ++++
 OpenOVR/Reimpl/BaseClientCore.cpp | 16 +++++++++----
 6 files changed, 131 insertions(+), 19 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b8255ab2491d814a46d0bcfb77e77bfec0332b1b..e189c0e22f2005a8941a4f4044fee4195a226215 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -31,6 +31,9 @@ if (WIN32)
 	set(GRAPHICS_API_SUPPORT_FLAGS -DSUPPORT_DX -DSUPPORT_DX11 -DSUPPORT_DX12 -DSUPPORT_VK -DSUPPORT_GL)
 elseif (ANDROID)
 	set(GRAPHICS_API_SUPPORT_FLAGS -DSUPPORT_VK -DSUPPORT_GLES)
+elseif (APPLE)
+	# OpenXR has no OpenGL binding on macOS; apps reach us through a vrclient bridge with Vulkan textures
+	set(GRAPHICS_API_SUPPORT_FLAGS -DSUPPORT_VK)
 else ()
 	set(GRAPHICS_API_SUPPORT_FLAGS -DSUPPORT_VK -DSUPPORT_GL)
 endif()
@@ -105,6 +108,12 @@ elseif (WIN32)
 elseif (ANDROID)
 	# Let the system sort out the linkage, we'll just use our included headers
 	target_include_directories(Vulkan INTERFACE libs/vulkan/Include)
+elseif (APPLE)
+	find_path(OC_VULKAN_INCLUDE_DIR vulkan/vulkan.h REQUIRED)
+	find_library(OC_VULKAN_LIBRARY vulkan REQUIRED)
+	target_include_directories(Vulkan INTERFACE ${OC_VULKAN_INCLUDE_DIR})
+	target_link_libraries(Vulkan INTERFACE ${OC_VULKAN_LIBRARY})
+	target_compile_definitions(Vulkan INTERFACE -DVK_ENABLE_BETA_EXTENSIONS)
 else ()
 	# On Linux, use the system copy
 	find_library(Vulkan vulkan REQUIRED)
@@ -121,11 +130,16 @@ else ()
 endif ()
 
 # === OpenXR ===
-add_compile_definitions(XR_USE_GRAPHICS_API_OPENGL XR_USE_GRAPHICS_API_VULKAN)
+if (APPLE)
+	add_compile_definitions(XR_USE_GRAPHICS_API_VULKAN XR_OS_APPLE)
+else ()
+	add_compile_definitions(XR_USE_GRAPHICS_API_OPENGL XR_USE_GRAPHICS_API_VULKAN)
+endif ()
 # Platform-dependent flags
 if (WIN32)
 	add_compile_definitions(XR_OS_WINDOWS XR_USE_PLATFORM_WIN32
 		XR_USE_GRAPHICS_API_D3D11 XR_USE_GRAPHICS_API_D3D12)
+elseif (APPLE)
 else()
 	add_compile_definitions(XR_OS_LINUX XR_USE_PLATFORM_XLIB)
 endif()
@@ -138,6 +152,16 @@ if (USE_SYSTEM_OPENXR)
 	set(jsoncppLib JsonCpp::JsonCpp)
 endif()
 
+# The bundled 1.0.12 loader has no macOS support: use an externally built one (OC_OPENXR_INCLUDE_DIRS, OC_OPENXR_LIBRARY)
+if (APPLE AND NOT OpenXR_FOUND)
+	add_library(OpenXR INTERFACE)
+	target_include_directories(OpenXR INTERFACE ${OC_OPENXR_INCLUDE_DIRS})
+	target_link_libraries(OpenXR INTERFACE ${OC_OPENXR_LIBRARY} Vulkan)
+	set(XrLib OpenXR)
+	set(OpenXR_FOUND TRUE)
+	set(OC_EXTERNAL_OPENXR TRUE)
+endif ()
+
 if (NOT OpenXR_FOUND OR NOT jsoncpp_FOUND)
 	set(XrDir libs/openxr-sdk)
 
@@ -153,6 +177,9 @@ if (NOT OpenXR_FOUND OR NOT jsoncpp_FOUND)
 	endif()
 
 	set(jsoncppLib jsoncpp)
+endif ()
+
+if (NOT OpenXR_FOUND)
 
 	# Building CMake subprojects is a real pain (IMO), so just build this here
 	set(XrDirLoader libs/openxr-sdk/src/loader)
@@ -250,7 +277,7 @@ add_library(DrvOpenXR STATIC
 target_include_directories(DrvOpenXR PUBLIC DrvOpenXR/pub ${CMAKE_BINARY_DIR})
 target_include_directories(DrvOpenXR PRIVATE DrvOpenXR OpenOVR)
 target_link_libraries(DrvOpenXR PUBLIC OpenVR ${XrLib} ${jsoncppLib} ${glmLib})
-if (NOT WIN32 AND NOT ANDROID)
+if (NOT WIN32 AND NOT ANDROID AND NOT APPLE)
 	target_link_libraries(DrvOpenXR PRIVATE X11) # for XFree()
 endif ()
 target_compile_definitions(DrvOpenXR PRIVATE ${GRAPHICS_API_SUPPORT_FLAGS})
@@ -427,12 +454,12 @@ target_include_directories(OCCore PUBLIC OpenOVR ${CMAKE_BINARY_DIR})  # TODO ma
 target_include_directories(OCCore PRIVATE BundledLibs OpenVRHeaders)
 target_compile_definitions(OCCore PRIVATE ${GRAPHICS_API_SUPPORT_FLAGS})
 
-target_link_libraries(OCCore PRIVATE OpenVR Vulkan ${XrLib} ${glmLib})
+target_link_libraries(OCCore PRIVATE OpenVR Vulkan ${XrLib} ${jsoncppLib} ${glmLib})
 if (WIN32)
 	target_link_libraries(OCCore PRIVATE ws2_32)
 endif ()
 
-if (NOT WIN32 AND NOT ANDROID)
+if (NOT WIN32 AND NOT ANDROID AND NOT APPLE)
 	find_package(OpenGL REQUIRED) # for glGetError()
 	target_link_libraries(OCCore PRIVATE ${OPENGL_LIBRARIES})
 endif ()
@@ -523,7 +550,10 @@ endif ()
 
 # Require that all symbols are defined on Linux - this is always done on Windows
 # Also on Linux, put all the static libraries in a group to avoid ordering problems
-if (NOT WIN32)
+if (APPLE)
+	# ld64 fails on undefined symbols by default and needs no archive groups
+	target_link_libraries(OCOVR PUBLIC OCCore DrvOpenXR)
+elseif (NOT WIN32)
 	target_link_libraries(OCOVR PRIVATE -Wl,--no-undefined)
 	target_link_libraries(OCOVR PUBLIC -Wl,--start-group OCCore DrvOpenXR -Wl,--end-group)
 else ()
@@ -535,8 +565,10 @@ endif ()
 if (WIN32)
 else ()
 	target_compile_options(DrvOpenXR PRIVATE -fPIC)
-	if (NOT OpenXR_FOUND OR NOT jsoncpp_FOUND)
+	if (TARGET OpenXR AND NOT OC_EXTERNAL_OPENXR)
 		target_compile_options(OpenXR PRIVATE -fPIC)
+	endif ()
+	if (TARGET jsoncpp)
 		target_compile_options(jsoncpp PRIVATE -fPIC)
 	endif ()
 	target_compile_options(OCCore PRIVATE -fPIC)
@@ -545,6 +577,9 @@ endif ()
 # The -Bsymbolic makes this work on exported functions - otherwise those will still use the first-defined one.
 # See the comment at the top about -fvisibility=hidden
 if (WIN32)
+elseif (APPLE)
+	# Two-level namespace already binds our own references to us, like -Bsymbolic
+	set_target_properties(OCOVR PROPERTIES SUFFIX ".dylib")
 else ()
 	target_link_options(OCOVR PRIVATE -Wl,-Bsymbolic -Wl,-Bsymbolic-functions)
 
@@ -613,6 +648,9 @@ if (WIN32)
 	else()
 		set(VRCLIENT_NAME vrclient)
 	endif()
+elseif (APPLE)
+	set(VRCLIENT_NAME vrclient)
+	set(VRCLIENT_DIR bin/osx64)
 else ()
 	set(VRCLIENT_NAME vrclient)
 	if ( is_64bit_build )
diff --git a/DrvOpenXR/DrvOpenXR.cpp b/DrvOpenXR/DrvOpenXR.cpp
index 7e31d68fe761ec9083f09e3bc16baa8b17b3c05b..15b4d039a033e065b4f1c3ed5383f57d6a445b78 100644
--- a/DrvOpenXR/DrvOpenXR.cpp
+++ b/DrvOpenXR/DrvOpenXR.cpp
@@ -33,6 +33,20 @@ std::string GetExeName()
 	PathStripPathA(exePath);
 	return { exePath };
 }
+#elif defined(__APPLE__)
+#include <libgen.h>
+#include <limits.h>
+#include <mach-o/dyld.h>
+
+std::string GetExeName()
+{
+	char exePath[PATH_MAX + 1] = { 0 };
+	uint32_t size = PATH_MAX;
+	if (_NSGetExecutablePath(exePath, &size) == 0) {
+		return { basename(exePath) };
+	}
+	return { "" };
+}
 #else
 #include <libgen.h> // basename
 #include <linux/limits.h> // PATH_MAX
diff --git a/DrvOpenXR/tmp_gfx/TemporaryVk.cpp b/DrvOpenXR/tmp_gfx/TemporaryVk.cpp
index 0cc114be60c36916eb9524ef82277551e8150c73..06eadf2187198e28bddb1aeafea8bdbe59c2d7ff 100644
--- a/DrvOpenXR/tmp_gfx/TemporaryVk.cpp
+++ b/DrvOpenXR/tmp_gfx/TemporaryVk.cpp
@@ -54,11 +54,36 @@ TemporaryVk::TemporaryVk()
 
 		parseExtensionsStr(xrInstanceExtensions, instanceExtensionsStore, instanceExtensionsCstr);
 
-		createInfo.enabledExtensionCount = instanceExtensionsCstr.size();
-		createInfo.ppEnabledExtensionNames = instanceExtensionsCstr.data();
 		// Don't use any layers here
 	}
 
+	// MoltenVK is a portability driver: the loader hides it unless asked to enumerate those
+	uint32_t instExtCount = 0;
+	vkEnumerateInstanceExtensionProperties(nullptr, &instExtCount, nullptr);
+	std::vector<VkExtensionProperties> instExts(instExtCount);
+	vkEnumerateInstanceExtensionProperties(nullptr, &instExtCount, instExts.data());
+	auto hasInstExt = [&](const char* name) {
+		for (const VkExtensionProperties& e : instExts)
+			if (strcmp(e.extensionName, name) == 0)
+				return true;
+		return false;
+	};
+	auto enabledInstExt = [&](const char* name) {
+		for (const char* e : instanceExtensionsCstr)
+			if (strcmp(e, name) == 0)
+				return true;
+		return false;
+	};
+	if (hasInstExt(VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME)) {
+		if (!enabledInstExt(VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME))
+			instanceExtensionsCstr.push_back(VK_KHR_PORTABILITY_ENUMERATION_EXTENSION_NAME);
+		if (!enabledInstExt(VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME) && hasInstExt(VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME))
+			instanceExtensionsCstr.push_back(VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME);
+		createInfo.flags |= VK_INSTANCE_CREATE_ENUMERATE_PORTABILITY_BIT_KHR;
+	}
+	createInfo.enabledExtensionCount = instanceExtensionsCstr.size();
+	createInfo.ppEnabledExtensionNames = instanceExtensionsCstr.data();
+
 	OOVR_FAILED_VK_ABORT(vkCreateInstance(&createInfo, nullptr, &instance));
 
 	// Find the physical device we're supposed to use
@@ -116,6 +141,18 @@ TemporaryVk::TemporaryVk()
 #else
 	addIfSupported(VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME);
 #endif
+#ifdef VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME
+	// Required on portability (MoltenVK) devices
+	for (const VkExtensionProperties& e : avail) {
+		if (strcmp(e.extensionName, VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME) == 0) {
+			bool already = false;
+			for (const char* d : deviceExtensionsCstr)
+				already |= strcmp(d, VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME) == 0;
+			if (!already)
+				deviceExtensionsCstr.push_back(VK_KHR_PORTABILITY_SUBSET_EXTENSION_NAME);
+		}
+	}
+#endif
 
 	devCreateInfo.enabledExtensionCount = deviceExtensionsCstr.size();
 	devCreateInfo.ppEnabledExtensionNames = deviceExtensionsCstr.data();
diff --git a/OpenOVR/Misc/resources_linux.S b/OpenOVR/Misc/resources_linux.S
index 04100cea288e160ced8de0a908e76b19b8837422..6169a79413cb2d12906c9bc0747bc3e1ddda3520 100644
--- a/OpenOVR/Misc/resources_linux.S
+++ b/OpenOVR/Misc/resources_linux.S
@@ -1,7 +1,20 @@
 // Embed some binary assets since there's no standardised resource compiler in the Linux world
 #include "resources.h"
 
+#ifdef __APPLE__
+.const
+#define SYM(name) _##name
+#else
 .section .rodata
+#define SYM(name) name
+#endif
+
+// ';' starts a comment in Apple's arm64 assembler, which separates statements with '%%'
+#if defined(__APPLE__) && defined(__aarch64__)
+#define SEP %%
+#else
+#define SEP ;
+#endif
 
 #define FILENAME_RES_O_HAND_LEFT "assets/LeftHand.obj"
 #define FILENAME_RES_O_HAND_RIGHT "assets/RightHand.obj"
@@ -13,11 +26,11 @@
 // TODO do we need an alignment directive?
 
 #define ADD_RESOURCE(sym)   \
-	.global resource_##sym; \
-	.global resource_##sym##_end; \
-	resource_##sym:; \
-	.incbin FILENAME_##sym; \
-	resource_##sym##_end:; \
-	.byte 0; /* To make this a C string, after end to not affect the length */ \
+	.global SYM(resource_##sym) SEP \
+	.global SYM(resource_##sym##_end) SEP \
+	SYM(resource_##sym): SEP \
+	.incbin FILENAME_##sym SEP \
+	SYM(resource_##sym##_end): SEP \
+	.byte 0 SEP /* To make this a C string, after end to not affect the length */ \
 
 RES_LIST_LINUX(ADD_RESOURCE)
diff --git a/OpenOVR/Misc/xrutil.cpp b/OpenOVR/Misc/xrutil.cpp
index 6881a1218ddbe0aa163c4cb2606982b3f7e7735a..bf88d1f1d0de9a22f3504d72a184c822be6eb697 100644
--- a/OpenOVR/Misc/xrutil.cpp
+++ b/OpenOVR/Misc/xrutil.cpp
@@ -11,6 +11,10 @@
 #include <condition_variable>
 #include <thread>
 
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
 XrInstance xr_instance = XR_NULL_HANDLE;
 SessionWrapper xr_session;
 XrSystemId xr_system = XR_NULL_SYSTEM_ID;
diff --git a/OpenOVR/Reimpl/BaseClientCore.cpp b/OpenOVR/Reimpl/BaseClientCore.cpp
index c799d205c1697904e9a24910146c4ea1040ec2e1..9b8f0807d88897be242be57db3db787916215c0a 100644
--- a/OpenOVR/Reimpl/BaseClientCore.cpp
+++ b/OpenOVR/Reimpl/BaseClientCore.cpp
@@ -147,8 +147,14 @@ static wstring GetAppSettingsPath()
 	}
 
 	path = rwchPath;
-#elif defined(OSX)
-#error "Unsupported platform"
+#elif defined(__APPLE__)
+	const char* pchHome = getenv("HOME");
+	if (pchHome == NULL) {
+		return L"";
+	}
+	path = CHAR_CONV.from_bytes(pchHome);
+	TrimPath(path);
+	path += L"/Library/Application Support";
 #elif defined(__linux__)
 	// As defined by XDG Base Directory Specification
 	// https://specifications.freedesktop.org/basedir-spec/basedir-spec-latest.html
@@ -184,8 +190,8 @@ static wstring GetOpenVRConfigPath()
 
 #if defined(_WIN32) || defined(__linux__)
 	sConfigPath += L"/openvr";
-#elif defined(OSX)
-	sConfigPath += L"/.openvr";
+#elif defined(__APPLE__)
+	sConfigPath += L"/OpenVR";
 #else
 #error "Unsupported platform"
 #endif
@@ -196,7 +202,7 @@ string BaseClientCore::GetAlternativeRuntimePath()
 {
 	wstring regPath = GetOpenVRConfigPath();
 
-#if defined(_WIN32) || defined(__unix__)
+#if defined(_WIN32) || defined(__unix__) || defined(__APPLE__)
 	regPath += L"/openvrpaths.vrpath";
 #else
 #error "Unsupported platform"
