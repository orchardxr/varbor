diff --git a/src/xrt/compositor/client/comp_metal_client.m b/src/xrt/compositor/client/comp_metal_client.m
new file mode 100644
index 0000000000000000000000000000000000000000..4038cd72a1ab746f71d87042ed8f21fadfad39cb
--- /dev/null
+++ b/src/xrt/compositor/client/comp_metal_client.m
@@ -0,0 +1,537 @@
+// Copyright 2026, macvr contributors.
+// SPDX-License-Identifier: BSL-1.0
+/*!
+ * @file
+ * @brief  Metal client side glue to compositor implementation.
+ * @ingroup comp_client
+ */
+
+#import <Metal/Metal.h>
+#include <IOSurface/IOSurfaceRef.h>
+
+#include "xrt/xrt_gfx_metal.h"
+#include "xrt/xrt_vulkan_includes.h"
+
+#include "util/u_misc.h"
+#include "util/u_handles.h"
+#include "util/u_logging.h"
+#include "util/u_trace_marker.h"
+
+#include <assert.h>
+#include <stdlib.h>
+
+// Private API, also used by vk_metal_apple.m. Checked with respondsToSelector before use.
+@protocol ClientMTLDeviceSPI <MTLDevice>
+- (id<MTLSharedEvent>)newSharedEventWithMachPort:(mach_port_t)machPort;
+@end
+
+static const struct
+{
+	int64_t vk;
+	MTLPixelFormat mtl;
+} formats[] = {
+    {VK_FORMAT_R8G8B8A8_UNORM, MTLPixelFormatRGBA8Unorm},
+    {VK_FORMAT_R8G8B8A8_SRGB, MTLPixelFormatRGBA8Unorm_sRGB},
+    {VK_FORMAT_B8G8R8A8_UNORM, MTLPixelFormatBGRA8Unorm},
+    {VK_FORMAT_B8G8R8A8_SRGB, MTLPixelFormatBGRA8Unorm_sRGB},
+    {VK_FORMAT_A2B10G10R10_UNORM_PACK32, MTLPixelFormatRGB10A2Unorm},
+    {VK_FORMAT_R16G16B16A16_UNORM, MTLPixelFormatRGBA16Unorm},
+    {VK_FORMAT_R16G16B16A16_SFLOAT, MTLPixelFormatRGBA16Float},
+};
+
+static int64_t
+mtl_to_vk_format(int64_t mtl)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(formats); i++) {
+		if ((int64_t)formats[i].mtl == mtl) {
+			return formats[i].vk;
+		}
+	}
+	return 0;
+}
+
+static MTLPixelFormat
+vk_to_mtl_format(int64_t vk)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(formats); i++) {
+		if (formats[i].vk == vk) {
+			return formats[i].mtl;
+		}
+	}
+	return MTLPixelFormatInvalid;
+}
+
+
+/*
+ *
+ * Structs.
+ *
+ */
+
+struct client_metal_compositor
+{
+	struct xrt_compositor_metal base;
+
+	//! Owning reference to the backing native compositor.
+	struct xrt_compositor_native *xcn;
+
+	id<MTLCommandQueue> queue;
+
+	struct
+	{
+		id<MTLSharedEvent> event;
+		struct xrt_compositor_semaphore *xcsem;
+		uint64_t value;
+	} sync;
+};
+
+struct client_metal_swapchain
+{
+	struct xrt_swapchain_metal base;
+
+	//! Owning reference to the backing native swapchain.
+	struct xrt_swapchain_native *xscn;
+
+	//! Non-owning reference to our parent compositor.
+	struct client_metal_compositor *c;
+
+	IOSurfaceRef surfaces[XRT_MAX_SWAPCHAIN_IMAGES];
+};
+
+static inline struct client_metal_compositor *
+client_metal_compositor(struct xrt_compositor *xc)
+{
+	return (struct client_metal_compositor *)xc;
+}
+
+static inline struct client_metal_swapchain *
+client_metal_swapchain(struct xrt_swapchain *xsc)
+{
+	return (struct client_metal_swapchain *)xsc;
+}
+
+static inline struct xrt_compositor *
+to_native_compositor(struct xrt_compositor *xc)
+{
+	return &client_metal_compositor(xc)->xcn->base;
+}
+
+static inline struct xrt_swapchain *
+to_native_swapchain(struct xrt_swapchain *xsc)
+{
+	return &client_metal_swapchain(xsc)->xscn->base;
+}
+
+static void
+wait_queue_idle(struct client_metal_compositor *c)
+{
+	@autoreleasepool {
+		id<MTLCommandBuffer> cb = [c->queue commandBuffer];
+		[cb commit];
+		[cb waitUntilCompleted];
+	}
+}
+
+
+/*
+ *
+ * Swapchain functions.
+ *
+ */
+
+static void
+client_metal_swapchain_destroy(struct xrt_swapchain *xsc)
+{
+	struct client_metal_swapchain *sc = client_metal_swapchain(xsc);
+
+	wait_queue_idle(sc->c);
+
+	for (uint32_t i = 0; i < sc->base.base.image_count; i++) {
+		[(id<MTLTexture>)sc->base.images[i] release];
+		sc->base.images[i] = NULL;
+		if (sc->surfaces[i] != NULL) {
+			CFRelease(sc->surfaces[i]);
+			sc->surfaces[i] = NULL;
+		}
+	}
+
+	xrt_swapchain_native_reference(&sc->xscn, NULL);
+
+	free(sc);
+}
+
+static xrt_result_t
+client_metal_swapchain_acquire_image(struct xrt_swapchain *xsc, uint32_t *out_index)
+{
+	return xrt_swapchain_acquire_image(to_native_swapchain(xsc), out_index);
+}
+
+static xrt_result_t
+client_metal_swapchain_wait_image(struct xrt_swapchain *xsc, int64_t timeout_ns, uint32_t index)
+{
+	return xrt_swapchain_wait_image(to_native_swapchain(xsc), timeout_ns, index);
+}
+
+static xrt_result_t
+client_metal_swapchain_barrier_image(struct xrt_swapchain *xsc, enum xrt_barrier_direction direction, uint32_t index)
+{
+	return XRT_SUCCESS;
+}
+
+static xrt_result_t
+client_metal_swapchain_release_image(struct xrt_swapchain *xsc, uint32_t index)
+{
+	return xrt_swapchain_release_image(to_native_swapchain(xsc), index);
+}
+
+
+/*
+ *
+ * Compositor functions.
+ *
+ */
+
+static xrt_result_t
+client_metal_compositor_get_swapchain_create_properties(struct xrt_compositor *xc,
+                                                        const struct xrt_swapchain_create_info *info,
+                                                        struct xrt_swapchain_create_properties *xsccp)
+{
+	struct xrt_swapchain_create_info xinfo = *info;
+	xinfo.format = mtl_to_vk_format(info->format);
+	if (xinfo.format == 0) {
+		return XRT_ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED;
+	}
+
+	return xrt_comp_get_swapchain_create_properties(to_native_compositor(xc), &xinfo, xsccp);
+}
+
+static xrt_result_t
+client_metal_swapchain_create(struct xrt_compositor *xc,
+                              const struct xrt_swapchain_create_info *info,
+                              struct xrt_swapchain **out_xsc)
+{
+	COMP_TRACE_MARKER();
+
+	struct client_metal_compositor *c = client_metal_compositor(xc);
+	xrt_result_t xret;
+
+	if (info->sample_count > 1) {
+		U_LOG_E("Multisampled swapchains can't be shared via IOSurface");
+		return XRT_ERROR_SWAPCHAIN_FLAG_VALID_BUT_UNSUPPORTED;
+	}
+
+	struct xrt_swapchain_create_info xinfo = *info;
+	xinfo.format = mtl_to_vk_format(info->format);
+	if (xinfo.format == 0) {
+		return XRT_ERROR_SWAPCHAIN_FORMAT_UNSUPPORTED;
+	}
+
+	struct xrt_swapchain_create_properties xsccp = XRT_STRUCT_INIT;
+	xret = xrt_comp_get_swapchain_create_properties(&c->xcn->base, &xinfo, &xsccp);
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+	xinfo.bits |= xsccp.extra_bits;
+
+	struct xrt_swapchain_native *xscn = NULL;
+	xret = xrt_comp_native_create_swapchain(c->xcn, &xinfo, &xscn);
+	if (xret != XRT_SUCCESS) {
+		return xret;
+	}
+
+	struct client_metal_swapchain *sc = U_TYPED_CALLOC(struct client_metal_swapchain);
+	sc->base.base.destroy = client_metal_swapchain_destroy;
+	sc->base.base.acquire_image = client_metal_swapchain_acquire_image;
+	sc->base.base.wait_image = client_metal_swapchain_wait_image;
+	sc->base.base.barrier_image = client_metal_swapchain_barrier_image;
+	sc->base.base.release_image = client_metal_swapchain_release_image;
+	sc->base.base.reference.count = 1;
+	sc->base.base.image_count = xscn->base.image_count;
+	sc->c = c;
+	sc->xscn = xscn;
+
+	MTLTextureUsage usage = 0;
+	if (xinfo.bits & (XRT_SWAPCHAIN_USAGE_COLOR | XRT_SWAPCHAIN_USAGE_DEPTH_STENCIL)) {
+		usage |= MTLTextureUsageRenderTarget;
+	}
+	if (xinfo.bits & (XRT_SWAPCHAIN_USAGE_SAMPLED | XRT_SWAPCHAIN_USAGE_INPUT_ATTACHMENT)) {
+		usage |= MTLTextureUsageShaderRead;
+	}
+	if (xinfo.bits & XRT_SWAPCHAIN_USAGE_UNORDERED_ACCESS) {
+		usage |= MTLTextureUsageShaderWrite;
+	}
+	if (xinfo.bits & XRT_SWAPCHAIN_USAGE_MUTABLE_FORMAT) {
+		usage |= MTLTextureUsagePixelFormatView;
+	}
+
+	@autoreleasepool {
+		id<MTLDevice> device = c->queue.device;
+		MTLTextureDescriptor *desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:info->format
+		                                                                                width:info->width
+		                                                                               height:info->height
+		                                                                            mipmapped:NO];
+		desc.usage = usage;
+
+		for (uint32_t i = 0; i < sc->base.base.image_count; i++) {
+			sc->surfaces[i] = IOSurfaceLookupFromMachPort(xscn->images[i].handle);
+			if (sc->surfaces[i] == NULL) {
+				U_LOG_E("IOSurfaceLookupFromMachPort failed for image %u", i);
+				client_metal_swapchain_destroy(&sc->base.base);
+				return XRT_ERROR_ALLOCATION;
+			}
+
+			id<MTLTexture> tex = [device newTextureWithDescriptor:desc iosurface:sc->surfaces[i] plane:0];
+			if (tex == nil) {
+				U_LOG_E("newTextureWithDescriptor:iosurface: failed for image %u", i);
+				client_metal_swapchain_destroy(&sc->base.base);
+				return XRT_ERROR_ALLOCATION;
+			}
+			sc->base.images[i] = tex;
+		}
+	}
+
+	*out_xsc = &sc->base.base;
+
+	return XRT_SUCCESS;
+}
+
+static xrt_result_t
+client_metal_compositor_passthrough_create(struct xrt_compositor *xc, const struct xrt_passthrough_create_info *info)
+{
+	return xrt_comp_create_passthrough(to_native_compositor(xc), info);
+}
+
+static xrt_result_t
+client_metal_compositor_passthrough_layer_create(struct xrt_compositor *xc,
+                                                 const struct xrt_passthrough_layer_create_info *info)
+{
+	return xrt_comp_create_passthrough_layer(to_native_compositor(xc), info);
+}
+
+static xrt_result_t
+client_metal_compositor_passthrough_destroy(struct xrt_compositor *xc)
+{
+	return xrt_comp_destroy_passthrough(to_native_compositor(xc));
+}
+
+static xrt_result_t
+client_metal_compositor_begin_session(struct xrt_compositor *xc, const struct xrt_begin_session_info *info)
+{
+	return xrt_comp_begin_session(to_native_compositor(xc), info);
+}
+
+static xrt_result_t
+client_metal_compositor_end_session(struct xrt_compositor *xc)
+{
+	return xrt_comp_end_session(to_native_compositor(xc));
+}
+
+static xrt_result_t
+client_metal_compositor_wait_frame(struct xrt_compositor *xc,
+                                   int64_t *out_frame_id,
+                                   int64_t *predicted_display_time,
+                                   int64_t *predicted_display_period)
+{
+	COMP_TRACE_MARKER();
+
+	return xrt_comp_wait_frame(to_native_compositor(xc), out_frame_id, predicted_display_time,
+	                           predicted_display_period);
+}
+
+static xrt_result_t
+client_metal_compositor_begin_frame(struct xrt_compositor *xc, int64_t frame_id)
+{
+	return xrt_comp_begin_frame(to_native_compositor(xc), frame_id);
+}
+
+static xrt_result_t
+client_metal_compositor_discard_frame(struct xrt_compositor *xc, int64_t frame_id)
+{
+	return xrt_comp_discard_frame(to_native_compositor(xc), frame_id);
+}
+
+static xrt_result_t
+client_metal_compositor_layer_begin(struct xrt_compositor *xc, const struct xrt_layer_frame_data *data)
+{
+	return xrt_comp_layer_begin(to_native_compositor(xc), data);
+}
+
+static xrt_result_t
+client_metal_compositor_layer_projection(struct xrt_compositor *xc,
+                                         struct xrt_device *xdev,
+                                         struct xrt_swapchain *xsc[XRT_MAX_VIEWS],
+                                         const struct xrt_layer_data *data)
+{
+	struct xrt_swapchain *xscn[XRT_MAX_VIEWS];
+
+	assert(data->type == XRT_LAYER_PROJECTION);
+	for (uint32_t i = 0; i < data->view_count; ++i) {
+		xscn[i] = to_native_swapchain(xsc[i]);
+	}
+
+	return xrt_comp_layer_projection(to_native_compositor(xc), xdev, xscn, data);
+}
+
+static xrt_result_t
+client_metal_compositor_layer_projection_depth(struct xrt_compositor *xc,
+                                               struct xrt_device *xdev,
+                                               struct xrt_swapchain *xsc[XRT_MAX_VIEWS],
+                                               struct xrt_swapchain *d_xsc[XRT_MAX_VIEWS],
+                                               const struct xrt_layer_data *data)
+{
+	struct xrt_swapchain *xscn[XRT_MAX_VIEWS];
+	struct xrt_swapchain *d_xscn[XRT_MAX_VIEWS];
+
+	assert(data->type == XRT_LAYER_PROJECTION_DEPTH);
+	for (uint32_t i = 0; i < data->view_count; ++i) {
+		xscn[i] = to_native_swapchain(xsc[i]);
+		d_xscn[i] = to_native_swapchain(d_xsc[i]);
+	}
+
+	return xrt_comp_layer_projection_depth(to_native_compositor(xc), xdev, xscn, d_xscn, data);
+}
+
+#define LAYER_FUNC(NAME, TYPE)                                                                                         \
+	static xrt_result_t client_metal_compositor_layer_##NAME(struct xrt_compositor *xc, struct xrt_device *xdev,    \
+	                                                         struct xrt_swapchain *xsc,                            \
+	                                                         const struct xrt_layer_data *data)                    \
+	{                                                                                                              \
+		assert(data->type == TYPE);                                                                            \
+		return xrt_comp_layer_##NAME(to_native_compositor(xc), xdev, to_native_swapchain(xsc), data);          \
+	}
+
+LAYER_FUNC(quad, XRT_LAYER_QUAD)
+LAYER_FUNC(cube, XRT_LAYER_CUBE)
+LAYER_FUNC(cylinder, XRT_LAYER_CYLINDER)
+LAYER_FUNC(equirect1, XRT_LAYER_EQUIRECT1)
+LAYER_FUNC(equirect2, XRT_LAYER_EQUIRECT2)
+
+static xrt_result_t
+client_metal_compositor_layer_passthrough(struct xrt_compositor *xc,
+                                          struct xrt_device *xdev,
+                                          const struct xrt_layer_data *data)
+{
+	assert(data->type == XRT_LAYER_PASSTHROUGH);
+
+	return xrt_comp_layer_passthrough(to_native_compositor(xc), xdev, data);
+}
+
+static xrt_result_t
+client_metal_compositor_layer_commit(struct xrt_compositor *xc, xrt_graphics_sync_handle_t sync_handle)
+{
+	COMP_TRACE_MARKER();
+
+	struct client_metal_compositor *c = client_metal_compositor(xc);
+
+	if (xrt_graphics_sync_handle_is_valid(sync_handle)) {
+		return xrt_comp_layer_commit(&c->xcn->base, sync_handle);
+	}
+
+	// Runs after all work the app committed to the queue before this call.
+	@autoreleasepool {
+		id<MTLCommandBuffer> cb = [c->queue commandBuffer];
+		if (c->sync.event != nil) {
+			uint64_t value = ++c->sync.value;
+			[cb encodeSignalEvent:c->sync.event value:value];
+			[cb commit];
+			return xrt_comp_layer_commit_with_semaphore(&c->xcn->base, c->sync.xcsem, value);
+		}
+
+		[cb commit];
+		[cb waitUntilCompleted];
+	}
+
+	return xrt_comp_layer_commit(&c->xcn->base, XRT_GRAPHICS_SYNC_HANDLE_INVALID);
+}
+
+static void
+client_metal_compositor_destroy(struct xrt_compositor *xc)
+{
+	struct client_metal_compositor *c = client_metal_compositor(xc);
+
+	wait_queue_idle(c);
+
+	[c->sync.event release];
+	xrt_compositor_semaphore_reference(&c->sync.xcsem, NULL);
+	[c->queue release];
+
+	free(c);
+}
+
+static void
+setup_semaphore(struct client_metal_compositor *c)
+{
+	xrt_graphics_sync_handle_t handle = XRT_GRAPHICS_SYNC_HANDLE_INVALID;
+	struct xrt_compositor_semaphore *xcsem = NULL;
+
+	id<MTLDevice> device = c->queue.device;
+	if (![device respondsToSelector:@selector(newSharedEventWithMachPort:)]) {
+		U_LOG_W("No newSharedEventWithMachPort:, using a CPU wait before each commit.");
+		return;
+	}
+
+	xrt_result_t xret = xrt_comp_create_semaphore(&c->xcn->base, &handle, &xcsem);
+	if (xret != XRT_SUCCESS) {
+		U_LOG_W("No shared timeline semaphore, using a CPU wait before each commit.");
+		return;
+	}
+
+	id<MTLSharedEvent> event = [(id<ClientMTLDeviceSPI>)device newSharedEventWithMachPort:handle];
+	u_graphics_sync_unref(&handle);
+	if (event == nil) {
+		U_LOG_W("newSharedEventWithMachPort: failed, using a CPU wait before each commit.");
+		xrt_compositor_semaphore_reference(&xcsem, NULL);
+		return;
+	}
+
+	c->sync.event = event;
+	c->sync.xcsem = xcsem; // No need to reference.
+	c->sync.value = event.signaledValue;
+}
+
+struct xrt_compositor_metal *
+xrt_gfx_metal_provider_create(struct xrt_compositor_native *xcn, void *command_queue)
+{
+	COMP_TRACE_MARKER();
+
+	struct client_metal_compositor *c = U_TYPED_CALLOC(struct client_metal_compositor);
+
+	c->base.base.get_swapchain_create_properties = client_metal_compositor_get_swapchain_create_properties;
+	c->base.base.create_swapchain = client_metal_swapchain_create;
+	c->base.base.create_passthrough = client_metal_compositor_passthrough_create;
+	c->base.base.create_passthrough_layer = client_metal_compositor_passthrough_layer_create;
+	c->base.base.destroy_passthrough = client_metal_compositor_passthrough_destroy;
+	c->base.base.begin_session = client_metal_compositor_begin_session;
+	c->base.base.end_session = client_metal_compositor_end_session;
+	c->base.base.wait_frame = client_metal_compositor_wait_frame;
+	c->base.base.begin_frame = client_metal_compositor_begin_frame;
+	c->base.base.discard_frame = client_metal_compositor_discard_frame;
+	c->base.base.layer_begin = client_metal_compositor_layer_begin;
+	c->base.base.layer_projection = client_metal_compositor_layer_projection;
+	c->base.base.layer_projection_depth = client_metal_compositor_layer_projection_depth;
+	c->base.base.layer_quad = client_metal_compositor_layer_quad;
+	c->base.base.layer_cube = client_metal_compositor_layer_cube;
+	c->base.base.layer_cylinder = client_metal_compositor_layer_cylinder;
+	c->base.base.layer_equirect1 = client_metal_compositor_layer_equirect1;
+	c->base.base.layer_equirect2 = client_metal_compositor_layer_equirect2;
+	c->base.base.layer_passthrough = client_metal_compositor_layer_passthrough;
+	c->base.base.layer_commit = client_metal_compositor_layer_commit;
+	c->base.base.destroy = client_metal_compositor_destroy;
+
+	c->xcn = xcn;
+	c->queue = [(id<MTLCommandQueue>)command_queue retain];
+
+	uint32_t count = 0;
+	for (uint32_t i = 0; i < xcn->base.info.format_count; i++) {
+		MTLPixelFormat f = vk_to_mtl_format(xcn->base.info.formats[i]);
+		if (f != MTLPixelFormatInvalid) {
+			c->base.base.info.formats[count++] = (int64_t)f;
+		}
+	}
+	c->base.base.info.format_count = count;
+	c->base.base.info.max_texture_size = 16384;
+
+	setup_semaphore(c);
+
+	return &c->base;
+}
