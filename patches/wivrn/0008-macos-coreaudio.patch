+std::vector<pid_t> wivrn_session::client_pids()
+{
+	assert(mnd_ipc_server);
+	std::vector<pid_t> pids;
+	scoped_lock lock(mnd_ipc_server->global_state.lock);
+	for (auto & t: mnd_ipc_server->threads)
+	{
+		if (t.state != IPC_THREAD_STARTING and t.state != IPC_THREAD_RUNNING)
+			continue;
+		pid_t pid = 0;
+#ifdef __APPLE__
+		socklen_t len = sizeof(pid);
+		if (getsockopt(t.ics.imc.ipc_handle, SOL_LOCAL, LOCAL_PEERPID, &pid, &len) != 0)
+			pid = 0;
+#endif
+		if (pid <= 0)
+			pid = t.ics.client_state.pid;
+		if (pid > 0)
+			pids.push_back(pid);
+	}
+	return pids;
+}
