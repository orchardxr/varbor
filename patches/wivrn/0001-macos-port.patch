-			mmsgs.push_back({.msg_hdr = {.msg_iovlen = data.size() + 1}});
+			mmsgs.push_back({.msg_hdr = {.msg_iovlen = decltype(msghdr::msg_iovlen)(data.size() + 1)}});
 		else
-			mmsgs.push_back({.msg_hdr = {.msg_iovlen = data.size()}});
+			mmsgs.push_back({.msg_hdr = {.msg_iovlen = decltype(msghdr::msg_iovlen)(data.size())}});
