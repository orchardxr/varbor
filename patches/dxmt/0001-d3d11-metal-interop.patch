diff --git a/src/d3d11/d3d11_context_imm.cpp b/src/d3d11/d3d11_context_imm.cpp
index 17c049cacc904e19a26dd0e6d5b6d5d4bdb9ba3d..0e9f18aadb380f73d36e430f99b0f2fd2d565efc 100644
--- a/src/d3d11/d3d11_context_imm.cpp
+++ b/src/d3d11/d3d11_context_imm.cpp
@@ -656,6 +656,31 @@ public:
     );
   }
 
+  void
+  InteropFlush(WMT::SharedEvent *pEvent, UINT64 *pValue) override {
+    std::lock_guard<d3d11_device_mutex> lock(mutex);
+    Flush();
+    *pEvent = cmd_queue.event;
+    *pValue = cmd_queue.GetCurrentEventSeqId();
+  }
+  void
+  InteropSignal(WMT::Event Event, UINT64 Value) override {
+    std::lock_guard<d3d11_device_mutex> lock(mutex);
+    InvalidateCurrentPass(true);
+    EmitOP([event = WMT::Reference<WMT::Event>(Event), Value](ArgumentEncodingContext &enc) mutable {
+      enc.signalEvent(std::move(event), Value);
+    });
+    Flush();
+  }
+  void
+  InteropWait(WMT::Event Event, UINT64 Value) override {
+    std::lock_guard<d3d11_device_mutex> lock(mutex);
+    InvalidateCurrentPass(true);
+    EmitOP([event = WMT::Reference<WMT::Event>(Event), Value](ArgumentEncodingContext &enc) mutable {
+      enc.waitEvent(std::move(event), Value);
+    });
+  }
+
 private:
   std::vector<Com<MTLD3D11OcclusionQuery>> pending_occlusion_queries;
   CommandQueue &cmd_queue;
diff --git a/src/d3d11/d3d11_device.cpp b/src/d3d11/d3d11_device.cpp
index a21b3c5a4d09f133dabe307019306725a11e169d..09b357003efa27e818c5b8551ffbc04df34bab8a 100644
--- a/src/d3d11/d3d11_device.cpp
+++ b/src/d3d11/d3d11_device.cpp
@@ -1121,6 +1121,57 @@ private:
   D3D11Multithread d3dmt_;
 };
 
+class MTLD3D11InteropDevice final : public IDXMTInteropDevice {
+public:
+  MTLD3D11InteropDevice(IUnknown *container, MTLD3D11Device *device) : container_(container), device_(device) {}
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) final {
+    return container_->QueryInterface(riid, ppvObject);
+  }
+
+  ULONG STDMETHODCALLTYPE AddRef() final { return container_->AddRef(); }
+
+  ULONG STDMETHODCALLTYPE Release() final { return container_->Release(); }
+
+  HRESULT STDMETHODCALLTYPE GetMetalDevice(UINT64 *pDevice) final {
+    if (!pDevice)
+      return E_POINTER;
+    *pDevice = device_->GetMTLDevice().handle;
+    return S_OK;
+  }
+
+  void STDMETHODCALLTYPE LockSubmissionQueue() final { device_->mutex.lock(); }
+
+  void STDMETHODCALLTYPE ReleaseSubmissionQueue() final { device_->mutex.unlock(); }
+
+  HRESULT STDMETHODCALLTYPE FlushRenderingCommands(UINT64 *pEvent, UINT64 *pValue) final {
+    if (!pEvent || !pValue)
+      return E_POINTER;
+    WMT::SharedEvent event;
+    device_->GetImmediateContextPrivate()->InteropFlush(&event, pValue);
+    *pEvent = event.handle;
+    return S_OK;
+  }
+
+  HRESULT STDMETHODCALLTYPE SignalEvent(UINT64 Event, UINT64 Value) final {
+    if (!Event)
+      return E_INVALIDARG;
+    device_->GetImmediateContextPrivate()->InteropSignal(WMT::Event{Event}, Value);
+    return S_OK;
+  }
+
+  HRESULT STDMETHODCALLTYPE WaitEvent(UINT64 Event, UINT64 Value) final {
+    if (!Event)
+      return E_INVALIDARG;
+    device_->GetImmediateContextPrivate()->InteropWait(WMT::Event{Event}, Value);
+    return S_OK;
+  }
+
+private:
+  IUnknown *container_;
+  MTLD3D11Device *device_;
+};
+
