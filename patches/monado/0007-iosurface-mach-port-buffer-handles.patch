-	CHAIN(export_alloc_info);
+	if (memory_handle_type != 0) {
+		CHAIN(export_alloc_info);
+	}
 
 	ret = vk_alloc_and_bind_image_memory(   //
 	    vk,                                 // vk_bundle
@@ -531,8 +546,13 @@ vk_ic_get_handles(struct vk_bundle *vk,
 
 	size_t i = 0;
 	for (; i < vkic->image_count && i < max_handles; i++) {
+#if defined(XRT_GRAPHICS_BUFFER_HANDLE_IS_MACH_PORT)
+		ret = vk_get_native_handle_from_image(vk, vkic->images[i].handle, &out_handles[i]);
